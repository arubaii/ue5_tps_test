+				[&Stroke, Length](float Distance) { return Stroke.Width * FMath::Max(FMath::Lerp(Stroke.StartWidthScale, Stroke.EndWidthScale, FMath::Clamp(Distance / Length, 0.f, 1.f)), 0.f); },
