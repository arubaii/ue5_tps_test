@@ -0,0 +1,198 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetAnimShapeTrack.h"
+
+#define LOCTEXT_NAMESPACE "WidgetAnimShapeTrack"
+
+namespace WidgetAnimShapeTrackPrivate
+{
+	const FWidgetAnimShapeParams* Get(const FInstancedStruct& Params)
+	{
+		return Params.GetPtr<FWidgetAnimShapeParams>();
+	}
+
+	/** "Shape.TrimEnd": each value its own channel, so a Trim End and a Fill Color on one shape don't take turns. */
+	FName ChannelFor(EWidgetShapeValue Value)
+	{
+		static TMap<uint8, FName> Names;
+		const uint8 Key = static_cast<uint8>(Value);
+		if (const FName* Found = Names.Find(Key))
+		{
+			return *Found;
+		}
+		const FString ValueName = StaticEnum<EWidgetShapeValue>()->GetNameStringByValue(static_cast<int64>(Value));
+		return Names.Add(Key, FName(*(TEXT("Shape.") + ValueName)));
+	}
+}
+
+FText FWidgetAnimShapeEvaluator::GetDisplayName() const
+{
+	return LOCTEXT("DisplayName", "Shape");
+}
+
+FText FWidgetAnimShapeEvaluator::GetDescription() const
+{
+	return LOCTEXT("Description", "Animates one value of a shape widget - its Trim Path drawing the stroke on, a progress ring's Sweep, a Star's points or rounding, the stroke's width or dashes, the fill or stroke color. On a widget that isn't a shape, the first shape inside it.");
+}
+
+FText FWidgetAnimShapeEvaluator::GetValueLabel() const
+{
+	return LOCTEXT("ValueLabel", "Value");
+}
+
+FText FWidgetAnimShapeEvaluator::GetTrackDisplayName(const FInstancedStruct& Params) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	if (const FWidgetAnimShapeParams* Shape = Get(Params))
+	{
+		return FText::Format(LOCTEXT("TrackDisplayName", "Shape: {0}"), StaticEnum<EWidgetShapeValue>()->GetDisplayNameTextByValue(static_cast<int64>(Shape->Value)));
+	}
+	return GetDisplayName();
+}
+
+FText FWidgetAnimShapeEvaluator::GetCategory() const
+{
+	return LOCTEXT("Category", "Shapes");
+}
+
+UClass* FWidgetAnimShapeEvaluator::GetTargetClass() const
+{
+	return UShapeWidget::StaticClass();
+}
+
+FName FWidgetAnimShapeEvaluator::GetChannel(const FInstancedStruct& Params) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	return Shape ? ChannelFor(Shape->Value) : FName(TEXT("Shape"));
+}
+
+double FWidgetAnimShapeEvaluator::GetQuantizeStep(const FInstancedStruct& Params) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	// A Star's points and an N-gon's sides change in whole steps: nothing to redraw between them.
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	return Shape && WidgetShapeValueIsWhole(Shape->Value) ? 1.0 : 0.0;
+}
+
+double FWidgetAnimShapeEvaluator::GetEndpointValue(const FInstancedStruct& Params, bool bStart) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	if (!Shape)
+	{
+		return bStart ? 0.0 : 1.0;
+	}
+	if (WidgetShapeValueIsColor(Shape->Value))
+	{
+		// A color track's value only says how far along it is; the color is what moves.
+		return bStart ? 0.0 : 1.0;
+	}
+	return bStart ? Shape->StartValue : Shape->EndValue;
+}
+
+void FWidgetAnimShapeEvaluator::Apply(UObject* Target, const FInstancedStruct& Params, double Value) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	UShapeWidget* ShapeWidget = Cast<UShapeWidget>(Target);
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	if (!ShapeWidget || !Shape || WidgetShapeValueIsColor(Shape->Value))
+	{
+		return;
+	}
+	ShapeWidget->SetShapeValue(Shape->Value, static_cast<float>(Value));
+}
+
+EWidgetAnimKeyContent FWidgetAnimShapeEvaluator::GetKeyContent(const FInstancedStruct& Params) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	return Shape && WidgetShapeValueIsColor(Shape->Value) ? EWidgetAnimKeyContent::Color : EWidgetAnimKeyContent::Value;
+}
+
+FText FWidgetAnimShapeEvaluator::GetKeyColorLabel(const FInstancedStruct& Params) const
+{
+	return LOCTEXT("KeyColorLabel", "Color");
+}
+
+FLinearColor FWidgetAnimShapeEvaluator::GetEndpointColor(const FInstancedStruct& Params, bool bStart) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	if (!Shape)
+	{
+		return FLinearColor::White;
+	}
+	return bStart ? Shape->StartColor : Shape->EndColor;
+}
+
+void FWidgetAnimShapeEvaluator::ApplyWithColor(UObject* Target, const FInstancedStruct& Params, double Value, const FLinearColor& Color) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	UShapeWidget* ShapeWidget = Cast<UShapeWidget>(Target);
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	if (!ShapeWidget || !Shape)
+	{
+		return;
+	}
+	if (WidgetShapeValueIsColor(Shape->Value))
+	{
+		ShapeWidget->SetShapeColor(Shape->Value, Color);
+	}
+	else
+	{
+		Apply(Target, Params, Value);
+	}
+}
+
+bool FWidgetAnimShapeEvaluator::CaptureBaseline(UObject* Target, const FInstancedStruct& Params, FInstancedStruct& OutBaseline) const
+{
+	using namespace WidgetAnimShapeTrackPrivate;
+
+	const UShapeWidget* ShapeWidget = Cast<UShapeWidget>(Target);
+	const FWidgetAnimShapeParams* Shape = Get(Params);
+	if (!ShapeWidget || !Shape)
+	{
+		return false;
+	}
+
+	FWidgetAnimShapeBaseline Baseline;
+	Baseline.Which = Shape->Value;
+	const bool bCaptured = WidgetShapeValueIsColor(Shape->Value)
+		? ShapeWidget->GetShapeColor(Shape->Value, Baseline.Color)
+		: ShapeWidget->GetShapeValue(Shape->Value, Baseline.Value);
+	if (!bCaptured)
+	{
+		return false;
+	}
+	OutBaseline.InitializeAs<FWidgetAnimShapeBaseline>(Baseline);
+	return true;
+}
+
+void FWidgetAnimShapeEvaluator::RestoreBaseline(UObject* Target, const FInstancedStruct& Baseline) const
+{
+	UShapeWidget* ShapeWidget = Cast<UShapeWidget>(Target);
+	const FWidgetAnimShapeBaseline* Captured = Baseline.GetPtr<FWidgetAnimShapeBaseline>();
+	if (!ShapeWidget || !Captured)
+	{
+		return;
+	}
+	if (WidgetShapeValueIsColor(Captured->Which))
+	{
+		ShapeWidget->SetShapeColor(Captured->Which, Captured->Color);
+	}
+	else
+	{
+		ShapeWidget->SetShapeValue(Captured->Which, Captured->Value);
+	}
+}
+
+#undef LOCTEXT_NAMESPACE
diff --git a/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimShapeTrack.h b/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimShapeTrack.h
