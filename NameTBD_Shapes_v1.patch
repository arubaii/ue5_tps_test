@@ -0,0 +1,79 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "NameTBD/WidgetAnimation/WidgetAnimEvaluator.h"
+#include "NameTBD/Widgets/Shapes/ShapeWidget.h"
+
+#include "WidgetAnimShapeTrack.generated.h"
+
+/**
+ * Shape: animates one value of a shape widget (Ellipse, Triangle, Star, N-gon, Custom Shape) - its Trim Path drawing a stroke
+ * on, a progress ring's Sweep filling, a Star's points or rounding, a stroke's width, dashes marching, the fill or stroke
+ * color. Timed, keyed, eased, sprung and value-driven like every track.
+ *
+ * Played on a widget that isn't a shape, it animates the first shape inside it.
+ */
+USTRUCT(BlueprintType, meta = (DisplayName = "Shape"))
+struct NAMETBD_API FWidgetAnimShapeParams : public FWidgetAnimTypeParams
+{
+	GENERATED_BODY()
+
+	/** Which of the shape's values the track moves. A shape without it (Sides on a Star) is left alone. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shape", meta = (DisplayName = "Value"))
+	EWidgetShapeValue Value = EWidgetShapeValue::TrimEnd;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shape", meta = (DisplayName = "Start Value", EditCondition = "Value != EWidgetShapeValue::FillColor && Value != EWidgetShapeValue::StrokeColor", EditConditionHides))
+	double StartValue = 0.0;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shape", meta = (DisplayName = "End Value", EditCondition = "Value != EWidgetShapeValue::FillColor && Value != EWidgetShapeValue::StrokeColor", EditConditionHides))
+	double EndValue = 1.0;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shape", meta = (DisplayName = "Start Color", EditCondition = "Value == EWidgetShapeValue::FillColor || Value == EWidgetShapeValue::StrokeColor", EditConditionHides))
+	FLinearColor StartColor = FLinearColor::White;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shape", meta = (DisplayName = "End Color", EditCondition = "Value == EWidgetShapeValue::FillColor || Value == EWidgetShapeValue::StrokeColor", EditConditionHides))
+	FLinearColor EndColor = FLinearColor::White;
+};
+
+/** What a Shape track's target held before it was animated. */
+USTRUCT()
+struct NAMETBD_API FWidgetAnimShapeBaseline
+{
+	GENERATED_BODY()
+
+	/** Which value was captured - each has a channel of its own, so one baseline per value. */
+	UPROPERTY()
+	EWidgetShapeValue Which = EWidgetShapeValue::TrimEnd;
+
+	UPROPERTY()
+	float Value = 0.f;
+
+	UPROPERTY()
+	FLinearColor Color = FLinearColor::White;
+};
+
+class NAMETBD_API FWidgetAnimShapeEvaluator : public TWidgetAnimEvaluator<FWidgetAnimShapeParams>
+{
+public:
+	virtual FText GetDisplayName() const override;
+	virtual FText GetDescription() const override;
+	virtual FText GetValueLabel() const override;
+	virtual FText GetTrackDisplayName(const FInstancedStruct& Params) const override;
+	virtual FText GetCategory() const override;
+	virtual UClass* GetTargetClass() const override;
+	virtual FName GetChannel(const FInstancedStruct& Params) const override;
+
+	virtual double GetQuantizeStep(const FInstancedStruct& Params) const override;
+	virtual double GetEndpointValue(const FInstancedStruct& Params, bool bStart) const override;
+	virtual void Apply(UObject* Target, const FInstancedStruct& Params, double Value) const override;
+
+	virtual EWidgetAnimKeyContent GetKeyContent(const FInstancedStruct& Params) const override;
+	virtual FText GetKeyColorLabel(const FInstancedStruct& Params) const override;
+	virtual FLinearColor GetEndpointColor(const FInstancedStruct& Params, bool bStart) const override;
+	virtual void ApplyWithColor(UObject* Target, const FInstancedStruct& Params, double Value, const FLinearColor& Color) const override;
+
+	virtual bool CaptureBaseline(UObject* Target, const FInstancedStruct& Params, FInstancedStruct& OutBaseline) const override;
+	virtual void RestoreBaseline(UObject* Target, const FInstancedStruct& Baseline) const override;
+};
