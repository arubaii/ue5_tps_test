diff --git a/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimShapeTrack.cpp b/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimShapeTrack.cpp
