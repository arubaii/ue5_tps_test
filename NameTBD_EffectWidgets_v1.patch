+/** How a Glass Panel lights up while its button (or it) is hovered or pressed. Added on top of the Glass at full hover. */
+USTRUCT(BlueprintType)
+struct NAMETBD_API FGlassHoverResponse
+{
+	GENERATED_BODY()
