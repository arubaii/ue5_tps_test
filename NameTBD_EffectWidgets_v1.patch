-					}
-					for (int32 Index = TypedCharacters; Index < TypedCharacters + Step; ++Index)
-					{
-						if (TypeSound && !FChar::IsWhitespace(Current.Line[Index]) && ++CharactersSinceSound >= FMath::Max(SoundInterval, 1))
-						{
-							CharactersSinceSound = 0;
