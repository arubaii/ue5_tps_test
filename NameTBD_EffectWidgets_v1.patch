+
+	/** Sets the value, 0 to 1 - animated by Motion (with the trail). */
+	UFUNCTION(BlueprintCallable, Category = "Advanced Progress Bar")
+	void SetPercent(float InPercent);
+
+	/** Sets the value at once: no animation, no trail. */
+	UFUNCTION(BlueprintCallable, Category = "Advanced Progress Bar")
