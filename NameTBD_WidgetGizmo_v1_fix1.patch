+bool SWidgetAnimTimeline::CanGizmoKey() const
+{
+	IWidgetAnimPanelSource::FPosedAnimation Posed;
+	return Source.IsValid() && HasAnimation() && CanEdit() && !IsDragging() && Source->GetLayers()
+		&& Source->GetPosedAnimation(Posed) && Posed.bPosed;
+}
