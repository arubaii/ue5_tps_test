+	void FGizmoLayer::OnGizmoKey(EGizmoKey Which, const FVector2D& Screen)
+	{
+		if (Pressing.bPressed)
+		{
+			return;
+		}
+		if (Which == EGizmoKey::Hide)
+		{
+			EndSession(/*bCancel=*/false);
