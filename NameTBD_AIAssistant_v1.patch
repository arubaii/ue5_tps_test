+	bool IsDark(const FString& Mode)
+	{
+		const FString Key = Mode.ToLower();
+		if (Key.Contains(TEXT("light")) || Key.Contains(TEXT("day")))
+		{
+			return false;
+		}
+		if (Key.Contains(TEXT("dark")) || Key.Contains(TEXT("night")))
+		{
+			return true;
+		}
+		return UNameTBDAITheme::Get().bDarkByDefault;
+	}
