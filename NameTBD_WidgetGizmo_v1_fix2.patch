+					Best = Distance;
+					Out.bFound = true;
+					Out.Scale = (Line.Value - Pivot) / PerScale;
+					Out.Distance = Distance;
+					Out.Line = &Line;
+				}
+			}
+			return Out;
+		};
+
+		const FAxisSnap OnX = SnapAxis(0);
+		const FAxisSnap OnY = SnapAxis(1);
+		bool bUsedX = false;
+		bool bUsedY = false;
