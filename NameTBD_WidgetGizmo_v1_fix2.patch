+		// its scale, on its own axis - and the scale that puts it on a guide is one division.
+		if (!IsUpright(Start) || !FMath::IsNearlyZero(Start.Pose.Angle, 1.e-3f) || !Start.Pose.Shear.IsNearlyZero(1.e-3))
