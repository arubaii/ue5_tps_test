+void SWidgetAnimTimeline::AddPresetEntries(FMenuBuilder& Menu, const TArray<int32>& LayerIndices)
+{
+	const TArray<FWidgetAnimLayer>* Layers = GetLayers();
+	TArray<int32> Targets;
+	for (const int32 LayerIndex : LayerIndices)
+	{
+		// Not a track that plays another animation: its settings are that animation's.
+		if (Layers && Layers->IsValidIndex(LayerIndex) && !(*Layers)[LayerIndex].IsAnimationTrack())
+		{
+			Targets.Add(LayerIndex);
+		}
+	}
+	bool bAnyEditable = false;
+	for (const int32 LayerIndex : Targets)
+	{
+		bAnyEditable |= CanEditLayer(LayerIndex);
+	}
+
+	TArray<WidgetAnimTrackPresets::FPreset> Presets;
+	WidgetAnimTrackPresets::GetPresets(Presets);
+
+	Menu.BeginSection("Presets", LOCTEXT("PresetsSection", "Presets"));
+	if (Presets.Num() == 0)
+	{
+		Menu.AddWidget(
+			SNew(SBox)
+			.Padding(FMargin(8.f, 2.f, 8.f, 4.f))
+			.MaxDesiredWidth(300.f)
+			[
+				SNew(STextBlock)
+				.AutoWrapText(true)
+				.Font(FCoreStyle::GetDefaultFontStyle("Italic", 9))
+				.ColorAndOpacity(FSlateColor::UseSubduedForeground())
+				.Text(WidgetAnimTips::NoTrackPresetsNote())
+			],
+			FText::GetEmpty(), /*bNoIndent=*/true);
+	}
+	for (const WidgetAnimTrackPresets::FPreset& Preset : Presets)
+	{
+		const FWidgetAnimLayer PresetLayer = Preset.Layer;
+		const FString PresetName = Preset.Name;
+		Menu.AddMenuEntry(
+			FUIAction(
+				FExecuteAction::CreateLambda([this, Targets, PresetLayer, PresetName]() { ApplyLayerPreset(Targets, PresetLayer, PresetName); }),
+				FCanExecuteAction::CreateLambda([bAnyEditable]() { return bAnyEditable; })),
+			SNew(SHorizontalBox)
+			+ SHorizontalBox::Slot()
+			.AutoWidth()
+			.VAlign(VAlign_Center)
+			.Padding(FMargin(0.f, 0.f, 6.f, 0.f))
+			[
+				SNew(SBox)
+				.WidthOverride(3.f)
+				.HeightOverride(12.f)
+				[
+					SNew(SImage)
+					.Image(WidgetAnimTimeline::WhiteBrush())
+					.ColorAndOpacity(GetLayerTypeColor(PresetLayer))
+				]
+			]
+			+ SHorizontalBox::Slot()
+			.FillWidth(1.f)
+			.VAlign(VAlign_Center)
+			.Padding(FMargin(0.f, 0.f, 16.f, 0.f))
+			[
+				SNew(STextBlock)
+				.Text(FText::FromString(PresetName))
+			]
+			+ SHorizontalBox::Slot()
+			.AutoWidth()
+			.VAlign(VAlign_Center)
+			[
+				SNew(STextBlock)
+				.Font(FCoreStyle::GetDefaultFontStyle("Italic", 9))
+				.ColorAndOpacity(FSlateColor::UseSubduedForeground())
+				.Text(GetLayerTypeName(PresetLayer))
+			],
+			NAME_None,
+			FText::Format(WidgetAnimTips::ApplyTrackPresetTooltip(), FText::FromString(PresetName)));
+	}
+	Menu.EndSection();
+
+	Menu.BeginSection("PresetFiles", LOCTEXT("PresetFilesSection", "Your Presets"));
+
+	// One track's settings saved under a name - typed, and taken on Enter.
+	if (Targets.Num() == 1 && LayerIndices.Num() == 1)
+	{
+		const int32 SaveFrom = Targets[0];
+		Menu.AddWidget(
+			SNew(SBox)
+			.WidthOverride(200.f)
+			.Padding(FMargin(0.f, 2.f, 8.f, 2.f))
+			[
+				SNew(SEditableTextBox)
+				.HintText(WidgetAnimTips::NewTrackPresetHint())
+				.ToolTipText(WidgetAnimTips::SaveTrackPresetTooltip())
+				.OnTextCommitted_Lambda([this, SaveFrom](const FText& NewText, ETextCommit::Type CommitType)
+				{
+					const FString Name = NewText.ToString().TrimStartAndEnd();
+					if (CommitType == ETextCommit::OnEnter && !Name.IsEmpty())
+					{
+						FSlateApplication::Get().DismissAllMenus();
+						SaveLayerAsPreset(SaveFrom, Name);
+					}
+				})
+			],
+			LOCTEXT("SaveTrackPresetLabel", "Save as Preset"));
+	}
+
+	if (Presets.Num() > 0)
+	{
+		Menu.AddSubMenu(
+			LOCTEXT("DeleteTrackPreset", "Delete Preset"),
+			WidgetAnimTips::DeleteTrackPresetTooltip(),
+			FNewMenuDelegate::CreateLambda([Presets](FMenuBuilder& SubMenu)
+			{
+				for (const WidgetAnimTrackPresets::FPreset& Preset : Presets)
+				{
+					SubMenu.AddMenuEntry(
+						FText::FromString(Preset.Name),
+						FText::GetEmpty(),
+						FSlateIcon(FNameTBDStyle::GetStyleSetName(), FNameTBDStyle::MenuDeleteIcon),
