new file mode 100644
index 0000000..1310355
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTrackPresets.cpp
@@ -0,0 +1,173 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetAnimTrackPresets.h"
+
+#include "HAL/FileManager.h"
+#include "Misc/FileHelper.h"
+#include "Misc/Paths.h"
+
+DEFINE_LOG_CATEGORY_STATIC(LogWidgetAnimTrackPresets, Log, All);
+
+#define LOCTEXT_NAMESPACE "WidgetAnimTrackPresets"
+
+namespace WidgetAnimTrackPresets
+{
+	namespace
+	{
+		const TCHAR* Header = TEXT("NameTBD.WidgetAnimTrackPreset.v1");
+		const TCHAR* Extension = TEXT(".watrack");
+
+		/** Layer with everything that says where it is, and how the panel shows it, put back to a new track's. */
+		FWidgetAnimLayer WithoutPlacement(const FWidgetAnimLayer& Layer)
+		{
+			FWidgetAnimLayer Out = Layer;
+			const FWidgetAnimLayer Fresh;
+			Out.Start = Fresh.Start;
+			Out.Delay = Fresh.Delay;
+			Out.LayerGroup = Fresh.LayerGroup;
+			Out.TargetWidget = Fresh.TargetWidget;
+			Out.InsertedAnimation = nullptr;
+			Out.InsertedGroups.Reset();
+#if WITH_EDITORONLY_DATA
+			Out.bLockedInEditor = Fresh.bLockedInEditor;
+			Out.EditorLine = Fresh.EditorLine;
+			Out.bHiddenInEditor = Fresh.bHiddenInEditor;
+			Out.bHiddenByFocus = Fresh.bHiddenByFocus;
+			Out.InsertedFrom = Fresh.InsertedFrom;
+			Out.bPinnedInEditor = Fresh.bPinnedInEditor;
+			Out.CollapsedTrack = Fresh.CollapsedTrack;
+			Out.TrackName = Fresh.TrackName;
+			Out.bMutedByEditorScope = Fresh.bMutedByEditorScope;
+#endif
+			return Out;
+		}
+
+		bool Read(const FString& File, FWidgetAnimLayer& OutLayer)
+		{
+			FString Text;
+			if (!FFileHelper::LoadFileToString(Text, *File))
+			{
+				return false;
+			}
+
+			// The header line, then the track as exported text - one line, but read whole in case an editor wrapped it.
+			int32 LineEnd = INDEX_NONE;
+			if (!Text.FindChar(TEXT('\n'), LineEnd) || Text.Left(LineEnd).TrimStartAndEnd() != Header)
+			{
+				return false;
+			}
+			const FString Exported = Text.Mid(LineEnd + 1).TrimStartAndEnd();
+			return !Exported.IsEmpty()
+				&& FWidgetAnimLayer::StaticStruct()->ImportText(*Exported, &OutLayer, nullptr, PPF_Copy, GWarn, TEXT("WidgetAnimTrackPreset")) != nullptr;
+		}
+	}
+
+	FString GetFolder(bool bCreate)
+	{
+		const FString Folder = FPaths::ConvertRelativePathToFull(FPaths::ProjectContentDir() / TEXT("WidgetAnimTrackPresets"));
+		if (bCreate && !IFileManager::Get().DirectoryExists(*Folder))
+		{
+			IFileManager::Get().MakeDirectory(*Folder, /*Tree=*/true);
+		}
+		return Folder;
+	}
+
+	FString GetPresetFile(const FString& Name)
+	{
+		const FString FileName = FPaths::MakeValidFileName(Name.TrimStartAndEnd(), TEXT('_'));
+		return FileName.IsEmpty() ? FString() : GetFolder() / (FileName + Extension);
+	}
+
+	void GetPresets(TArray<FPreset>& OutPresets)
+	{
+		OutPresets.Reset();
+
+		TArray<FString> Files;
+		IFileManager::Get().FindFiles(Files, *(GetFolder() / (FString(TEXT("*")) + Extension)), /*Files=*/true, /*Directories=*/false);
+		for (const FString& FileName : Files)
+		{
+			FPreset Preset;
+			Preset.File = GetFolder() / FileName;
+			Preset.Name = FPaths::GetBaseFilename(FileName);
+			if (Read(Preset.File, Preset.Layer))
+			{
+				OutPresets.Add(MoveTemp(Preset));
+			}
+			else
+			{
+				UE_LOG(LogWidgetAnimTrackPresets, Warning, TEXT("Track preset %s couldn't be read, so it isn't listed."), *Preset.File);
+			}
+		}
+
+		OutPresets.Sort([](const FPreset& A, const FPreset& B) { return A.Name < B.Name; });
+	}
+
+	bool CanSave(const FWidgetAnimLayer& Layer)
+	{
+		return !Layer.IsAnimationTrack();
+	}
+
+	bool Save(const FString& Name, const FWidgetAnimLayer& Layer, FText& OutError)
+	{
+		if (!CanSave(Layer))
+		{
+			OutError = LOCTEXT("AnimationTrackPreset", "A track that plays another animation can't be a preset: its settings are that animation's.");
+			return false;
+		}
+
+		const FString File = GetPresetFile(Name);
+		if (File.IsEmpty())
+		{
+			OutError = LOCTEXT("PresetNameEmpty", "Give the preset a name.");
+			return false;
+		}
+		GetFolder(/*bCreate=*/true);
+
+		const FWidgetAnimLayer Clean = WithoutPlacement(Layer);
+		FString Exported;
+		FWidgetAnimLayer::StaticStruct()->ExportText(Exported, &Clean, nullptr, nullptr, PPF_Copy, nullptr);
+		if (!FFileHelper::SaveStringToFile(FString(Header) + TEXT("\n") + Exported + TEXT("\n"), *File, FFileHelper::EEncodingOptions::ForceUTF8WithoutBOM))
+		{
+			OutError = FText::Format(LOCTEXT("PresetWriteFailed", "Couldn't write {0}. Is it read-only, or checked in?"), FText::FromString(File));
+			return false;
+		}
+		return true;
+	}
+
+	bool Delete(const FPreset& Preset)
+	{
+		return IFileManager::Get().Delete(*Preset.File, /*RequireExists=*/false, /*EvenReadOnly=*/true);
+	}
+
+	void ApplyTo(const FWidgetAnimLayer& Preset, FWidgetAnimLayer& Target)
+	{
+		FWidgetAnimLayer Out = WithoutPlacement(Preset);
+
+		// Where the track is, and how the panel shows it, stay the track's.
+		Out.Start = Target.Start;
+		Out.Delay = Target.Delay;
+		Out.LayerGroup = Target.LayerGroup;
+		Out.TargetWidget = Target.TargetWidget;
+#if WITH_EDITORONLY_DATA
+		Out.bLockedInEditor = Target.bLockedInEditor;
+		Out.EditorLine = Target.EditorLine;
+		Out.bHiddenInEditor = Target.bHiddenInEditor;
+		Out.bHiddenByFocus = Target.bHiddenByFocus;
+		Out.InsertedFrom = Target.InsertedFrom;
+		Out.bPinnedInEditor = Target.bPinnedInEditor;
+		Out.CollapsedTrack = Target.CollapsedTrack;
+		Out.TrackName = Target.TrackName;
+		Out.bMutedByEditorScope = Target.bMutedByEditorScope;
+#endif
+
+		// A value-driven track keeps the Value Name gameplay already sets it by.
+		if (!Target.ValueName.IsNone())
+		{
+			Out.ValueName = Target.ValueName;
+		}
+
+		Target = MoveTemp(Out);
+	}
+}
+
+#undef LOCTEXT_NAMESPACE
diff --git a/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTrackPresets.h b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTrackPresets.h
new file mode 100644
index 0000000..337bb4a
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTrackPresets.h
@@ -0,0 +1,53 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "NameTBD/WidgetAnimation/WidgetAnimLibrary.h"
+
+/**
+ * Track presets: a track's settings - its type, values, timing, easing, keys, Stagger, everything that says what it does -
+ * saved under a name, to put on any other track from the Selection panel's Preset dropdown or the track's menu.
+ *
+ * One file per preset in <Project>/Content/WidgetAnimTrackPresets (NameTBD.WidgetAnimTrackPreset.v1, then the track as
+ * exported text), so a team shares them through source control the way it shares the project's snippets. Read afresh
+ * whenever they are listed, so a preset added on disk shows up without a restart.
+ *
+ * A preset never carries where a track is - its Starts, Delay, group, Target Widget, line, name or collapsed track - nor
+ * its lock, hidden or pinned state: applying one changes what the track does, never where it sits.
+ */
+namespace WidgetAnimTrackPresets
+{
+	struct FPreset
+	{
+		/** As shown: the file's name, without its extension. */
+		FString Name;
+
+		/** The full path of its file. */
+		FString File;
+
+		FWidgetAnimLayer Layer;
+	};
+
+	/** <Project>/Content/WidgetAnimTrackPresets, full path. Made when bCreate and it doesn't exist yet. */
+	FString GetFolder(bool bCreate = false);
+
+	/** Every preset that reads, by name. A file that doesn't read is left out (and logged). */
+	void GetPresets(TArray<FPreset>& OutPresets);
+
+	/** The file a preset of Name is saved in - whether or not there is one yet. Empty for a name that makes no file name. */
+	FString GetPresetFile(const FString& Name);
+
+	/** Whether Layer can be a preset: not a track that plays another animation, whose settings are that animation's. */
+	bool CanSave(const FWidgetAnimLayer& Layer);
+
+	/** Saves Layer's settings as the preset Name, replacing one of that name. False, with OutError, when it can't. */
+	bool Save(const FString& Name, const FWidgetAnimLayer& Layer, FText& OutError);
+
+	/** Deletes a preset's file. */
+	bool Delete(const FPreset& Preset);
+
+	/** Puts Preset's settings on Target, keeping everything that says where Target is and how the panel shows it. */
+	void ApplyTo(const FWidgetAnimLayer& Preset, FWidgetAnimLayer& Target);
+}
