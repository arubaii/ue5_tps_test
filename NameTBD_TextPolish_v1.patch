+		}
+		// FName comparison ignores case, so <Shake> finds shake.
+		return UWidgetAnimRuntimeSettings::Get().TextTags.FindByPredicate([Name](const FWidgetAnimTextTag& Tag) { return Tag.Tag == Name; });
