+class SMediaBoxControlsFrame : public SPanel
+{
+public:
+	SLATE_BEGIN_ARGS(SMediaBoxControlsFrame)
+		: _Alignment(VAlign_Bottom)
+		, _Height(0.13f)
+		, _MinHeight(0.f)
