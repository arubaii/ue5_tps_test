+void SWidgetAnimStateMachineEditor::RenameInputInPanel(FName Input)
+{
+	if (const TSharedPtr<SInlineEditableTextBlock>* Text = InputNameTexts.Find(Input))
+	{
+		if (Text->IsValid())
+		{
+			(*Text)->EnterEditingMode();
+		}
+	}
