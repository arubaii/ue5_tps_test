+		FWidgetAnimParameterScopeStack ParameterScopes;
+		PushParameterScopes(ParameterScopes);
+		for (FWidgetAnimMachineInstance& Instance : MachineInstances)
+		{
+			WidgetAnimStateMachines::Start(Instance, Context);
+		}
