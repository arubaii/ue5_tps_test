diff --git a/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.cpp b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.cpp
new file mode 100644
index 0000000..54d1cd3
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.cpp
@@ -0,0 +1,99 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetAnimTypePill.h"
+
+#include "EdGraphSchema_K2.h"
+#include "Styling/AppStyle.h"
+#include "Widgets/Images/SImage.h"
+#include "Widgets/Layout/SBox.h"
+#include "Widgets/SBoxPanel.h"
+#include "Widgets/Text/STextBlock.h"
+
+#include "NameTBDColors.h"
+
+#define LOCTEXT_NAMESPACE "WidgetAnimTypePill"
+
+namespace WidgetAnimTypePill
+{
+	FLinearColor GetColor(EKind Kind)
+	{
+		// Trigger and Press And Hold aren't Blueprint types: their own colors.
+		if (Kind == EKind::Trigger)
+		{
+			return NameTBD::Colors::StateMachineEditor::InputTrigger;
+		}
+		if (Kind == EKind::Hold)
+		{
+			return NameTBD::Colors::StateMachineEditor::InputHold;
+		}
+
+		// The rest as a Blueprint variable of the type is drawn: a Float is a Real (double) in Unreal 5, a Choice an enum.
+		FEdGraphPinType PinType;
+		switch (Kind)
+		{
+		case EKind::Bool:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Boolean;
+			break;
+		case EKind::Float:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Real;
+			PinType.PinSubCategory = UEdGraphSchema_K2::PC_Double;
+			break;
+		case EKind::Integer:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Int;
+			break;
+		case EKind::Choice:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Byte;
+			break;
+		case EKind::Vector2D:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Struct;
+			PinType.PinSubCategoryObject = TBaseStructure<FVector2D>::Get();
+			break;
+		default:
+			PinType.PinCategory = UEdGraphSchema_K2::PC_Struct;
+			PinType.PinSubCategoryObject = TBaseStructure<FLinearColor>::Get();
+			break;
+		}
+		const UEdGraphSchema_K2* Schema = GetDefault<UEdGraphSchema_K2>();
+		return Schema ? Schema->GetPinTypeColor(PinType) : FLinearColor::White;
+	}
+
+	FText GetLabel(EKind Kind)
+	{
+		switch (Kind)
+		{
+		case EKind::Bool:     return LOCTEXT("Bool", "Bool");
+		case EKind::Float:    return LOCTEXT("Float", "Float");
+		case EKind::Integer:  return LOCTEXT("Integer", "Integer");
+		case EKind::Choice:   return LOCTEXT("Choice", "Choice");
+		case EKind::Vector2D: return LOCTEXT("Vector2D", "Vector 2D");
+		case EKind::Color:    return LOCTEXT("Color", "Color");
+		case EKind::Trigger:  return LOCTEXT("Trigger", "Trigger");
+		default:              return LOCTEXT("Hold", "Hold");
+		}
+	}
+
+	TSharedRef<SWidget> MakePill(EKind Kind)
+	{
+		// The My Blueprint panel's variable type icon: a pill in the pin color, then the type's name in the normal text color.
+		return SNew(SHorizontalBox)
+			+ SHorizontalBox::Slot()
+			.AutoWidth()
+			.VAlign(VAlign_Center)
+			.Padding(FMargin(0.f, 0.f, 4.f, 0.f))
+			[
+				SNew(SImage)
+				.Image(FAppStyle::GetBrush(TEXT("Kismet.VariableList.TypeIcon")))
+				.ColorAndOpacity(GetColor(Kind))
+			]
+			+ SHorizontalBox::Slot()
+			.FillWidth(1.f)
+			.VAlign(VAlign_Center)
+			[
+				SNew(STextBlock)
+				.Text(GetLabel(Kind))
+				.OverflowPolicy(ETextOverflowPolicy::Ellipsis)
+			];
+	}
+}
+
+#undef LOCTEXT_NAMESPACE
diff --git a/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.h b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.h
new file mode 100644
index 0000000..3d81083
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetAnimTypePill.h
@@ -0,0 +1,45 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Widgets/SWidget.h"
+
+/**
+ * A value's type shown the way a Blueprint's My Blueprint panel shows a variable's: a small pill in the type's pin color, then
+ * the type's name ("● Float"). Shared by the State Machine editor's Inputs panel and the Widget Animations panel's
+ * Parameters, so both read like Unreal's own variables.
+ *
+ * The colors are the engine's own - asked of the Blueprint schema (UEdGraphSchema_K2::GetPinTypeColor), so they follow the
+ * Graph Editor settings: Bool, Float, Integer, Vector 2D and Color as their pins are, a Choice as an enum's. Trigger and Press
+ * And Hold have no Blueprint type, and keep the plugin's own colors (NameTBD::Colors::StateMachineEditor::InputTrigger / InputHold).
+ */
+namespace WidgetAnimTypePill
+{
+	enum class EKind : uint8
+	{
+		Bool,
+		Float,
+		Integer,
+		Choice,
+		Vector2D,
+		Color,
+		Trigger,
+		Hold
+	};
+
+	/** The pin color of the type in Blueprints - or, for a Trigger and a Press And Hold, the plugin's own. */
+	FLinearColor GetColor(EKind Kind);
+
+	/** "Bool", "Float", "Integer", "Choice", "Vector 2D", "Color", "Trigger", "Hold". */
+	FText GetLabel(EKind Kind);
+
+	/** The pill and the type's name, as one widget. */
+	TSharedRef<SWidget> MakePill(EKind Kind);
+
+	/** How wide the type column is in a list of rows made with MakePill, so the names and types line up row under row. */
+	constexpr float TypeColumnWidth = 92.f;
+
+	/** How wide the value column is beside it. */
+	constexpr float ValueColumnWidth = 124.f;
+}
