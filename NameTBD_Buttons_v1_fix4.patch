diff --git a/Plugins/NameTBD/Source/NameTBD/Buttons/ContextMenuButton.cpp b/Plugins/NameTBD/Source/NameTBD/Buttons/ContextMenuButton.cpp
index a00198a..45b4923 100644
--- a/Plugins/NameTBD/Source/NameTBD/Buttons/ContextMenuButton.cpp
+++ b/Plugins/NameTBD/Source/NameTBD/Buttons/ContextMenuButton.cpp
@@ -1835,12 +1835,43 @@ void UContextMenuButton::OnCreationFromPalette()
 {
 	Super::OnCreationFromPalette();
 
-	// A ready-made button arrives with what it is made of, every part of it editable in the designer like anything placed
-	// by hand.
+	// Nothing is built here. The designer makes the dragged widget again for every drop preview while it is dragged over the
+	// canvas, and parts made in the Widget Blueprint's tree for a preview it then discards stay behind in that tree - each
+	// one an ensure on every compile ("was added but did not get a GUID"). So the button only notes that it wants its parts;
+	// the editor module builds them once the button has really been placed (when it is selected), and gives every part
+	// its GUID - see StyledButtonsEditor.
+	bPendingDefaultContent = ShouldBuildDefaultContentWhenEmpty() && GetChildrenCount() == 0;
+}
+
+void UContextMenuButton::BuildPendingDefaultContent(TArray<UWidget*>& OutParts)
+{
+	OutParts.Reset();
+	if (!bPendingDefaultContent)
+	{
+		return;
+	}
+	bPendingDefaultContent = false;
+
+	// Given content by hand meanwhile: that is the content.
+	if (GetChildrenCount() > 0)
+	{
+		return;
+	}
+
 	BuildDefaultContent();
 	RefreshShapeTargetLooks();
 	SyncEditConditionMirrors();
 	RebuildShapeTargetStatus();
+
+	TArray<ContextMenuButtonTree::FTargetableWidget> Built;
+	ContextMenuButtonTree::Gather(this, FString(), /*bDescendIntoUserWidgets=*/false, Built);
+	for (const ContextMenuButtonTree::FTargetableWidget& Entry : Built)
+	{
+		if (Entry.Widget && Entry.Widget != this)
+		{
+			OutParts.Add(Entry.Widget);
+		}
+	}
 }
 
