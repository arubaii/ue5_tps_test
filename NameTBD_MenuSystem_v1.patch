+void UMenuSettingControl::SetSettingId(FName InSettingId)
+{
+	if (SettingId != InSettingId)
+	{
+		SettingId = InSettingId;
+		InvalidateLayoutAndVolatility();
+		TakeWidget();
+	}
+}
