+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Colors")
+	FLinearColor DisabledText = FLinearColor(1.f, 1.f, 1.f, 0.3f);
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Colors")
+	FLinearColor Divider = FLinearColor(1.f, 1.f, 1.f, 0.08f);
