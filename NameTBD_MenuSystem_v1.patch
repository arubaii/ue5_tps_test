+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Range")
+	float Maximum = 100.f;
+
+	/** An auto range never goes under this top (a quiet graph doesn't blow tiny noise up). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Range")
