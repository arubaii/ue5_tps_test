@@ -0,0 +1,75 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "MenuInputTypes.h"
+
+#define LOCTEXT_NAMESPACE "MenuInputTypes"
+
+const FMenuKeyGlyph* UMenuKeyGlyphSet::Find(const FKey& Key) const
+{
+	return Glyphs.FindByPredicate([&Key](const FMenuKeyGlyph& Glyph) { return Glyph.Key == Key; });
+}
+
+namespace MenuInputUtils
+{
+	FText GetKeyLabel(const FKey& Key, EMenuGamepadFamily Family)
+	{
+		if (!Key.IsValid())
+		{
+			return LOCTEXT("Unbound", "-");
+		}
+		if (!Key.IsGamepadKey())
+		{
+			return Key.GetDisplayName(false);
+		}
+
+		struct FLabel { FKey Key; FText Xbox; FText PlayStation; FText Switch; };
+		static const FLabel Labels[] = {
+			{ EKeys::Gamepad_FaceButton_Bottom, LOCTEXT("XA", "A"), LOCTEXT("PSCross", "Cross"), LOCTEXT("NB", "B") },
+			{ EKeys::Gamepad_FaceButton_Right, LOCTEXT("XB", "B"), LOCTEXT("PSCircle", "Circle"), LOCTEXT("NA", "A") },
+			{ EKeys::Gamepad_FaceButton_Left, LOCTEXT("XX", "X"), LOCTEXT("PSSquare", "Square"), LOCTEXT("NY", "Y") },
+			{ EKeys::Gamepad_FaceButton_Top, LOCTEXT("XY", "Y"), LOCTEXT("PSTriangle", "Triangle"), LOCTEXT("NX", "X") },
+			{ EKeys::Gamepad_LeftShoulder, LOCTEXT("XLB", "LB"), LOCTEXT("PSL1", "L1"), LOCTEXT("NL", "L") },
+			{ EKeys::Gamepad_RightShoulder, LOCTEXT("XRB", "RB"), LOCTEXT("PSR1", "R1"), LOCTEXT("NR", "R") },
+			{ EKeys::Gamepad_LeftTrigger, LOCTEXT("XLT", "LT"), LOCTEXT("PSL2", "L2"), LOCTEXT("NZL", "ZL") },
+			{ EKeys::Gamepad_RightTrigger, LOCTEXT("XRT", "RT"), LOCTEXT("PSR2", "R2"), LOCTEXT("NZR", "ZR") },
+			{ EKeys::Gamepad_LeftTriggerAxis, LOCTEXT("XLT", "LT"), LOCTEXT("PSL2", "L2"), LOCTEXT("NZL", "ZL") },
+			{ EKeys::Gamepad_RightTriggerAxis, LOCTEXT("XRT", "RT"), LOCTEXT("PSR2", "R2"), LOCTEXT("NZR", "ZR") },
+			{ EKeys::Gamepad_LeftThumbstick, LOCTEXT("XLS", "LS"), LOCTEXT("PSL3", "L3"), LOCTEXT("NLS", "L Stick") },
+			{ EKeys::Gamepad_RightThumbstick, LOCTEXT("XRS", "RS"), LOCTEXT("PSR3", "R3"), LOCTEXT("NRS", "R Stick") },
+			{ EKeys::Gamepad_Special_Left, LOCTEXT("XView", "View"), LOCTEXT("PSCreate", "Create"), LOCTEXT("NMinus", "-") },
+			{ EKeys::Gamepad_Special_Right, LOCTEXT("XMenu", "Menu"), LOCTEXT("PSOptions", "Options"), LOCTEXT("NPlus", "+") },
+			{ EKeys::Gamepad_DPad_Up, LOCTEXT("DUp", "D-Pad Up"), LOCTEXT("DUp", "D-Pad Up"), LOCTEXT("DUp", "D-Pad Up") },
+			{ EKeys::Gamepad_DPad_Down, LOCTEXT("DDown", "D-Pad Down"), LOCTEXT("DDown", "D-Pad Down"), LOCTEXT("DDown", "D-Pad Down") },
+			{ EKeys::Gamepad_DPad_Left, LOCTEXT("DLeft", "D-Pad Left"), LOCTEXT("DLeft", "D-Pad Left"), LOCTEXT("DLeft", "D-Pad Left") },
+			{ EKeys::Gamepad_DPad_Right, LOCTEXT("DRight", "D-Pad Right"), LOCTEXT("DRight", "D-Pad Right"), LOCTEXT("DRight", "D-Pad Right") },
+		};
+		for (const FLabel& Label : Labels)
+		{
+			if (Label.Key == Key)
+			{
+				switch (Family)
+				{
+				case EMenuGamepadFamily::PlayStation: return Label.PlayStation;
+				case EMenuGamepadFamily::Switch: return Label.Switch;
+				default: return Label.Xbox;
+				}
+			}
+		}
+		return Key.GetDisplayName(false);
+	}
+
+	EMenuInputDevice GetKeyDevice(const FKey& Key)
+	{
+		if (Key.IsGamepadKey())
+		{
+			return EMenuInputDevice::Gamepad;
+		}
+		if (Key.IsTouch())
+		{
+			return EMenuInputDevice::Touch;
+		}
+		return EMenuInputDevice::KeyboardMouse;
+	}
+}
+
+#undef LOCTEXT_NAMESPACE
diff --git a/Plugins/NameTBD/Source/NameTBD/Menu/Input/MenuInputTypes.h b/Plugins/NameTBD/Source/NameTBD/Menu/Input/MenuInputTypes.h
new file mode 100644
index 0000000..dbdec7f
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Menu/Input/MenuInputTypes.h
@@ -0,0 +1,92 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Engine/DataAsset.h"
+#include "InputCoreTypes.h"
+#include "NameTBD/Menu/Settings/MenuSettingTypes.h"
+
+#include "MenuInputTypes.generated.h"
+
+/** What the player last used. */
+UENUM(BlueprintType)
+enum class EMenuInputDevice : uint8
+{
+	KeyboardMouse UMETA(DisplayName = "Keyboard & Mouse"),
+	Gamepad,
+	Touch
+};
+
+/** Whose button prompts a gamepad shows. */
+UENUM(BlueprintType)
+enum class EMenuGamepadFamily : uint8
+{
+	Generic UMETA(ToolTip = "Neutral prompts (labels like \"A\", \"LB\" without a brand's art)."),
+	Xbox,
+	PlayStation,
+	Switch UMETA(DisplayName = "Nintendo Switch"),
+	SteamDeck UMETA(DisplayName = "Steam Deck")
+};
+
+/** What happens when a key being bound is already bound to something else. */
+UENUM(BlueprintType)
+enum class EMenuKeyConflictPolicy : uint8
+{
+	Swap UMETA(ToolTip = "The other input takes this one's old key (nothing is left unbound)."),
+	Unbind UMETA(ToolTip = "The other input loses the key (it shows as unbound)."),
+	Allow UMETA(ToolTip = "Both keep it (both act on the key)."),
+	Refuse UMETA(ToolTip = "The key isn't bound; the row says which input has it.")
+};
+
+/** One key's prompt: an image (the platform's art), or a label drawn as a key cap. */
+USTRUCT(BlueprintType)
+struct NAMETBD_API FMenuKeyGlyph
+{
+	GENERATED_BODY()
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Glyph")
+	FKey Key;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Glyph")
+	FMenuImage Image;
+
+	/** The key cap's text when there is no image ("LB", "Space"). Empty: the key's short name. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Glyph")
+	FText Label;
+};
+
+/**
+ * Button prompt art for one device family: Xbox, PlayStation, Switch, Steam Deck, or keyboard and mouse (Family Generic with
+ * For Keyboard on). List them in Project Settings > Plugins > Menus > Key Glyph Sets. A key without art here shows as a key
+ * cap with its name (or the set's label), so prompts always read.
+ */
+UCLASS(BlueprintType, meta = (DisplayName = "Key Glyph Set"))
+class NAMETBD_API UMenuKeyGlyphSet : public UDataAsset
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The gamepads this art is for. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Glyphs")
+	EMenuGamepadFamily Family = EMenuGamepadFamily::Xbox;
+
+	/** This set is the keyboard and mouse art (Family is then ignored). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Glyphs")
+	bool bForKeyboard = false;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Glyphs", meta = (TitleProperty = "Key"))
+	TArray<FMenuKeyGlyph> Glyphs;
+
+	const FMenuKeyGlyph* Find(const FKey& Key) const;
+};
+
+namespace MenuInputUtils
+{
+	/** A key's family-appropriate short label when there is no art: "A" / "Cross", "LB" / "L1", "Space", "LMB". */
+	NAMETBD_API FText GetKeyLabel(const FKey& Key, EMenuGamepadFamily Family);
+
+	/** The device a key belongs to (mouse keys are Keyboard & Mouse; touch keys Touch). */
+	NAMETBD_API EMenuInputDevice GetKeyDevice(const FKey& Key);
+}
diff --git a/Plugins/NameTBD/Source/NameTBD/Menu/Input/MenuKeyPrompt.cpp b/Plugins/NameTBD/Source/NameTBD/Menu/Input/MenuKeyPrompt.cpp
