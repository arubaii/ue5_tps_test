+class SStatGraph;
+class UStatGraph;
+
+/** How a line is drawn. */
+UENUM(BlueprintType)
+enum class EStatGraphStyle : uint8
+{
+	Line,
+	Area UMETA(ToolTip = "A line with the area under it filled faintly."),
+	Bars UMETA(ToolTip = "One bar per sample (frame time spikes stand out).")
