+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Look")
+	EMenuBoolDisplay BoolDisplay = EMenuBoolDisplay::Switch;
+
+	/** A Choice set to Auto shows as a dropdown past this many options. */
