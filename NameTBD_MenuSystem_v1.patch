+FString UMenuSettingsSubsystem::GetSettingValue(FName SettingId) const
+{
+	if (const FString* Waiting = Pending.Find(SettingId))
+	{
+		return *Waiting;
+	}
+	if (const FString* Current = Values.Find(SettingId))
+	{
+		return *Current;
+	}
