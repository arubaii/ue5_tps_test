+		AddStandardModes(Feature, TEXT("r.FidelityFX.FSR3.QualityMode"), { TEXT("0"), TEXT("1"), TEXT("2"), TEXT("3"), TEXT("4") }, true, TEXT("NativeAA"), LOCTEXT("ModeNativeAA", "Native AA"));
+		Feature.DefaultMode = TEXT("Quality");
