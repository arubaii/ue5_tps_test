+				.VAlign(VAlign_Center)
+				[
+					SNew(STextBlock)
+					.Text(TitleAttribute)
+					.Font_Lambda([Holder]() { return Holder->Style.TitleFont; })
+					.ColorAndOpacity_Lambda([Holder]() { return FSlateColor(Holder->Palette().Text); })
+				]
+				+ SHorizontalBox::Slot()
+				.AutoWidth()
+				.VAlign(VAlign_Center)
+				[
