+	double Round(double Value, int32 Digits)
+	{
+		const double Scale = FMath::Pow(10.0, static_cast<double>(Digits));
+		const double Rounded = FMath::RoundHalfFromZero(Value * Scale) / Scale;
+		return Rounded == 0.0 ? 0.0 : Rounded;
