+void FWidgetAnimTextStyle::GetResolvedRuns(TArray<FWidgetAnimTextRunStyle>& OutRuns) const
+{
+	OutRuns.Reset();
+	if (Runs.Num() == 0)
+	{
+		FWidgetAnimTextRunStyle& Whole = OutRuns.Add_GetRef(Default);
+		Whole.Begin = 0;
+		Whole.End = Text.Len();
