+		FTextBlockStyle Normal;
+		FTextBlockStyle Keyword;
+		FTextBlockStyle Constant;
+		FTextBlockStyle String;
+		FTextBlockStyle Comment;
+		FTextBlockStyle Number;
+		FTextBlockStyle Builtin;
+		FTextBlockStyle Api;
+		FTextBlockStyle Definition;
