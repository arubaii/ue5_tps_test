+	FWidgetAnimScriptEdit Edit(*this, LOCTEXT("RenameGroup", "Rename Layer Group"));
+	if (!Edit.IsOpen())
+	{
+		return false;
+	}
+	(*GetGroupsArray())[Group].GroupName = Name.TrimStartAndEnd();
+	Edit.Changed(EPropertyChangeType::ValueSet);
+	return true;
