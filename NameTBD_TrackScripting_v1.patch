+	// ITextLayoutMarshaller
+	virtual void SetText(const FString& SourceString, FTextLayout& TargetTextLayout) override;
+	virtual bool RequiresLiveUpdate() const override { return true; }
+
+private:
+
+	FStyles Styles;
+};
