+	void PlaceScriptingDrawer(const TSharedRef<FAssetEditorToolkit>& Toolkit, const FEditorWidgetAnimations& Entry)
+	{
+		UStatusBarSubsystem* StatusBars = GEditor ? GEditor->GetEditorSubsystem<UStatusBarSubsystem>() : nullptr;
