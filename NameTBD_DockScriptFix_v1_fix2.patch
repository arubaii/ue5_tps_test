+	/**
+	 * The script area for a tab: the output under the code, and its close button closes whichever tab holds it - the one
+	 * docked beside Details or the one the Window menu opens.
+	 */
+	TSharedRef<SWidget> MakeScriptingTabBody(const TWeakPtr<FAssetEditorToolkit>& WeakToolkit)
+	{
+		const TSharedRef<TWeakPtr<SWidget>> Self = MakeShared<TWeakPtr<SWidget>>();
+		const TSharedRef<SWidget> Body = SNew(SWidgetAnimScriptPanel)
+			.FindPanel([WeakToolkit]() { return FindScriptedPanel(WeakToolkit); })
+			.Docked(true)
+			.OnClose_Lambda([Self]()
+			{
+				for (TSharedPtr<SWidget> Walk = Self->Pin(); Walk.IsValid(); Walk = Walk->GetParentWidget())
+				{
+					if (Walk->GetType() == FName(TEXT("SDockTab")))
+					{
+						StaticCastSharedPtr<SDockTab>(Walk)->RequestCloseTab();
+						return;
+					}
+				}
+			});
+		*Self = Body;
+		return Body;
+	}
