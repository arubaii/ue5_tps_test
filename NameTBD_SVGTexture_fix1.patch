+
+	FCanvasTileItem ImageTile(TilePosition, DrawnTexture->GetResource(), TileSize, FLinearColor::White);
+	ImageTile.BlendMode = SE_BLEND_Translucent;
+	Canvas->DrawItem(ImageTile);
+}
