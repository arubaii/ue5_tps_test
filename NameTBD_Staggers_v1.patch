diff --git a/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimTextReveal.cpp b/Plugins/NameTBD/Source/NameTBD/WidgetAnimation/Evaluators/WidgetAnimTextReveal.cpp
