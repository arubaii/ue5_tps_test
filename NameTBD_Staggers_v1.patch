+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetAnimTextReveal.h"
+
+#include "Components/TextBlock.h"
+#include "NameTBD/Widgets/WidgetAnimTextBlock.h"
+#include "UObject/ObjectKey.h"
+#include "WidgetAnimCountUp.h" // FWidgetAnimTextBaseline, the shared Text channel
+
+#define LOCTEXT_NAMESPACE "WidgetAnimTextReveal"
+
+namespace WidgetAnimTextRevealState
+{
+	/**
+	 * What a plain Text Block is revealing: the full text, where each part of it ends, and what was last written - so a
+	 * text the game sets while a reveal plays is noticed (the block no longer shows what was written) and revealed in
+	 * its place. The evaluator itself holds no state; this lives with the library, keyed by block, like the quantized
+	 * writes the library remembers.
+	 */
+	struct FEntry
+	{
+		FText Source;
+		FString SourceString;
+		EWidgetAnimTextUnit Unit = EWidgetAnimTextUnit::Letter;
+		TArray<int32> PartEnds;
+		FString LastWritten;
+		bool bHasWritten = false;
+	};
+
+	TMap<FObjectKey, FEntry>& Get()
+	{
+		static TMap<FObjectKey, FEntry> Entries;
+		return Entries;
+	}
+
+	/** Where each part of Text ends: its letters, its words, or its own lines. */
+	void FindPartEnds(const FString& Text, EWidgetAnimTextUnit Unit, TArray<int32>& OutEnds)
+	{
+		OutEnds.Reset();
+
+		TArray<WidgetAnimTextParts::FRange> Letters;
+		WidgetAnimTextParts::GetLetters(Text, Letters);
+
+		if (Unit == EWidgetAnimTextUnit::Word)
+		{
+			TArray<WidgetAnimTextParts::FRange> Words;
+			WidgetAnimTextParts::GetWords(Letters, Words);
+			for (const WidgetAnimTextParts::FRange& Word : Words)
+			{
+				OutEnds.Add(Word.End);
+			}
+			return;
+		}
+
+		if (Unit == EWidgetAnimTextUnit::Line)
+		{
+			// A plain Text Block's lines are its text's own line breaks: where it wraps is up to its Slate widget.
+			// Lines with no letters are no part of their own - they come with the line after them.
+			int32 LineEnd = 0;
+			for (const WidgetAnimTextParts::FRange& Letter : Letters)
+			{
+				if (Letter.Begin < LineEnd)
+				{
+					continue;
+				}
+				LineEnd = Letter.End;
+				while (LineEnd < Text.Len() && Text[LineEnd] != TEXT('\n'))
+				{
+					++LineEnd;
+				}
+				OutEnds.Add(LineEnd);
+			}
+			return;
+		}
+
+		for (const WidgetAnimTextParts::FRange& Letter : Letters)
+		{
+			OutEnds.Add(Letter.End);
+		}
+	}
+}
+
+FText FWidgetAnimTextRevealEvaluator::GetDisplayName() const
+{
+	return LOCTEXT("DisplayName", "Text Reveal");
+}
+
+FText FWidgetAnimTextRevealEvaluator::GetDescription() const
+{
+	return LOCTEXT("Description", "Types a Text Block's text out a letter, word or line at a time, and puts its own text back afterwards. On an Animated Text Block the letters not reached yet keep their places, so the text never re-wraps as it types. Aimed at a widget that is not a Text Block, it types out the first Text Block inside it.");
+}
+
+FText FWidgetAnimTextRevealEvaluator::GetValueLabel() const
+{
+	return LOCTEXT("ValueLabel", "Revealed");
+}
+
+UClass* FWidgetAnimTextRevealEvaluator::GetTargetClass() const
+{
+	return UTextBlock::StaticClass();
+}
+
+FName FWidgetAnimTextRevealEvaluator::GetChannel(const FInstancedStruct& Params) const
+{
+	return FWidgetAnimCountUpEvaluator::TextChannel;
+}
+
+double FWidgetAnimTextRevealEvaluator::GetEndpointValue(const FInstancedStruct& Params, bool bStart) const
+{
+	const FWidgetAnimTextRevealParams* Reveal = GetParams(Params);
+	if (!Reveal)
+	{
+		return bStart ? 0.0 : 1.0;
+	}
+	return bStart ? Reveal->StartValue : Reveal->EndValue;
+}
+
+int32 FWidgetAnimTextRevealEvaluator::GetRevealedCount(double Revealed, int32 NumParts)
+{
+	// A hair of slack, so 1.0 reached through float keys still shows the last part.
+	return FMath::Clamp(FMath::FloorToInt32(FMath::Clamp(Revealed, 0.0, 1.0) * NumParts + 1.e-4), 0, NumParts);
+}
+
+void FWidgetAnimTextRevealEvaluator::Apply(UObject* Target, const FInstancedStruct& Params, double Value) const
+{
+	UTextBlock* TextBlock = Cast<UTextBlock>(Target);
+	const FWidgetAnimTextRevealParams* Reveal = GetParams(Params);
+	if (!TextBlock || !Reveal)
+	{
+		return;
+	}
+
+	// An Animated Text Block lays the whole text out and only draws part of it, so nothing moves as it types.
+	if (UWidgetAnimTextBlock* Animated = Cast<UWidgetAnimTextBlock>(TextBlock))
+	{
+		if (!Reveal->Text.IsEmpty() && !Animated->GetText().EqualTo(Reveal->Text))
+		{
+			Animated->SetText(Reveal->Text);
+		}
+
+		const FName PartUnit = Reveal->Unit == EWidgetAnimTextUnit::Word ? WidgetAnimPartUnits::Word
+			: Reveal->Unit == EWidgetAnimTextUnit::Line ? WidgetAnimPartUnits::Line
+			: WidgetAnimPartUnits::Letter;
+		const int32 NumParts = Animated->GetWidgetAnimPartCount(PartUnit);
+		const int32 Count = GetRevealedCount(Value, NumParts);
+		Animated->SetRevealedParts(PartUnit, Count >= NumParts ? INDEX_NONE : Count);
+		return;
+	}
+
+	TMap<FObjectKey, WidgetAnimTextRevealState::FEntry>& Entries = WidgetAnimTextRevealState::Get();
+	if (Entries.Num() > 256)
+	{
+		// Blocks long gone are dropped wholesale rather than tracked; a live one only starts its text over.
+		Entries.Reset();
+	}
+	WidgetAnimTextRevealState::FEntry& Entry = Entries.FindOrAdd(FObjectKey(TextBlock));
+
+	// What to reveal: the track's own text, or the block's - the one it was revealing, unless something else has set a
+	// new one since, which is then revealed instead.
+	const FText Current = TextBlock->GetText();
+	FText Source = Reveal->Text;
+	if (Source.IsEmpty())
+	{
+		const bool bStillOurs = Entry.bHasWritten && Current.ToString().Equals(Entry.LastWritten, ESearchCase::CaseSensitive);
+		Source = bStillOurs ? Entry.Source : Current;
+	}
+
+	const FString SourceString = Source.ToString();
+	if (!SourceString.Equals(Entry.SourceString, ESearchCase::CaseSensitive) || Entry.Unit != Reveal->Unit || !Entry.bHasWritten)
+	{
+		Entry.Source = Source;
+		Entry.SourceString = SourceString;
+		Entry.Unit = Reveal->Unit;
+		WidgetAnimTextRevealState::FindPartEnds(SourceString, Reveal->Unit, Entry.PartEnds);
+	}
+
+	const int32 NumParts = Entry.PartEnds.Num();
+	const int32 Count = GetRevealedCount(Value, NumParts);
+
+	// All of it: the text itself, so a localized text stays one - not a copy of its string.
+	const bool bAll = Count >= NumParts;
+	const FString Shown = bAll ? SourceString : SourceString.Left(Count > 0 ? Entry.PartEnds[Count - 1] : 0);
+	if (!Current.ToString().Equals(Shown, ESearchCase::CaseSensitive))
+	{
+		TextBlock->SetText(bAll ? Source : FText::FromString(Shown));
+	}
+	Entry.LastWritten = Shown;
+	Entry.bHasWritten = true;
+}
+
+bool FWidgetAnimTextRevealEvaluator::CaptureBaseline(UObject* Target, const FInstancedStruct& Params, FInstancedStruct& OutBaseline) const
+{
+	const UTextBlock* TextBlock = Cast<UTextBlock>(Target);
+	if (!TextBlock)
+	{
+		return false;
+	}
+
+	FWidgetAnimTextBaseline Baseline;
+	Baseline.Text = TextBlock->GetText();
+	OutBaseline.InitializeAs<FWidgetAnimTextBaseline>(Baseline);
+	return true;
+}
+
+void FWidgetAnimTextRevealEvaluator::RestoreBaseline(UObject* Target, const FInstancedStruct& Baseline) const
+{
+	UTextBlock* TextBlock = Cast<UTextBlock>(Target);
+	if (!TextBlock)
+	{
+		return;
+	}
+
+	WidgetAnimTextRevealState::Get().Remove(FObjectKey(TextBlock));
+
+	if (UWidgetAnimTextBlock* Animated = Cast<UWidgetAnimTextBlock>(TextBlock))
+	{
+		Animated->SetRevealedParts(NAME_None, INDEX_NONE);
+	}
+
+	const FWidgetAnimTextBaseline* Captured = Baseline.GetPtr<FWidgetAnimTextBaseline>();
+	if (Captured && !TextBlock->GetText().EqualTo(Captured->Text))
+	{
+		TextBlock->SetText(Captured->Text);
+	}
+}
+
+#undef LOCTEXT_NAMESPACE
