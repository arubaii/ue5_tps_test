+/**
+ * Everything an SWidgetAnimText draws: its text and how it looks. Read off the UWidgetAnimTextBlock that owns it, the
+ * same fields a Text Block has.
+ */
+struct NAMETBD_API FWidgetAnimTextStyle
+{
+	/** The string as drawn: the Text Block's text with its Transform Policy (upper or lower case) applied. */
+	FString Text;
+
+	FSlateFontInfo Font;
+	FSlateColor Color = FSlateColor(FLinearColor::White);
+	FVector2D ShadowOffset = FVector2D(1.0, 1.0);
+	FLinearColor ShadowColor = FLinearColor::Transparent;
+	ETextJustify::Type Justification = ETextJustify::Left;
+	bool bAutoWrap = false;
+	float WrapTextAt = 0.f;
+	FMargin Margin;
+	float LineHeight = 1.f;
+	float MinDesiredWidth = 0.f;
+
+	/** Whether Other would be laid out differently: other lines, other letter positions, another size. */
+	bool ChangesLayout(const FWidgetAnimTextStyle& Other) const;
+
+	/** Whether Other would only be drawn differently, in the same place: a color, a shadow, the alignment of lines. */
+	bool ChangesPaint(const FWidgetAnimTextStyle& Other) const;
+};
+
+/**
+ * The Slate side of an Animated Text Block: a text drawn letter by letter, so each letter, word and line can be posed on
+ * its own - moved, scaled, turned, sheared, faded - about its own middle, and letters can be hidden without the text
+ * around them moving (a typewriter that doesn't re-wrap as it types).
+ *
+ * It lays its text out itself: lines broken at white space to fit its width (or Wrap Text At), a word too long for a
+ * line broken between letters, lines aligned by Justification. Nothing is laid out again while it animates - poses and
+ * reveals only change how the laid-out letters are drawn. With nothing posed and everything shown, each line is drawn
+ * whole, as cheaply as a Text Block draws it.
+ *
+ * What it doesn't do that a Text Block does: rich text, overflow ellipsis, strike-through, and the finer wrapping
+ * policies. Right-to-left text is drawn correctly as long as nothing is posed; posed, its letters are placed in reading
+ * order, left to right.
+ */
+class NAMETBD_API SWidgetAnimText : public SLeafWidget
+{
+public:
+
+	SLATE_BEGIN_ARGS(SWidgetAnimText) {}
+		/**
+		 * Asked every frame for the owner's current text and style, so a change made any way - a Blueprint setting a
+		 * color, a binding - is picked up without the owner having to push it.
+		 */
+		SLATE_ARGUMENT(TFunction<void(FWidgetAnimTextStyle&)>, StyleSource)
+	SLATE_END_ARGS()
+
+	void Construct(const FArguments& InArgs);
+
+	/** Takes a new text and style now, laying out again only if they need it. */
+	void SetStyle(const FWidgetAnimTextStyle& InStyle);
+
+	/** Every part's pose for this frame, replacing the last frame's. See IWidgetAnimPartHost::SetWidgetAnimPartPoses. */
+	void SetPartPoses(TConstArrayView<FWidgetAnimPartPose> InPoses);
+
+	/** Every part back at rest. */
+	void ClearPartPoses();
+
+	/**
+	 * Shows only the first Count parts of Unit (Letter, Word or Line) - the rest are laid out but not drawn. INDEX_NONE
+	 * shows everything.
+	 */
+	void SetReveal(FName Unit, int32 Count);
+
+	/** How many lines the text is laid out on at its current width. */
+	int32 GetLineCount() const;
+
+	/** Whether it has been given a width yet - before that, a wrapping text's lines are only a guess. */
+	bool HasBeenArranged() const { return bHasBeenArranged; }
+
+	// SWidget
+	virtual void Tick(const FGeometry& AllottedGeometry, const double InCurrentTime, const float InDeltaTime) override;
+	virtual int32 OnPaint(const FPaintArgs& Args, const FGeometry& AllottedGeometry, const FSlateRect& MyCullingRect,
+		FSlateWindowElementList& OutDrawElements, int32 LayerId, const FWidgetStyle& InWidgetStyle, bool bParentEnabled) const override;
+
+protected:
+
+	virtual FVector2D ComputeDesiredSize(float LayoutScaleMultiplier) const override;
+
+private:
+
+	/**
+	 * The text laid out at one scale and width, in pixels at that scale. Two are kept - one measured at the layout
+	 * scale for the desired size, one at the scale it is drawn at - so neither lays the text out again every frame.
+	 */
+	struct FLayout
+	{
+		float Scale = 0.f;
+		float WrapWidth = -1.f;
+		uint32 Version = 0;
+		bool bValid = false;
+		bool bWithGlyphs = false;
+
+		/** Height of one line's glyphs, and the distance from one line's top to the next's. */
+		float TextHeight = 0.f;
+		float LinePitch = 0.f;
+
+		/** The widest line, and every line's height together. */
+		FVector2f Size = FVector2f::ZeroVector;
+
+		struct FLine
+		{
+			int32 Begin = 0;
+			int32 End = 0;
+			float Width = 0.f;
+			float Top = 0.f;
+			FShapedGlyphSequencePtr Glyphs;
+		};
+		TArray<FLine> Lines;
+
+		struct FLetter
+		{
+			int32 Line = 0;
+			float X = 0.f;
+			float Width = 0.f;
+			FShapedGlyphSequencePtr Glyphs;
+		};
+		TArray<FLetter> Letters;
+	};
+
+	/** Lays the text out into Layout at Scale and WrapWidth (in local units, 0 for no wrapping) unless it already is. */
+	void EnsureLayout(FLayout& Layout, float Scale, float WrapWidth, bool bWithGlyphs) const;
+
+	/** The width lines wrap at, in local units: Wrap Text At, else the arranged width with Auto Wrap Text, else 0 (none). */
+	float GetWrapWidth() const;
+
+	/** Rebuilds the letter and word lists from the text. */
+	void RebuildParts();
+
+	/** Which pose each letter, word and line has this frame, by index - INDEX_NONE for none. */
+	void RebuildPoseIndex() const;
+
+	TFunction<void(FWidgetAnimTextStyle&)> StyleSource;
+	FWidgetAnimTextStyle Style;
+
+	/** Bumped whenever the layout has to be worked out again. */
+	uint32 LayoutVersion = 1;
+	mutable FLayout MeasureLayout;
+	mutable FLayout PaintLayout;
+
+	TArray<WidgetAnimTextParts::FRange> Letters;
+	TArray<int32> WordOfLetter;
+	int32 NumWords = 0;
+
+	TArray<FWidgetAnimPartPose> Poses;
+	mutable bool bPoseIndexDirty = true;
+	mutable TArray<int32> LetterPose;
+	mutable TArray<int32> WordPose;
+	mutable TArray<int32> LinePose;
+
+	FName RevealUnit;
+	int32 RevealCount = INDEX_NONE;
+
+	float ArrangedWidth = -1.f;
+	bool bHasBeenArranged = false;
+};
diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetAnimTextBlock.cpp b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetAnimTextBlock.cpp
new file mode 100644
index 0000000..c54ca4d
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetAnimTextBlock.cpp
@@ -0,0 +1,165 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetAnimTextBlock.h"
+
+#include "SWidgetAnimText.h"
+
+void UWidgetAnimTextBlock::SetText(FText InText)
+{
+	Super::SetText(InText);
+
+	// Now, not on the next tick: a text set and then animated letter by letter in the same frame must be counted and
+	// laid out as the new text.
+	bCounted = false;
+	if (MyAnimText.IsValid())
+	{
+		FWidgetAnimTextStyle Style;
+		GatherStyle(Style);
+		MyAnimText->SetStyle(Style);
+	}
+}
+
+void UWidgetAnimTextBlock::SynchronizeProperties()
+{
+	// The Text Block's own synchronizing does nothing here - its Slate text block is never made - but its base's does.
+	Super::SynchronizeProperties();
+
+	bCounted = false;
+	if (MyAnimText.IsValid())
+	{
+		FWidgetAnimTextStyle Style;
+		GatherStyle(Style);
+		MyAnimText->SetStyle(Style);
+		MyAnimText->SetReveal(RevealUnit, RevealCount);
+	}
+}
+
+void UWidgetAnimTextBlock::ReleaseSlateResources(bool bReleaseChildren)
+{
+	Super::ReleaseSlateResources(bReleaseChildren);
+	MyAnimText.Reset();
+}
+
+TSharedRef<SWidget> UWidgetAnimTextBlock::RebuildWidget()
+{
+	// Its own Slate widget in place of the Text Block's. The Text Block's is never made, and everything the Text Block
+	// does with it is skipped while it doesn't exist - which is how every setting of the Text Block still works: the
+	// setters store their values, and the widget reads them every frame (see StyleSource).
+	MyAnimText = SNew(SWidgetAnimText)
+		.StyleSource([WeakThis = TWeakObjectPtr<UWidgetAnimTextBlock>(this)](FWidgetAnimTextStyle& OutStyle)
+		{
+			if (const UWidgetAnimTextBlock* Self = WeakThis.Get())
+			{
+				Self->GatherStyle(OutStyle);
+			}
+		});
+
+	MyAnimText->SetReveal(RevealUnit, RevealCount);
+	return MyAnimText.ToSharedRef();
+}
+
+FString UWidgetAnimTextBlock::GetDisplayString() const
+{
+	const FText Current = GetText();
+	switch (GetTextTransformPolicy())
+	{
+	case ETextTransformPolicy::ToUpper: return Current.ToUpper().ToString();
+	case ETextTransformPolicy::ToLower: return Current.ToLower().ToString();
+	default:                            return Current.ToString();
+	}
+}
+
+void UWidgetAnimTextBlock::GatherStyle(FWidgetAnimTextStyle& OutStyle) const
+{
+	OutStyle.Text = GetDisplayString();
+	OutStyle.Font = GetFont();
+	OutStyle.Color = GetColorAndOpacity();
+	OutStyle.ShadowOffset = GetShadowOffset();
+	OutStyle.ShadowColor = GetShadowColorAndOpacity();
+	OutStyle.MinDesiredWidth = GetMinDesiredWidth();
+	OutStyle.bAutoWrap = GetAutoWrapText();
+	OutStyle.WrapTextAt = GetWrapTextAt();
+
+	// The Text Layout Widget's own settings, read where it keeps them.
+	OutStyle.Justification = Justification;
+	OutStyle.Margin = Margin;
+	OutStyle.LineHeight = LineHeightPercentage;
+}
+
+void UWidgetAnimTextBlock::UpdatePartCounts() const
+{
+	const FString Display = GetDisplayString();
+	if (bCounted && Display.Equals(CountedString, ESearchCase::CaseSensitive))
+	{
+		return;
+	}
+
+	// Counted the same way the Slate widget and Text Reveal count them, so a stagger's letters are exactly its letters.
+	TArray<WidgetAnimTextParts::FRange> Letters;
+	TArray<WidgetAnimTextParts::FRange> Words;
+	WidgetAnimTextParts::GetLetters(Display, Letters);
+	WidgetAnimTextParts::GetWords(Letters, Words);
+
+	CountedString = Display;
+	NumLetters = Letters.Num();
+	NumWords = Words.Num();
+	bCounted = true;
+}
+
+int32 UWidgetAnimTextBlock::GetWidgetAnimPartCount(FName Unit) const
+{
+	if (Unit == WidgetAnimPartUnits::Letter || Unit == WidgetAnimPartUnits::Word)
+	{
+		UpdatePartCounts();
+		return Unit == WidgetAnimPartUnits::Letter ? NumLetters : NumWords;
+	}
+
+	if (Unit == WidgetAnimPartUnits::Line)
+	{
+		// Lines depend on the width it wraps at, so only its Slate widget knows them; before it has one, a text with
+		// anything in it is taken as one line.
+		if (MyAnimText.IsValid())
+		{
+			return MyAnimText->GetLineCount();
+		}
+		return GetDisplayString().IsEmpty() ? 0 : 1;
+	}
+
+	return 0;
+}
+
+bool UWidgetAnimTextBlock::AreWidgetAnimPartsReady(FName Unit) const
+{
+	// Only lines wait, and only when they wrap to a width that isn't known until the block has been arranged.
+	if (Unit != WidgetAnimPartUnits::Line || GetWrapTextAt() > 0.f || !GetAutoWrapText())
+	{
+		return true;
+	}
+	return MyAnimText.IsValid() && MyAnimText->HasBeenArranged();
+}
+
+void UWidgetAnimTextBlock::SetWidgetAnimPartPoses(TConstArrayView<FWidgetAnimPartPose> Poses)
+{
+	if (MyAnimText.IsValid())
+	{
+		MyAnimText->SetPartPoses(Poses);
+	}
+}
+
+void UWidgetAnimTextBlock::ClearWidgetAnimPartPoses()
+{
+	if (MyAnimText.IsValid())
+	{
+		MyAnimText->ClearPartPoses();
+	}
+}
+
+void UWidgetAnimTextBlock::SetRevealedParts(FName Unit, int32 Count)
+{
+	RevealUnit = Count == INDEX_NONE ? NAME_None : Unit;
+	RevealCount = Count;
+	if (MyAnimText.IsValid())
+	{
+		MyAnimText->SetReveal(RevealUnit, RevealCount);
+	}
+}
