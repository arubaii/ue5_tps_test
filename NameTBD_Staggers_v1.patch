+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/TextBlock.h"
+#include "NameTBD/WidgetAnimation/WidgetAnimParts.h"
+
+#include "WidgetAnimTextBlock.generated.h"
+
+class SWidgetAnimText;
+struct FWidgetAnimTextStyle;
+
+/**
+ * Animated Text Block: a Text Block whose letters, words and lines widget animations can move one by one.
+ *
+ * A plain Text Block draws its string as one piece, so a track can only move all of it. This one draws each letter on
+ * its own, so a track with an Each Letter, Word or Line stagger (see WidgetAnimExpander.h) can fade, drop, pop, turn or
+ * shear them in one after another - any Fade, Scale, Slide, Rotate, Pulse or Transform track, each part turned about
+ * its own middle. And a Text Reveal track types it out without the text re-wrapping as it goes: the letters not
+ * reached yet keep their places, unseen.
+ *
+ * Everything else is a Text Block's: the same Text, Font, Color and Opacity, Shadow, Justification, Wrapping, Margin,
+ * Line Height and Transform Policy, set the same ways - in the designer, or from a Blueprint at runtime, whose changes
+ * it picks up the next frame. So it can replace a Text Block anywhere (Replace With in the designer), and a Count Up
+ * or any other text track treats it as one.
+ *
+ * What it leaves out: rich text, overflow ellipsis, strike-through, and wrapping policies beyond breaking at white space.
+ * Keep plain Text Blocks for text that never animates by the letter: they are cheaper to lay out.
+ */
+UCLASS(meta = (DisplayName = "Animated Text Block"))
+class NAMETBD_API UWidgetAnimTextBlock : public UTextBlock, public IWidgetAnimPartHost
+{
+	GENERATED_BODY()
+
+public:
+
+	virtual void SetText(FText InText) override;
+	virtual void SynchronizeProperties() override;
+	virtual void ReleaseSlateResources(bool bReleaseChildren) override;
+
+	// IWidgetAnimPartHost
+	virtual int32 GetWidgetAnimPartCount(FName Unit) const override;
+	virtual bool AreWidgetAnimPartsReady(FName Unit) const override;
+	virtual void SetWidgetAnimPartPoses(TConstArrayView<FWidgetAnimPartPose> Poses) override;
+	virtual void ClearWidgetAnimPartPoses() override;
+
+	/**
+	 * Draws only the first Count letters, words or lines (Unit: see WidgetAnimPartUnits); the rest keep their places,
+	 * unseen. INDEX_NONE draws everything. What a Text Reveal track sets.
+	 */
+	void SetRevealedParts(FName Unit, int32 Count);
+
+	/** The string as drawn: the Text with its Transform Policy applied. What its letters are counted in. */
+	FString GetDisplayString() const;
+
+	/** Reads this block's text and every style setting its Slate widget draws with. */
+	void GatherStyle(FWidgetAnimTextStyle& OutStyle) const;
+
+protected:
+
+	virtual TSharedRef<SWidget> RebuildWidget() override;
+
+private:
+
+	/** Letters and words of the display string, counted once per text. */
+	void UpdatePartCounts() const;
+
+	TSharedPtr<SWidgetAnimText> MyAnimText;
+
+	FName RevealUnit;
+	int32 RevealCount = INDEX_NONE;
+
+	mutable FString CountedString;
+	mutable int32 NumLetters = 0;
+	mutable int32 NumWords = 0;
+	mutable bool bCounted = false;
+};
