diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/FlowList/SFlowList.cpp b/Plugins/NameTBD/Source/NameTBD/Widgets/FlowList/SFlowList.cpp
index dfc79d7..e6a4cad 100644
--- a/Plugins/NameTBD/Source/NameTBD/Widgets/FlowList/SFlowList.cpp
+++ b/Plugins/NameTBD/Source/NameTBD/Widgets/FlowList/SFlowList.cpp
@@ -1455,7 +1455,15 @@ void SFlowList::UpdateNearest()
 	const bool bFollow = Motion == EMotion::Drag || Motion == EMotion::Coast || (Motion == EMotion::Spring && bSelectionFollowsSpring);
 	if (bFollow)
 	{
-		SetSelected(Now, true);
+		// Select While Scrolling off: it waits for the list to come to rest.
+		if (Scrolling.bSelectWhileScrolling)
+		{
+			SetSelected(Now, true);
+		}
+		else
+		{
+			bSelectionDueAtRest = true;
+		}
 	}
 }
 
@@ -3167,6 +3175,16 @@ EActiveTimerReturnType SFlowList::OnAnimate(double InCurrentTime, float InDeltaT
 	const bool bMoving = Motion != EMotion::Idle;
 	if (bWasMoving && !bMoving && LiveOrder.Num() > 0)
 	{
+		// At rest: the item at the focus is the selection now, if scrolling passed others without selecting them.
+		if (bSelectionDueAtRest)
+		{
+			bSelectionDueAtRest = false;
+			const int32 AtFocus = IndexAt(Scroll);
+			if (AtFocus != INDEX_NONE && AtFocus != SelectedIndex)
+			{
+				SetSelected(AtFocus, true);
+			}
+		}
 		OnSettled.ExecuteIfBound(SelectedIndex);
 	}
 	bWasMoving = bMoving;
