+	/**
+	 * While the list is dragged, flung or wheeled, the selection follows whichever item passes the focus - a dial clicking
+	 * past each item, its select sound, selection events and Play On Selection animations with it. Off: scrolling only
+	 * moves the list, and the selection moves once, to the item at the focus, when the list comes to rest. Navigation,
+	 * clicks and Scroll To Index select as always.
+	 */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Scrolling", meta = (DisplayName = "Select While Scrolling"))
+	bool bSelectWhileScrolling = true;
+
 	/** Clicking or tapping an item that isn't the focused one scrolls it to the focus. */
