+	Stroke.bEnabled = true;
+	Stroke.Align = EWidgetShapeStrokeAlign::Center;
+	Stroke.Join = EWidgetShapeLineJoin::Round;
+	Stroke.Cap = Line.Cap;
+	Stroke.DashLength = Line.DashLength;
+	Stroke.DashGap = Line.DashGap;
