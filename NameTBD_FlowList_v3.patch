+	Stroke.Width = Thickness;
+	FWidgetShapeMesh Mesh;
+	WidgetShapeGeometry::BuildStroke(Outline, FillOnLeft, Stroke, FWidgetShapeTrim(), AntiAlias, Tolerance, Mesh);
