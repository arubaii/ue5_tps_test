+	/**
+	 * One design setting blended from A toward B, Alpha of the way, into Out - which starts as a copy of A. Numbers glide, and
+	 * so does every number inside a struct, member by member: a brush's tint, size, margin and outline as well as a color or a
+	 * font's size. Not a Shape track's blend (WidgetShapeAnimation::LerpValue), which switches a whole brush - and anything else
+	 * with nothing in between - halfway: eased, halfway comes long before the next key, which read as a key firing early and a
+	 * look that never blended at all. Here what has nothing in between - a brush's image, a font face, a choice from a list,
+	 * an on/off - stays the key's being left until the next key is reached, so it changes exactly at that key's time.
+	 */
+	void LerpDesignValue(const FProperty* Property, const void* A, const void* B, void* Out, float Alpha)
+	{
+		if (const FFloatProperty* Float = CastField<FFloatProperty>(Property))
+		{
+			Float->SetPropertyValue(Out, FMath::Lerp(Float->GetPropertyValue(A), Float->GetPropertyValue(B), Alpha));
+		}
+		else if (const FDoubleProperty* Double = CastField<FDoubleProperty>(Property))
+		{
+			Double->SetPropertyValue(Out, FMath::Lerp(Double->GetPropertyValue(A), Double->GetPropertyValue(B), static_cast<double>(Alpha)));
+		}
+		else if (const FIntProperty* Int = CastField<FIntProperty>(Property))
+		{
+			const double Blended = FMath::Lerp(static_cast<double>(Int->GetPropertyValue(A)), static_cast<double>(Int->GetPropertyValue(B)), static_cast<double>(Alpha));
