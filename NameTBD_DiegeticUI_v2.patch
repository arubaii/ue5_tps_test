+void UDiegeticScreenComponent::SetScreenShown(bool bShown)
+{
+	if (bShownByUser == bShown)
+	{
+		return;
+	}
+	bShownByUser = bShown;
+	if (!bShown)
+	{
+		EndUse();
+		// Shown again later, it starts where the view is then rather than easing in from where it was.
+		bHasPlacement = false;
+	}
+	bContentChanged = true;
+}
