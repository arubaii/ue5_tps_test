+bool SWidgetAnimTimeline::BeginRangeDrag(bool bEnd)
+{
+	const TArray<FWidgetAnimLayer>* Layers = GetLayers();
+	if (!CanEdit() || IsDragging() || !Layers || Layers->Num() == 0)
