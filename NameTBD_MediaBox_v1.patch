+
+void UMediaBoxSubsystem::Initialize(FSubsystemCollectionBase& Collection)
+{
+	Super::Initialize(Collection);
+	Pool = NewObject<UMediaBoxPool>(this, TEXT("MediaBoxPool"), RF_Transient);
+	Pool->Startup();
+}
+
+void UMediaBoxSubsystem::Deinitialize()
+{
+	if (Pool)
+	{
+		Pool->Shutdown();
+		Pool = nullptr;
+	}
+	Super::Deinitialize();
+}
