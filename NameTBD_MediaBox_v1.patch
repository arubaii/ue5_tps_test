+	float MachineProgress = -1.f;
+};
diff --git a/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxClip.h b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxClip.h
new file mode 100644
index 0000000..4968040
