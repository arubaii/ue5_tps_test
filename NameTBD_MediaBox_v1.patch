+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Kismet/BlueprintFunctionLibrary.h"
+
+#include "MediaBoxLibrary.generated.h"
+
+class UMediaBoxClip;
+class UWidget;
+
+/**
+ * The Media Box warm pool from Blueprint: Warm Groups for buttons that change what a shared Media Box plays, clips kept warm by
+ * hand, the subtitles option, and the pool's numbers. See MediaBoxTypes.h.
+ */
+UCLASS(meta = (DisplayName = "Media Box Library"))
+class NAMETBDMEDIA_API UMediaBoxLibrary : public UBlueprintFunctionLibrary
+{
+	GENERATED_BODY()
+
+public:
+
+	/**
+	 * Puts Widget (a skill button) in Warm Group with the clip it plays when hovered or focused - for a screen whose buttons all
+	 * play into one shared Media Box (Set Clip from On Hovered). The pool keeps the clips of the one focused and those nearest it
+	 * (or nearest where the pointer is heading) warm. Media Boxes that play on their own hover join their Warm Group by themselves.
+	 * Widget leaves the group when it is destroyed.
+	 */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (DefaultToSelf = "Widget", Keywords = "video preload prewarm"))
+	static void AddToMediaWarmGroup(UWidget* Widget, FName Group, UMediaBoxClip* Clip);
+
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (DefaultToSelf = "Widget"))
+	static void RemoveFromMediaWarmGroup(UWidget* Widget, FName Group);
+
+	/** Empties Group - a screen closing. */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (WorldContext = "WorldContextObject"))
+	static void ClearMediaWarmGroup(UObject* WorldContextObject, FName Group);
+
+	/** Tells Group that Widget is hovered or focused now, so its clip and its neighbours' are warmed first. Media Boxes do this themselves. */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (DefaultToSelf = "Widget"))
+	static void SetMediaWarmGroupFocus(UWidget* Widget, FName Group);
+
+	/**
+	 * Keeps Clip warm whatever the Warm Groups say (bKeepWarm), or stops doing so - the clip a menu plays as it opens, warmed
+	 * during the loading screen. Counted: call it as many times off as on.
+	 */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (WorldContext = "WorldContextObject", Keywords = "video preload prewarm"))
+	static void KeepMediaClipWarm(UObject* WorldContextObject, UMediaBoxClip* Clip, bool bKeepWarm = true);
+
+	/** Turns the subtitles every Media Box (with Show Subtitles) draws on or off - the game's subtitles option. Starts at Project Settings > Media Box. */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Subtitles")
+	static void SetMediaBoxSubtitlesEnabled(bool bEnabled);
+
+	UFUNCTION(BlueprintPure, Category = "Media Box|Subtitles")
+	static bool AreMediaBoxSubtitlesEnabled();
+
+	/**
+	 * The warm pool's numbers: players warm (ready to play at once) and playing now, and how many starts were warm (instant)
+	 * or cold (waited for the video) since the game started. Cold starts that keep climbing: raise Max Warm Players, or put the
+	 * screen's previews in one Warm Group.
+	 */
+	UFUNCTION(BlueprintCallable, Category = "Media Box|Warm", meta = (WorldContext = "WorldContextObject"))
+	static void GetMediaBoxPoolStats(UObject* WorldContextObject, int32& WarmPlayers, int32& PlayingPlayers, int32& WarmStarts, int32& ColdStarts);
+};
diff --git a/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxPool.h b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxPool.h
new file mode 100644
index 0000000..25e2647
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxPool.h
@@ -0,0 +1,341 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Containers/Ticker.h"
+#include "Subsystems/GameInstanceSubsystem.h"
+#include "UObject/Object.h"
+
+#include "MediaBoxPool.generated.h"
+
+class UAudioComponent;
+class UMediaBox;
+class UMediaBoxClip;
+class UMediaPlayer;
+class UMediaSoundComponent;
+class UMediaTexture;
+class UWidget;
+class UWorld;
+
+/** Where a pooled player is. Not reflected: the pool's own bookkeeping. */
+enum class EMediaBoxPlayerState : uint8
+{
+	/** Nothing open. */
+	Free,
+	/** OpenSource called, waiting for the player to open it. */
+	Opening,
+	/** Open, playing silently until the first frame is in the texture. */
+	Priming,
+	/** Paused, sought back to the clip's start, waiting for the seek to land. */
+	Settling,
+	/** Paused on the clip's first frame, ready to play at once - "warm". */
+	Ready,
+	Playing,
+	Paused,
+	/** Played to the end (no loop). */
+	Ended,
+	/** Couldn't open or play the clip. */
+	Failed
+};
+
+/**
+ * One pooled player: a Media Player, the Media Texture it draws into and the audio that goes with it, opened on one clip at a
+ * time. Made per pool, never shared assets - two Media Boxes never fight over one player. A Media Box leases one while it plays;
+ * the rest are kept warm by the pool. See MediaBoxTypes.h.
+ */
+UCLASS(Transient)
+class NAMETBDMEDIA_API UMediaBoxPlayer : public UObject
+{
+	GENERATED_BODY()
+
+public:
+
+	/** Makes the Media Player and Media Texture. Called once, by the pool. */
+	void Initialize();
+
+	/** Opens NewClip, warming it: open, first frame, back to its start, paused. False when it couldn't even start opening. */
+	bool Open(UMediaBoxClip* NewClip);
+
+	/** Closes what is open and lets go of its audio. */
+	void Close();
+
+	/** Plays from where it is: at once when warm, else as soon as its first frame is in. AudioWorld plays its audio. */
+	void Play(UWorld* AudioWorld, bool bWithAudio);
+
+	/** Pauses (audio fades out over FadeOut seconds). */
+	void Pause(float FadeOut);
+
+	/** Back to the start, paused, warm again for the next Play (audio fades out over FadeOut seconds). */
+	void Rewind(float FadeOut);
+
+	void Seek(float Seconds);
+	void SetRate(float NewRate);
+
+	/** Fades the audio out over FadeOut seconds (then stops it), the video playing on - a Media Box fading back to its poster. */
+	void FadeOutAudio(float FadeOut) { StopAudio(FadeOut); }
+
+	/** The volume the audio plays at (the Media Box's, muted or not, times the clip's). */
+	void SetVolume(float NewVolume);
+
+	/** Advances opening, priming, loops, audio fades and audio sync. Called by the pool every frame. */
+	void Tick(float DeltaTime);
+
+	EMediaBoxPlayerState GetState() const { return State; }
+	UMediaBoxClip* GetClip() const { return Clip; }
+	UMediaPlayer* GetMediaPlayer() const { return MediaPlayer; }
+	UMediaTexture* GetMediaTexture() const { return MediaTexture; }
+
+	bool IsFree() const { return State == EMediaBoxPlayerState::Free; }
+	bool IsReady() const { return State == EMediaBoxPlayerState::Ready; }
+	bool HasFailed() const { return State == EMediaBoxPlayerState::Failed; }
+	bool IsPlaying() const { return State == EMediaBoxPlayerState::Playing; }
+
+	/** Whether the texture holds a frame of this clip - the video can be shown over the poster. */
+	bool IsFrameReady() const { return bFrameReady; }
+
+	/** Whether it has been opened (On Opened). */
+	bool IsOpened() const { return State != EMediaBoxPlayerState::Free && State != EMediaBoxPlayerState::Opening && State != EMediaBoxPlayerState::Failed; }
+
+	/** Seconds into the video. */
+	float GetTime() const;
+
+	/** The video's length in seconds; 0 until opened (or for a live stream). */
+	float GetDuration() const;
+
+	/** Why it failed, when it has. */
+	const FString& GetError() const { return Error; }
+
+	/** Counted for the lease: loops done, ends reached. */
+	int32 GetLoopCount() const { return LoopCount; }
+	int32 GetEndCount() const { return EndCount; }
+
+	/** The Media Box using it, if any. */
+	UObject* GetLeaseOwner() const { return LeaseOwner.Get(); }
+	bool IsLeased() const { return LeaseOwner.IsValid(); }
+
+	/** When it was last leased or last asked to be warm - the pool closes the longest unwanted first. */
+	double LastWantedTime = 0.0;
+
+private:
+
+	friend class UMediaBoxPool;
+
+	UFUNCTION()
+	void HandleMediaOpened(FString OpenedUrl);
+
+	UFUNCTION()
+	void HandleMediaOpenFailed(FString FailedUrl);
+
+	UFUNCTION()
+	void HandleEndReached();
+
+	UFUNCTION()
+	void HandleSeekCompleted();
+
+	void Fail(const FString& Reason);
+
+	/** Plays from the state it is in now (Ready, Paused, Ended, or straight out of priming). */
+	void StartPlaying();
+
+	/** Starts the clip's audio at the video's time (Separate Sound) or the Media Sound Component (Embedded). */
+	void StartAudio();
+	void StopAudio(float FadeOut);
+	void ApplyAudioVolume();
+	bool WantsSeparateSound() const;
+	bool WantsEmbeddedSound() const;
+
+	/** The audio components, made (again) in AudioWorld when they don't exist there yet. */
+	void EnsureAudio(UWorld* InAudioWorld);
+	void DestroyAudio();
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaPlayer> MediaPlayer = nullptr;
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaTexture> MediaTexture = nullptr;
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaSoundComponent> EmbeddedSound = nullptr;
+
+	UPROPERTY(Transient)
+	TObjectPtr<UAudioComponent> SeparateSound = nullptr;
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaBoxClip> Clip = nullptr;
+
+	TWeakObjectPtr<UObject> LeaseOwner;
+	TWeakObjectPtr<UWorld> AudioWorld;
+
+	/** Leased and not yet given back - a lease whose owner has gone (garbage collected) is taken back by the pool. */
+	bool bHasLease = false;
+
+	EMediaBoxPlayerState State = EMediaBoxPlayerState::Free;
+	FString Error;
+
+	bool bFrameReady = false;
+	bool bPlayRequested = false;
+	bool bAudioWanted = true;
+
+	/** Frames spent priming / settling - each step gives up waiting after a while rather than hang. */
+	int32 StepFrames = 0;
+	float PrimeFrom = 0.f;
+
+	/** The video time last frame - a native loop wrapping round shows as time going back. */
+	float LastTime = 0.f;
+
+	int32 LoopCount = 0;
+	int32 EndCount = 0;
+
+	float Rate = 1.f;
+	float Volume = 1.f;
+
+	/** The audio fade: 1 full, falling to 0 over AudioFadeDuration, then the audio stops. */
+	float AudioFade = 1.f;
+	float AudioFadeDuration = 0.f;
+	bool bAudioFadingOut = false;
+	bool bAudioPlaying = false;
+
+	/** Separate Sound clock: the video time it was started at, and when (platform seconds). For keeping it in step. */
+	float AudioStartMediaTime = 0.f;
+	double AudioStartWallTime = 0.0;
+	double NextSyncCheck = 0.0;
+};
+
+/** One widget in a Warm Group and the clip it plays (or shows) when hovered or focused. */
+USTRUCT()
+struct NAMETBDMEDIA_API FMediaBoxWarmTarget
+{
+	GENERATED_BODY()
+
+	TWeakObjectPtr<UWidget> Widget;
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaBoxClip> Clip = nullptr;
+};
+
+/** The clips of one screen - a skill tree - from which the pool keeps the likeliest next hovers warm. */
+USTRUCT()
+struct NAMETBDMEDIA_API FMediaBoxWarmGroup
+{
+	GENERATED_BODY()
+
+	UPROPERTY(Transient)
+	TArray<FMediaBoxWarmTarget> Targets;
+
+	/** The target last focused or hovered (Set Warm Group Focus, or a Media Box of the group starting) and when. */
+	TWeakObjectPtr<UWidget> Focus;
+	double FocusTime = 0.0;
+};
+
+/**
+ * The warm pool: every pooled player of one game instance (or of the editor, for the designer), the Warm Groups and pinned
+ * clips that say which clips should be warm, and the Media Boxes, which it ticks. Each frame it ranks what is wanted - pinned
+ * clips, then each group's focused target and those nearest it (or nearest where the pointer is heading) - and keeps the top
+ * Max Warm Players of them open and paused on their first frame; a Media Box asking for one of those plays it at once.
+ */
+UCLASS(Transient)
+class NAMETBDMEDIA_API UMediaBoxPool : public UObject
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The pool for WorldContext's game instance; the editor's own for a world without one (the designer, editor worlds). */
+	static UMediaBoxPool* Get(const UObject* WorldContext);
+
+	/** The editor's pool, if made - for module shutdown. */
+	static void ShutdownEditorPool();
+
+	void Startup();
+	void Shutdown();
+
+	virtual void BeginDestroy() override;
+
+	/**
+	 * A player for NewClip, leased to Owner until Release: the warm one when there is one (it plays at once), else one opened
+	 * now. Never null for a clip with a Media Source.
+	 */
+	UMediaBoxPlayer* Acquire(UMediaBoxClip* NewClip, UObject* Owner);
+
+	/** Gives a leased player back. bRewind puts it back on its first frame, warm for the next hover. */
+	void Release(UMediaBoxPlayer* PooledPlayer, bool bRewind, float AudioFadeOut);
+
+	void RegisterBox(UMediaBox* Box);
+	void UnregisterBox(UMediaBox* Box);
+
+	// Warm Groups -------------------------------------------------------------------------------
+
+	void AddToGroup(FName Group, UWidget* Widget, UMediaBoxClip* TargetClip);
+	void RemoveFromGroup(FName Group, UWidget* Widget);
+	void ClearGroup(FName Group);
+	void SetGroupFocus(FName Group, UWidget* Widget);
+
+	/** Focuses the group's target that plays FocusClip (the first one) - a shared Media Box told to play it. */
+	void SetGroupFocusByClip(FName Group, UMediaBoxClip* FocusClip);
+
+	/** Keeps TargetClip warm whatever the groups say (bKeepWarm), or stops doing so. Counted: as many offs as ons. */
+	void PinClip(UMediaBoxClip* TargetClip, bool bKeepWarm);
+
+	// Stats -------------------------------------------------------------------------------------
+
+	int32 GetNumWarm() const;
+	int32 GetNumLeased() const;
+	int32 WarmStarts = 0;
+	int32 ColdStarts = 0;
+
+private:
+
+	bool Tick(float DeltaTime);
+
+	/** Which clips should be warm, likeliest first (at most the pool's capacity). */
+	void RankWanted(TArray<UMediaBoxClip*>& OutClips);
+
+	/** Opens what RankWanted asks for, closing what nobody wants once over capacity. */
+	void Rebalance();
+
+	/** An unleased player to open a clip on: a free one, else the longest unwanted one not in Keep, else a new one (bAllowNew). */
+	UMediaBoxPlayer* FindPlayerToReuse(TConstArrayView<UMediaBoxClip*> Keep, bool bAllowNew);
+
+	UMediaBoxPlayer* MakePlayer();
+
+	void UpdatePointer(float DeltaTime);
+
+	UPROPERTY(Transient)
+	TArray<TObjectPtr<UMediaBoxPlayer>> Players;
+
+	UPROPERTY(Transient)
+	TMap<FName, FMediaBoxWarmGroup> Groups;
+
+	UPROPERTY(Transient)
+	TMap<TObjectPtr<UMediaBoxClip>, int32> Pinned;
+
+	TArray<TWeakObjectPtr<UMediaBox>> Boxes;
+
+	FTSTicker::FDelegateHandle TickHandle;
+
+	/** The pointer, in desktop space, its smoothed speed, and when it last moved - for guessing the next hover. */
+	FVector2f PointerPosition = FVector2f::ZeroVector;
+	FVector2f PointerVelocity = FVector2f::ZeroVector;
+	bool bHasPointer = false;
+	double PointerMoveTime = 0.0;
+};
+
+/** Holds the warm pool of a game instance, so warm players outlive level changes. */
+UCLASS()
+class NAMETBDMEDIA_API UMediaBoxSubsystem : public UGameInstanceSubsystem
+{
+	GENERATED_BODY()
+
+public:
+
+	virtual void Initialize(FSubsystemCollectionBase& Collection) override;
+	virtual void Deinitialize() override;
+
+	UMediaBoxPool* GetPool() const { return Pool; }
+
+private:
+
+	UPROPERTY(Transient)
+	TObjectPtr<UMediaBoxPool> Pool = nullptr;
+};
diff --git a/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxSettings.h b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxSettings.h
new file mode 100644
index 0000000..79be300
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxSettings.h
@@ -0,0 +1,113 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Engine/DeveloperSettings.h"
+
+#include "MediaBoxSettings.generated.h"
+
+class USoundClass;
+
+/**
+ * Project Settings > Plugins > Media Box: what every Media Box in the project shares - how many players are kept warm, the
+ * fades, how audio follows the video, and how the next hover is guessed. See MediaBoxTypes.h.
+ */
+UCLASS(Config = Game, DefaultConfig, meta = (DisplayName = "Media Box"))
+class NAMETBDMEDIA_API UMediaBoxSettings : public UDeveloperSettings
+{
+	GENERATED_BODY()
+
+public:
+
+	static const UMediaBoxSettings& Get() { return *GetDefault<UMediaBoxSettings>(); }
+
+	virtual FName GetCategoryName() const override { return TEXT("Plugins"); }
+
+#if WITH_EDITOR
+	virtual FText GetSectionText() const override;
+#endif
+
+	/** Max Warm Players, or the MediaBox.MaxWarmPlayers console value when that is 0 or more. */
+	int32 GetMaxWarmPlayers() const;
+
+	// -------------------------------------------------------------------------------------------------
+	// Warm Pool
+	// -------------------------------------------------------------------------------------------------
+
+	/**
+	 * How many players are kept open and paused on a clip's first frame, ready to play at once - besides those playing. Each
+	 * holds a decoder and a frame of video in memory: 4 covers the clip hovered, the one fading out and the two most likely
+	 * next. Consoles and phones may allow fewer hardware decoders at once; lower it there (per platform config). 0: no warm
+	 * players, every clip starts cold (the poster still shows at once).
+	 */
+	UPROPERTY(Config, EditAnywhere, Category = "Warm Pool", meta = (DisplayName = "Max Warm Players", ClampMin = "0", UIMax = "16"))
+	int32 MaxWarmPlayers = 4;
+
+	/**
+	 * Of each Warm Group, how many clips are kept warm: the focused (or hovered) one and those nearest it on screen - or nearest
+	 * where the pointer is heading. The pool's Max Warm Players still caps them all.
+	 */
+	UPROPERTY(Config, EditAnywhere, Category = "Warm Pool", meta = (DisplayName = "Warm Per Group", ClampMin = "1", UIMax = "16"))
+	int32 WarmPerGroup = 3;
+
+	/**
+	 * Guesses the next hover from where the pointer is heading (its speed, Hover Intent Look Ahead seconds ahead) and warms what
+	 * is there before it arrives. Off: from where the pointer is.
+	 */
+	UPROPERTY(Config, EditAnywhere, Category = "Warm Pool", meta = (DisplayName = "Hover Intent"))
+	bool bHoverIntent = true;
+
+	UPROPERTY(Config, EditAnywhere, Category = "Warm Pool", meta = (DisplayName = "Hover Intent Look Ahead", EditCondition = "bHoverIntent", ClampMin = "0.0", UIMax = "0.5", Units = "s"))
+	float HoverIntentLookAhead = 0.15f;
+
+	/**
+	 * The media player plugin every Media Box asks for by name - ElectraPlayer, WmfMedia, BinkMedia, ImgMedia... None: the
+	 * engine picks per file and platform. A clip's own Player Name wins.
+	 */
+	UPROPERTY(Config, EditAnywhere, Category = "Warm Pool", meta = (DisplayName = "Player Name"))
+	FName PlayerName;
+
+	// -------------------------------------------------------------------------------------------------
+	// Fades
+	// -------------------------------------------------------------------------------------------------
+
+	/** How long the video takes to fade in over the poster once its first frame is in - hides the cut. 0: a cut. */
+	UPROPERTY(Config, EditAnywhere, Category = "Fades", meta = (DisplayName = "Video Fade In", ClampMin = "0.0", UIMax = "1.0", Units = "s"))
+	float VideoFadeIn = 0.08f;
+
+	/** How long the video takes to fade back to the poster as it stops (Stop And Rewind). 0: a cut. */
+	UPROPERTY(Config, EditAnywhere, Category = "Fades", meta = (DisplayName = "Video Fade Out", ClampMin = "0.0", UIMax = "1.0", Units = "s"))
+	float VideoFadeOut = 0.12f;
+
+	/** How long the audio takes to fade out as the video stops or pauses, rather than being cut. */
+	UPROPERTY(Config, EditAnywhere, Category = "Fades", meta = (DisplayName = "Audio Fade Out", ClampMin = "0.0", UIMax = "1.0", Units = "s"))
+	float AudioFadeOut = 0.15f;
+
+	// -------------------------------------------------------------------------------------------------
+	// Audio
+	// -------------------------------------------------------------------------------------------------
+
+	/** The Sound Class every Media Box's audio plays in - the UI or voice class, for the game's volume sliders. None: the sound's own. */
+	UPROPERTY(Config, EditAnywhere, Category = "Audio", meta = (DisplayName = "Sound Class"))
+	TSoftObjectPtr<USoundClass> SoundClass;
+
+	/**
+	 * A Separate Sound drifting further than this from the video is put back in step (started again at the video's time). Short
+	 * previews never drift that far.
+	 */
+	UPROPERTY(Config, EditAnywhere, Category = "Audio", meta = (DisplayName = "Audio Resync Threshold", ClampMin = "0.01", UIMax = "0.5", Units = "s"))
+	float AudioResyncThreshold = 0.08f;
+
+	/** Plays the audio in the Widget Blueprint designer too, where a Media Box has Preview In Designer on. Off: designer previews are silent. */
+	UPROPERTY(Config, EditAnywhere, Category = "Audio", meta = (DisplayName = "Audio In Designer"))
+	bool bAudioInDesigner = false;
+
+	// -------------------------------------------------------------------------------------------------
+	// Subtitles
+	// -------------------------------------------------------------------------------------------------
+
+	/** Whether Media Boxes draw their clips' subtitles - the game's subtitles option. Set at runtime with Set Media Box Subtitles Enabled. */
+	UPROPERTY(Config, EditAnywhere, Category = "Subtitles", meta = (DisplayName = "Subtitles Enabled"))
+	bool bSubtitlesEnabled = true;
+};
diff --git a/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTransportBar.h b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTransportBar.h
new file mode 100644
index 0000000..9335161
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTransportBar.h
@@ -0,0 +1,125 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Blueprint/UserWidget.h"
+
+#include "MediaBoxTransportBar.generated.h"
+
+class UButton;
+class UMediaBox;
+class USlider;
+class UTextBlock;
+
+/**
+ * Media Box Transport Bar: the controls under a video - play / pause, stop, a scrub bar, the time, volume, mute, subtitles -
+ * as a Widget Blueprint you lay out yourself. Make a Widget Blueprint with this as its parent class and add any of the named
+ * parts (each optional): PlayPauseButton, StopButton, ScrubBar (Slider), TimeText, VolumeSlider, MuteButton, SubtitlesButton,
+ * SubtitleText. Each part is wired up by its name; style them as any Button, Slider or Text (Context Menu Buttons work, being
+ * Buttons). On Playing Changed / On Muted Changed swap icons.
+ *
+ * Drives the Media Box named Media Box in the Widget Blueprint it is in (or any around it); None: the first one found around
+ * it. Or Set Media Box.
+ */
+UCLASS(Abstract, meta = (DisplayName = "Media Box Transport Bar"))
+class NAMETBDMEDIA_API UMediaBoxTransportBar : public UUserWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The Media Box it drives, by name around it. None: the first found around it. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Media Box", meta = (DisplayName = "Media Box"))
+	FName MediaBoxName;
+
+	/** How the time reads: false "0:05 / 0:12", true "0:05". */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Media Box", meta = (DisplayName = "Elapsed Time Only"))
+	bool bElapsedTimeOnly = false;
+
+	UFUNCTION(BlueprintCallable, Category = "Media Box")
+	void SetMediaBox(UMediaBox* NewMediaBox);
+
+	UFUNCTION(BlueprintPure, Category = "Media Box")
+	UMediaBox* GetMediaBox() const { return DrivenBox.Get(); }
+
+	/** The video started or stopped playing - swap the play / pause icon here. */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Media Box")
+	void OnPlayingChanged(bool bPlaying);
+
+	/** The Media Box was muted or unmuted - swap the speaker icon here. */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Media Box")
+	void OnMutedChanged(bool bIsMuted);
+
+protected:
+
+	virtual void NativeConstruct() override;
+	virtual void NativeDestruct() override;
+	virtual void NativeTick(const FGeometry& MyGeometry, float InDeltaTime) override;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UButton> PlayPauseButton = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UButton> StopButton = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<USlider> ScrubBar = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> TimeText = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<USlider> VolumeSlider = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UButton> MuteButton = nullptr;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UButton> SubtitlesButton = nullptr;
+
+	/** Shows the current subtitle line here, for subtitles drawn outside the video. */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> SubtitleText = nullptr;
+
+private:
+
+	UFUNCTION()
+	void HandlePlayPauseClicked();
+
+	UFUNCTION()
+	void HandleStopClicked();
+
+	UFUNCTION()
+	void HandleMuteClicked();
+
+	UFUNCTION()
+	void HandleSubtitlesClicked();
+
+	UFUNCTION()
+	void HandleScrubBegin();
+
+	UFUNCTION()
+	void HandleScrubEnd();
+
+	UFUNCTION()
+	void HandleScrubChanged(float NewValue);
+
+	UFUNCTION()
+	void HandleVolumeChanged(float NewValue);
+
+	UMediaBox* FindDrivenBox();
+
+	static FText FormatTime(float Seconds);
+
+	TWeakObjectPtr<UMediaBox> DrivenBox;
+	bool bBoxSetByHand = false;
+	bool bScrubbing = false;
+	bool bResumeAfterScrub = false;
+	bool bWasPlaying = false;
+	bool bWasMuted = false;
+	bool bReportedOnce = false;
+	FText LastSubtitle;
+	int32 LastShownSeconds = -1;
+	int32 LastShownDuration = -1;
+};
diff --git a/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTypes.h b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTypes.h
new file mode 100644
index 0000000..13cd7e1
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDMedia/Public/MediaBoxTypes.h
@@ -0,0 +1,121 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+#include "MediaBoxTypes.generated.h"
+
+// =====================================================================================================
+// Media Box
+// =====================================================================================================
+//
+// Video in UI that starts the moment it is asked to: a skill hovered in a skill tree plays its preview clip, with audio, on
+// that same frame - the way Horizon Zero Dawn's skill tree does.
+//
+// Nothing slow happens at the hover. The slow steps - opening the file, starting the decoder, decoding the first frame,
+// loading the sound - happen beforehand, in the warm pool (UMediaBoxPool): a few players kept open and paused on each
+// clip's first frame, chosen by what the player is likely to hover next (Warm Groups). The hover only calls Play on one of
+// those, behind the clip's poster (a still of its first frame), which shows at once whatever happens. See
+// Docs/Design/MediaBox.md.
+
+/** How the video (and its poster) is laid in the Media Box. */
+UENUM(BlueprintType)
+enum class EMediaBoxFit : uint8
+{
+	Contain UMETA(ToolTip = "All of the video shows, as big as fits, its shape kept. The Media Box's Letterbox Color fills the rest."),
+
+	Cover UMETA(ToolTip = "The video fills the whole Media Box, its shape kept; what overflows is cropped (Crop Focus says which part stays)."),
+
+	Stretch UMETA(ToolTip = "The video is stretched to the Media Box's shape.")
+};
+
+/**
+ * When a Media Box plays on its own. Whatever is picked, Play, Pause and Stop work too. A trigger that ends (unhovered, hidden)
+ * does what After Trigger says.
+ */
+UENUM(BlueprintType)
+enum class EMediaBoxTrigger : uint8
+{
+	Manual UMETA(ToolTip = "Only when told to: Play, Set Clip with Play, a Media cue."),
+
+	Visible UMETA(ToolTip = "While the Media Box is shown - a preview in an Info Card plays as the card opens."),
+
+	Hovered UMETA(ToolTip = "While its Hover Target (by default the button it is in, else itself) is hovered."),
+
+	Focused UMETA(ToolTip = "While its Hover Target has keyboard / gamepad focus, or something inside it has."),
+
+	HoveredOrFocused UMETA(DisplayName = "Hovered Or Focused", ToolTip = "While its Hover Target is hovered or focused - mouse and gamepad alike. What a skill tree wants.")
+};
+
+/** What a Media Box does when what started it ends: unhovered, unfocused, hidden. */
+UENUM(BlueprintType)
+enum class EMediaBoxAfterTrigger : uint8
+{
+	StopAndRewind UMETA(DisplayName = "Stop And Rewind", ToolTip = "Fades back to the poster and goes back to the start: the next hover plays it from the beginning, at once (its player stays warm)."),
+
+	Pause UMETA(ToolTip = "Pauses where it is; the next time it plays, it carries on from there."),
+
+	KeepPlaying UMETA(DisplayName = "Keep Playing", ToolTip = "Plays on until it ends (or Stop).")
+};
+
+/** Where a clip's audio comes from. */
+UENUM(BlueprintType)
+enum class EMediaBoxAudio : uint8
+{
+	Auto UMETA(ToolTip = "Separate Sound when the clip has a Sound, else the video file's own audio."),
+
+	Embedded UMETA(ToolTip = "The video file's own audio track, played through a Media Sound Component (2D, UI sound)."),
+
+	SeparateSound UMETA(DisplayName = "Separate Sound", ToolTip = "The clip's Sound, played in step with the video. Starts with no wait at all (it is loaded and primed with the clip), so it is the one recommended for previews."),
+
+	Silent UMETA(ToolTip = "No audio.")
+};
+
+/** Where a Media Box is, for Blueprint. */
+UENUM(BlueprintType)
+enum class EMediaBoxStatus : uint8
+{
+	Empty UMETA(ToolTip = "No clip."),
+
+	Loading UMETA(ToolTip = "Asked to play, waiting for its player (opening, or its first frame)."),
+
+	Playing,
+
+	Paused,
+
+	Stopped UMETA(ToolTip = "At rest: the poster shows."),
+
+	Ended UMETA(ToolTip = "Played to its end (and doesn't loop)."),
+
+	Error UMETA(ToolTip = "Its video couldn't be opened or played - see On Error.")
+};
+
+/** One subtitle line of a clip: shown from Start to End (seconds into the video). */
+USTRUCT(BlueprintType)
+struct NAMETBDMEDIA_API FMediaBoxSubtitleCue
+{
+	GENERATED_BODY()
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Subtitles", meta = (Units = "s"))
+	float Start = 0.f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Subtitles", meta = (Units = "s"))
+	float End = 0.f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Subtitles", meta = (MultiLine = true))
+	FText Text;
+};
+
+namespace MediaBoxSubtitles
+{
+	/**
+	 * Reads SubRip (.srt) or WebVTT (.vtt) text into cues, sorted by start: "00:00:01,500 --> 00:00:03,000" timings (a dot for
+	 * the comma too, hours optional), the lines under each up to a blank line. Cue numbers, a WEBVTT header, NOTE / STYLE blocks
+	 * and cue settings after the end time are skipped; <i>-style tags are taken out. Malformed blocks are skipped.
+	 */
+	NAMETBDMEDIA_API void Parse(const FString& Source, TArray<FMediaBoxSubtitleCue>& OutCues);
+
+	/** The cue shown at Seconds, or INDEX_NONE. Cues are sorted by start; overlapping ones: the last that started. */
+	NAMETBDMEDIA_API int32 FindCue(TConstArrayView<FMediaBoxSubtitleCue> Cues, float Seconds);
+}
