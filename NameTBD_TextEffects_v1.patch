+			{
+				Key = HashCombine(Key, HashCombine(GetTypeHash(Name.ToString().ToLower()), GetTypeHash(Tag.GlowVectorParameters.FindChecked(Name))));
+			}
+			Span.EffectKey = Key != 0 ? Key : 1u;
+		}
