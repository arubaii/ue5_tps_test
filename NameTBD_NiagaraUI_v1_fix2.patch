+bool UNiagaraUIWidget::IsParameterChanged(const FPropertyBagPropertyDesc& Desc) const
+{
+	const FPropertyBagPropertyDesc* SystemDesc = UserParameterDefaults.FindPropertyDescByName(Desc.Name);
+	if (!SystemDesc || !NiagaraUIParameters::IsSameType(Desc, *SystemDesc) || !Desc.CachedProperty)
+	{
+		return true;
+	}
+	const void* Value = NiagaraUIParameters::GetValuePtr(UserParameters, Desc);
+	const void* SystemValue = NiagaraUIParameters::GetValuePtr(UserParameterDefaults, *SystemDesc);
+	return !Value || !SystemValue || !Desc.CachedProperty->Identical(Value, SystemValue);
+}
+
+void UNiagaraUIWidget::RefreshUserParameters()
+{
+	LayOutUserParameters();
+}
+
+bool UNiagaraUIWidget::LayOutUserParameters()
+{
+	using namespace NiagaraUIParameters;
+
+	// The system's User parameters as they are now, and its values of them.
+	TArray<FPropertyBagPropertyDesc> Descs;
+	TArray<FNiagaraVariable> Variables;
+	TArray<FName> Positions;
+	if (NiagaraSystem)
+	{
+		TArray<FNiagaraVariable> UserVariables;
+		NiagaraSystem->GetExposedParameters().GetUserParameters(UserVariables);
+		for (const FNiagaraVariable& Variable : UserVariables)
+		{
+			FPropertyBagPropertyDesc Desc;
+			bool bPosition = false;
+			if (!MakeDesc(Variable, Desc, bPosition) || Descs.ContainsByPredicate([&Desc](const FPropertyBagPropertyDesc& Other) { return Other.Name == Desc.Name; }))
+			{
+				continue;
+			}
+			Descs.Add(Desc);
+			Variables.Add(Variable);
+			if (bPosition)
+			{
+				Positions.Add(Desc.Name);
+			}
+		}
+	}
+
+	FInstancedPropertyBag SystemValues;
+	if (Descs.Num() > 0)
+	{
+		SystemValues.AddProperties(Descs);
+		for (const FNiagaraVariable& Variable : Variables)
+		{
+			ReadSystemValue(NiagaraSystem->GetExposedParameters(), Variable, SystemValues);
+		}
+	}
+
+	// Nothing new in the system since it was last laid out: nothing to do (the designer asks often).
+	if (AreIdentical(SystemValues, UserParameterDefaults) && HaveSameLayout(SystemValues, UserParameters) && PositionParameters == Positions)
+	{
+		return false;
+	}
+
+	// Each at the system's value - but one this widget had changed keeps its own, as long as it is still there, of the same type.
+	FInstancedPropertyBag NewValues = SystemValues;
+	if (const UPropertyBag* NewStruct = NewValues.GetPropertyBagStruct())
+	{
+		for (const FPropertyBagPropertyDesc& NewDesc : NewStruct->GetPropertyDescs())
+		{
+			const FPropertyBagPropertyDesc* OldDesc = UserParameters.FindPropertyDescByName(NewDesc.Name);
+			if (!OldDesc || !IsSameType(*OldDesc, NewDesc) || !OldDesc->CachedProperty || !NewDesc.CachedProperty || !IsParameterChanged(*OldDesc))
+			{
+				continue;
+			}
+			const void* OldValue = GetValuePtr(UserParameters, *OldDesc);
+			uint8* NewMemory = NewValues.GetMutableValue().GetMemory();
+			if (OldValue && NewMemory)
+			{
+				NewDesc.CachedProperty->CopyCompleteValue(NewDesc.CachedProperty->ContainerPtrToValuePtr<void>(NewMemory), OldValue);
+			}
+		}
+	}
+
+	const bool bLayoutChanged = !HaveSameLayout(NewValues, UserParameters);
+	UserParameters = MoveTemp(NewValues);
+	UserParameterDefaults = MoveTemp(SystemValues);
+	PositionParameters = MoveTemp(Positions);
+	return bLayoutChanged;
+}
+
+void UNiagaraUIWidget::MigrateLegacyParameters()
 {
 	for (const TPair<FName, float>& Pair : FloatParameters)
 	{
-		SimComponent->SetVariableFloat(Pair.Key, Pair.Value);
+		UserParameters.SetValueFloat(NiagaraUIParameters::GetShortName(Pair.Key), Pair.Value);
 	}
 	for (const TPair<FName, FLinearColor>& Pair : ColorParameters)
 	{
-		SimComponent->SetVariableLinearColor(Pair.Key, Pair.Value);
+		UserParameters.SetValueStruct(NiagaraUIParameters::GetShortName(Pair.Key), FConstStructView::Make(Pair.Value));
 	}
 	for (const TPair<FName, FVector>& Pair : VectorParameters)
 	{
-		SimComponent->SetVariableVec3(Pair.Key, Pair.Value);
+		UserParameters.SetValueStruct(NiagaraUIParameters::GetShortName(Pair.Key), FConstStructView::Make(Pair.Value));
 	}
+	FloatParameters.Empty();
+	ColorParameters.Empty();
+	VectorParameters.Empty();
 }
 
