+	{
+		if (FPropertyEditorModule* PropertyEditor = FModuleManager::GetModulePtr<FPropertyEditorModule>("PropertyEditor"))
+		{
+			PropertyEditor->NotifyCustomizationModuleChanged();
+		}
+		return false;
+	}));
+}
