 void UNiagaraUIWidget::ApplyParameters(UNiagaraComponent* SimComponent) const
+{
+	// Only what this widget changed: the rest the system already has, at its own - current - values.
+	const UPropertyBag* BagStruct = UserParameters.GetPropertyBagStruct();
+	if (!BagStruct)
+	{
+		return;
+	}
+	for (const FPropertyBagPropertyDesc& Desc : BagStruct->GetPropertyDescs())
+	{
+		if (IsParameterChanged(Desc))
+		{
+			ApplyParameter(SimComponent, UserParameters, Desc);
+		}
+	}
+}
+
+void UNiagaraUIWidget::ApplyParameter(UNiagaraComponent* SimComponent, const FInstancedPropertyBag& Bag, const FPropertyBagPropertyDesc& Desc) const
+{
+	const FName Name = Desc.Name;
+	switch (Desc.ValueType)
+	{
+	case EPropertyBagPropertyType::Float:
+		if (const auto Value = Bag.GetValueFloat(Name); Value.HasValue())
+		{
+			SimComponent->SetVariableFloat(Name, Value.GetValue());
+		}
+		break;
+	case EPropertyBagPropertyType::Int32:
+		if (const auto Value = Bag.GetValueInt32(Name); Value.HasValue())
+		{
+			SimComponent->SetVariableInt(Name, Value.GetValue());
+		}
+		break;
+	case EPropertyBagPropertyType::Bool:
+		if (const auto Value = Bag.GetValueBool(Name); Value.HasValue())
+		{
+			SimComponent->SetVariableBool(Name, Value.GetValue());
+		}
+		break;
+	case EPropertyBagPropertyType::Enum:
+		if (const auto Value = Bag.GetValueEnum(Name, Cast<UEnum>(Desc.ValueTypeObject)); Value.HasValue())
+		{
+			SimComponent->SetVariableInt(Name, Value.GetValue());
+		}
+		break;
+	case EPropertyBagPropertyType::Object:
+		if (const auto Value = Bag.GetValueObject(Name); Value.HasValue())
+		{
+			NiagaraUIParameters::ApplyObject(SimComponent, Name, Value.GetValue());
+		}
+		break;
+	case EPropertyBagPropertyType::Struct:
+	{
+		const UScriptStruct* StructType = Cast<UScriptStruct>(Desc.ValueTypeObject);
+		const auto Value = Bag.GetValueStruct(Name, StructType);
+		if (!Value.HasValue() || !StructType)
+		{
+			break;
+		}
+		const FStructView View = Value.GetValue();
+		if (StructType == TBaseStructure<FLinearColor>::Get())
+		{
+			SimComponent->SetVariableLinearColor(Name, View.Get<FLinearColor>());
+		}
+		else if (StructType == TBaseStructure<FVector2D>::Get())
+		{
+			SimComponent->SetVariableVec2(Name, View.Get<FVector2D>());
+		}
+		else if (StructType == TBaseStructure<FVector>::Get())
+		{
+			if (PositionParameters.Contains(Name))
+			{
+				SimComponent->SetVariablePosition(Name, View.Get<FVector>());
+			}
+			else
+			{
+				SimComponent->SetVariableVec3(Name, View.Get<FVector>());
+			}
+		}
+		else if (StructType == TBaseStructure<FVector4>::Get())
+		{
+			SimComponent->SetVariableVec4(Name, View.Get<FVector4>());
+		}
+		else if (StructType == TBaseStructure<FQuat>::Get())
+		{
+			SimComponent->SetVariableQuat(Name, View.Get<FQuat>());
+		}
+		break;
+	}
+	default:
+		break;
+	}
+}
