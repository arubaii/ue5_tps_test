+	}
+	SelectedIndex = ((Index % Count) + Count) % Count;
+	bAnimateInDesigner = bAnimate;
+	if (!bAnimate)
+	{
+		HighlightPosition = static_cast<float>(SelectedIndex);
+	}
+	StartSlide();
+}
+#endif
