+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/Widget.h"
+#include "SMenuControls.h"
+
+#include "MenuControlWidgets.generated.h"
+
+class SMenuControlHost;
