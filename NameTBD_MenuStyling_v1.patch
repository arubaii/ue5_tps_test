+class UMenuStyleAsset;
+
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(FOnMenuSwitchChangedEvent, bool, bNewOn);
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(FOnMenuSliderChangedEvent, float, NewValue);
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_TwoParams(FOnMenuSelectionChangedEvent, int32, NewIndex, const FText&, NewOption);
+
+/**
+ * The base of the standalone menu controls (palette NameTBD): a Settings Menu's switch, slider, selector and segmented buttons,
+ * anywhere in your own UMG - drawn in a Menu Style (its colours, sizes and skin), focusable (left / right change it, Accept
+ * toggles), and optionally bound to a setting by Id, so they show and change the player's setting with no Blueprint.
+ */
+UCLASS(Abstract)
+class NAMETBD_API UMenuControlWidgetBase : public UWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The look. Empty: the project's Default Style, else Simple. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Menu Control")
+	TObjectPtr<UMenuStyleAsset> StyleAsset;
+
+	/**
+	 * A setting this control shows and changes ("Audio.MusicVolume", "Accessibility.Subtitles"): a switch takes a Bool, a slider
+	 * a Number (its range), a selector or segmented control a Choice (its options). None: the control's own value, yours to use.
+	 */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Menu Control")
+	FName SettingId;
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetStyleAsset(UMenuStyleAsset* InStyleAsset);
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetSettingId(FName InSettingId);
+
+	virtual void SynchronizeProperties() override;
+	virtual void ReleaseSlateResources(bool bReleaseChildren) override;
+#if WITH_EDITOR
+	virtual const FText GetPaletteCategory() override;
+#endif
+
+protected:
+	virtual TSharedRef<SWidget> RebuildWidget() override;
+
+	/** The control itself (inside a focusable host). */
+	virtual TSharedRef<SWidget> MakeControl() PURE_VIRTUAL(UMenuControlWidgetBase::MakeControl, return SNullWidget::NullWidget;);
+
+	/** Left / right on the focused control. */
+	virtual void StepControl(int32 Direction) {}
+
+	/** Accept on the focused control. */
+	virtual void ActivateControl() {}
+
+	/** The bound setting's value arrived (or changed): show it. */
+	virtual void ShowSettingValue(const FString& Value) {}
+
+	UMenuSettingsSubsystem* FindSettings() const;
+
+	/** Writes the bound setting (when bound). */
+	void WriteSetting(const FString& Value);
+
+	/** The bound setting's current value, or empty. */
+	FString ReadSetting() const;
+
+	bool IsBound() const { return !SettingId.IsNone(); }
+
+	FMenuStyleRef StyleHolder = MakeShared<FMenuStyleHolder>();
+	TSharedPtr<SMenuControlHost> Host;
+
+private:
+	void BindSetting();
+	void UnbindSetting();
+	void HandleStyleChanged(const UMenuStyleAsset* Changed);
+
+	TWeakObjectPtr<UMenuSettingsSubsystem> BoundSettings;
+	FDelegateHandle ChangedHandle;
+	FDelegateHandle StyleHandle;
+};
+
+/** Menu Switch: an on / off switch in a menu style. */
+UCLASS(meta = (DisplayName = "Menu Switch"))
+class NAMETBD_API UMenuSwitch : public UMenuControlWidgetBase
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Switch")
+	bool bOn = false;
+
+	UPROPERTY(BlueprintAssignable, Category = "Switch")
+	FOnMenuSwitchChangedEvent OnSwitchChanged;
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetOn(bool bNewIsOn);
+
+	UFUNCTION(BlueprintPure, Category = "Menu|Controls")
+	bool IsOn() const { return bOn; }
+
+protected:
+	virtual TSharedRef<SWidget> MakeControl() override;
+	virtual void StepControl(int32 Direction) override;
+	virtual void ActivateControl() override;
+	virtual void ShowSettingValue(const FString& Value) override;
+
+private:
+	void Change(bool bNewIsOn);
+};
+
+/** Menu Slider: a track, fill and knob in a menu style (drag, click, left / right by Step Size). */
+UCLASS(meta = (DisplayName = "Menu Slider"))
+class NAMETBD_API UMenuSlider : public UMenuControlWidgetBase
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Slider")
+	float Value = 0.5f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Slider")
+	float MinValue = 0.f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Slider")
+	float MaxValue = 1.f;
+
+	/** Left / right move by this; values snap to it (0: no snapping, left / right move by a twentieth). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Slider", meta = (ClampMin = "0"))
+	float StepSize = 0.05f;
+
+	/** While dragging. */
+	UPROPERTY(BlueprintAssignable, Category = "Slider")
+	FOnMenuSliderChangedEvent OnSliderChanged;
+
+	/** The drag ended, or a step was made. */
+	UPROPERTY(BlueprintAssignable, Category = "Slider")
+	FOnMenuSliderChangedEvent OnSliderCommitted;
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetValue(float InValue);
+
+	UFUNCTION(BlueprintPure, Category = "Menu|Controls")
+	float GetValue() const { return Value; }
+
+protected:
+	virtual TSharedRef<SWidget> MakeControl() override;
+	virtual void StepControl(int32 Direction) override;
+	virtual void ShowSettingValue(const FString& InSettingValue) override;
+
+private:
+	float Snap(float InValue) const;
+	float ToFraction() const;
+	void Change(float NewValue, bool bCommit);
+};
+
+/** Menu Selector: "< High >" with arrows and pips, in a menu style. */
+UCLASS(meta = (DisplayName = "Menu Selector"))
+class NAMETBD_API UMenuSelector : public UMenuControlWidgetBase
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Selector")
+	TArray<FText> Options;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Selector")
+	int32 SelectedIndex = 0;
+
+	/** Right past the last goes to the first. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Selector")
+	bool bWrap = false;
+
+	UPROPERTY(BlueprintAssignable, Category = "Selector")
+	FOnMenuSelectionChangedEvent OnSelectionChanged;
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetSelectedIndex(int32 InIndex);
+
+	UFUNCTION(BlueprintCallable, Category = "Menu|Controls")
+	void SetOptions(const TArray<FText>& InOptions);
+
+	UFUNCTION(BlueprintPure, Category = "Menu|Controls")
+	FText GetSelectedOption() const;
+
+protected:
+	virtual TSharedRef<SWidget> MakeControl() override;
+	virtual void StepControl(int32 Direction) override;
+	virtual void ActivateControl() override { StepControl(1); }
+	virtual void ShowSettingValue(const FString& Value) override;
+
+	/** Bound: the setting's option values, by index. */
+	TArray<FString> OptionValues;
+
+	void Select(int32 NewIndex);
+};
+
+/** Menu Segmented Control: options side by side (Off | Low | High), the picked one filled, in a menu style. */
+UCLASS(meta = (DisplayName = "Menu Segmented Control"))
+class NAMETBD_API UMenuSegmentedControl : public UMenuSelector
+{
+	GENERATED_BODY()
+
+protected:
+	virtual TSharedRef<SWidget> MakeControl() override;
+};
+
+/** Holds a standalone menu control: takes focus, steps on left / right, Accept activates, draws the focus outline. */
+class NAMETBD_API SMenuControlHost : public SCompoundWidget
+{
+public:
+	SLATE_BEGIN_ARGS(SMenuControlHost) {}
+		SLATE_DEFAULT_SLOT(FArguments, Content)
+		SLATE_EVENT(FOnMenuSelectorStep, OnStep)
+		SLATE_EVENT(FOnMenuControlClicked, OnActivate)
+	SLATE_END_ARGS()
+
+	void Construct(const FArguments& InArgs, const FMenuStyleRef& InStyle);
+
+	void SetContent(const TSharedRef<SWidget>& InContent);
+
+	virtual bool SupportsKeyboardFocus() const override { return true; }
+	virtual FReply OnKeyDown(const FGeometry& MyGeometry, const FKeyEvent& InKeyEvent) override;
+	virtual FNavigationReply OnNavigation(const FGeometry& MyGeometry, const FNavigationEvent& InNavigationEvent) override;
+	virtual FReply OnMouseButtonDown(const FGeometry& MyGeometry, const FPointerEvent& MouseEvent) override;
+	virtual int32 OnPaint(const FPaintArgs& Args, const FGeometry& AllottedGeometry, const FSlateRect& MyCullingRect,
+		FSlateWindowElementList& OutDrawElements, int32 LayerId, const FWidgetStyle& InWidgetStyle, bool bParentEnabled) const override;
+
+private:
+	FMenuStyleRef StyleHolder = MakeShared<FMenuStyleHolder>();
+	FOnMenuSelectorStep StepDelegate;
+	FOnMenuControlClicked ActivateDelegate;
+};
diff --git a/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.cpp b/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.cpp
new file mode 100644
index 0000000..3bf871e
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.cpp
@@ -0,0 +1,320 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "MenuPartWidgets.h"
+
+#include "Components/EditableText.h"
+#include "Components/EditableTextBox.h"
+#include "Components/TextBlock.h"
+
+namespace MenuPartWidgetsLocal
+{
+	/** Text into a part, collapsed while empty. */
+	void FillLine(UTextBlock* Block, const FText& Text)
+	{
+		if (Block)
+		{
+			Block->SetText(Text);
+			Block->SetVisibility(Text.IsEmpty() ? ESlateVisibility::Collapsed : ESlateVisibility::SelfHitTestInvisible);
+		}
+	}
+}
+
+// =====================================================================================================
+//  Base
+// =====================================================================================================
+
+FMenuStyle UMenuPartWidget::GetMenuStyle() const
+{
+	return StyleHolder->Style;
+}
+
+FMenuStylePalette UMenuPartWidget::GetMenuPalette() const
+{
+	return StyleHolder->Palette();
+}
+
+void UMenuPartWidget::SetStyleHolder(const FMenuStyleRef& InHolder)
+{
+	StyleHolder = InHolder;
+	OnMenuStyleChanged();
+}
+
+// =====================================================================================================
+//  Tab
+// =====================================================================================================
+
+void UMenuTabWidget::AssignTab(FName InPageId, const FText& InPageName, const FMenuImage& InPageIcon, int32 InTabIndex, TFunction<void()> InSelect)
+{
+	PageId = InPageId;
+	PageName = InPageName;
+	PageIcon = InPageIcon;
+	TabIndex = InTabIndex;
+	SelectFunction = MoveTemp(InSelect);
+	if (LabelText)
+	{
+		LabelText->SetText(StyleHolder->Style.bUppercaseTabs ? InPageName.ToUpper() : InPageName);
+	}
+	OnTabAssigned(InPageId, InPageName, InPageIcon, InTabIndex);
+}
+
+void UMenuTabWidget::SetTabState(bool bInSelected, bool bInHovered, bool bInPressed)
+{
+	if (bStateSent && bSelected == bInSelected && bLastHovered == bInHovered && bLastPressed == bInPressed)
+	{
+		return;
+	}
+	bStateSent = true;
+	bSelected = bInSelected;
+	bLastHovered = bInHovered;
+	bLastPressed = bInPressed;
+	OnTabStateChanged(bInSelected, bInHovered, bInPressed);
+}
+
+void UMenuTabWidget::SelectTab()
+{
+	if (SelectFunction)
+	{
+		SelectFunction();
+	}
+}
+
+// =====================================================================================================
+//  Heading
+// =====================================================================================================
+
+void UMenuHeadingWidget::AssignHeading(const FText& InHeadingText, bool bInCategory)
+{
+	HeadingText = InHeadingText;
+	bCategory = bInCategory;
+	if (LabelText)
+	{
+		LabelText->SetText(!bInCategory && StyleHolder->Style.bUppercaseSections ? InHeadingText.ToUpper() : InHeadingText);
+	}
+	OnHeadingAssigned(InHeadingText, bInCategory);
+}
+
+// =====================================================================================================
+//  Footer prompt
+// =====================================================================================================
+
+void UMenuFooterPromptWidget::AssignPrompt(EMenuFooterAction InAction, const FText& InLabel, TFunction<void()> InPress)
+{
+	Action = InAction;
+	PromptLabel = InLabel;
+	PressFunction = MoveTemp(InPress);
+	MenuPartWidgetsLocal::FillLine(LabelText, StyleHolder->Style.bUppercaseButtons ? InLabel.ToUpper() : InLabel);
+	OnPromptAssigned(InAction, InLabel);
+}
+
+void UMenuFooterPromptWidget::SetGlyph(const FMenuKeyGlyph& InGlyph)
+{
+	Glyph = InGlyph;
+	if (KeyText)
+	{
+		const FText KeyLabel = !InGlyph.Label.IsEmpty() ? InGlyph.Label : (InGlyph.Key.IsValid() ? InGlyph.Key.GetDisplayName(false) : FText::GetEmpty());
+		MenuPartWidgetsLocal::FillLine(KeyText, KeyLabel);
+	}
+	OnGlyphChanged(InGlyph);
+}
+
+void UMenuFooterPromptWidget::SetPromptState(bool bInEnabled, bool bInHovered, bool bInPressed)
+{
+	if (bStateSent && bLastEnabled == bInEnabled && bLastHovered == bInHovered && bLastPressed == bInPressed)
+	{
+		return;
+	}
+	bStateSent = true;
+	bLastEnabled = bInEnabled;
+	bLastHovered = bInHovered;
+	bLastPressed = bInPressed;
+	OnPromptStateChanged(bInEnabled, bInHovered, bInPressed);
+}
+
+void UMenuFooterPromptWidget::Press()
+{
+	if (PressFunction && bLastEnabled)
+	{
+		PressFunction();
+	}
+}
+
+// =====================================================================================================
+//  Description
+// =====================================================================================================
+
+void UMenuDescriptionWidget::Describe(UMenuSetting* InSetting, const FMenuSettingDescription& InDescription)
+{
+	using namespace MenuPartWidgetsLocal;
+	DescribedSetting = InSetting;
+	CurrentDescription = InDescription;
+	FillLine(TitleText, InDescription.Title);
+	FillLine(ValueLineText, InDescription.ValueLine);
+	FillLine(BodyText, InDescription.Body);
+	FillLine(OptionText, InDescription.OptionText);
+	FillLine(WarningText, InDescription.Warning);
+	FillLine(NoteText, InDescription.Note);
+	OnDescriptionChanged(InSetting, InDescription);
+}
+
+// =====================================================================================================
+//  Search
+// =====================================================================================================
+
+void UMenuSearchWidget::NativeOnInitialized()
+{
+	Super::NativeOnInitialized();
+	if (SearchText)
+	{
+		SearchText->OnTextChanged.AddUniqueDynamic(this, &UMenuSearchWidget::HandleTextChanged);
+	}
+	if (SearchTextBox)
+	{
+		SearchTextBox->OnTextChanged.AddUniqueDynamic(this, &UMenuSearchWidget::HandleTextChanged);
+	}
+}
+
+void UMenuSearchWidget::AssignSearch(const FText& InHint, TFunction<void(const FText&)> InSetText)
+{
+	SearchHint = InHint;
+	SetTextFunction = MoveTemp(InSetText);
+	if (SearchText)
+	{
+		SearchText->SetHintText(InHint);
+	}
+	if (SearchTextBox)
+	{
+		SearchTextBox->SetHintText(InHint);
+	}
+}
+
+void UMenuSearchWidget::ShowSearchText(const FText& Text)
+{
+	// Shown without searching again.
+	bShowing = true;
+	if (SearchText && !SearchText->GetText().EqualTo(Text))
+	{
+		SearchText->SetText(Text);
+	}
+	if (SearchTextBox && !SearchTextBox->GetText().EqualTo(Text))
+	{
+		SearchTextBox->SetText(Text);
+	}
+	bShowing = false;
+	OnMenuSearchTextChanged(Text);
+}
+
+void UMenuSearchWidget::SetMenuSearchText(const FText& Text)
+{
+	if (SetTextFunction)
+	{
+		SetTextFunction(Text);
+	}
+}
+
+void UMenuSearchWidget::HandleTextChanged(const FText& Text)
+{
+	if (!bShowing)
+	{
+		SetMenuSearchText(Text);
+	}
+}
+
+// =====================================================================================================
+//  Dialog
+// =====================================================================================================
+
+UMenuDialogWidget::UMenuDialogWidget(const FObjectInitializer& ObjectInitializer)
+	: Super(ObjectInitializer)
+{
+	SetIsFocusable(true);
+}
+
+void UMenuDialogWidget::AssignDialog(const FText& InTitle, const FText& InBody, const TArray<FText>& InLabels, const TArray<int32>& InKinds, int32 InDefault,
+	int32 InCancel, TFunction<void(int32)> InChoose)
+{
+	DialogTitle = InTitle;
+	DialogBody = InBody;
+	ButtonLabels = InLabels;
+	ButtonKinds = InKinds;
+	DefaultButton = InDefault;
+	CancelButton = InCancel;
+	ChooseFunction = MoveTemp(InChoose);
+	MenuPartWidgetsLocal::FillLine(TitleText, InTitle);
+	MenuPartWidgetsLocal::FillLine(BodyText, InBody);
+	OnDialogShown(InTitle, InBody, InLabels, InDefault, InCancel);
+}
+
+void UMenuDialogWidget::SetBody(const FText& InBody)
+{
+	if (InBody.EqualTo(DialogBody))
+	{
+		return;
+	}
+	DialogBody = InBody;
+	MenuPartWidgetsLocal::FillLine(BodyText, InBody);
+	OnDialogBodyChanged(InBody);
+}
+
+UWidget* UMenuDialogWidget::GetDialogFocusWidget_Implementation()
+{
+	return nullptr;
+}
+
+void UMenuDialogWidget::Choose(int32 ButtonIndex)
+{
+	if (ChooseFunction)
+	{
+		// Once: the screen closes the dialog next frame.
+		TFunction<void(int32)> Pending = MoveTemp(ChooseFunction);
+		ChooseFunction = nullptr;
+		Pending(ButtonIndex);
+	}
+}
+
+void UMenuDialogWidget::CancelDialog()
+{
+	if (CancelButton != INDEX_NONE)
+	{
+		Choose(CancelButton);
+	}
+}
+
+// =====================================================================================================
+//  Option list
+// =====================================================================================================
+
+UMenuOptionListWidget::UMenuOptionListWidget(const FObjectInitializer& ObjectInitializer)
+	: Super(ObjectInitializer)
+{
+	SetIsFocusable(true);
+}
+
+void UMenuOptionListWidget::AssignList(const FText& InTitle, const TArray<FText>& InLabels, int32 InCurrent, TFunction<void(int32)> InPick)
+{
+	ListTitle = InTitle;
+	OptionLabels = InLabels;
+	CurrentOption = InCurrent;
+	PickFunction = MoveTemp(InPick);
+	MenuPartWidgetsLocal::FillLine(TitleText, InTitle);
+	OnOptionListShown(InTitle, InLabels, InCurrent);
+}
+
+UWidget* UMenuOptionListWidget::GetListFocusWidget_Implementation()
+{
+	return nullptr;
+}
+
+void UMenuOptionListWidget::PickOption(int32 OptionIndex)
+{
+	if (PickFunction)
+	{
+		TFunction<void(int32)> Pending = MoveTemp(PickFunction);
+		PickFunction = nullptr;
+		Pending(OptionIndex);
+	}
+}
+
+void UMenuOptionListWidget::CancelList()
+{
+	PickOption(INDEX_NONE);
+}
diff --git a/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.h b/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.h
new file mode 100644
index 0000000..cf9ad29
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Menu/Widgets/MenuPartWidgets.h
@@ -0,0 +1,429 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Blueprint/UserWidget.h"
+#include "NameTBD/Menu/Input/MenuInputTypes.h"
+#include "NameTBD/Menu/Settings/MenuSettingTypes.h"
+#include "MenuStyle.h"
+#include "SMenuControls.h"
+
+#include "MenuPartWidgets.generated.h"
+
+class UEditableText;
+class UEditableTextBox;
+class UMenuSetting;
+class UTextBlock;
+
+/*
+ * Your own UMG widgets for the parts of a Settings Menu (Menu Style > Custom Widgets): tabs, headings, footer prompts, the
+ * description panel, the search box, dialogs and dropdown lists. Make a Widget Blueprint from the part's class, lay it out, drive
+ * it from its events; the screen makes one per part, fills it, and keeps doing the work (input, focus, sounds, narration). Parts
+ * named as below are filled for you when present.
+ */
+
+/** Which footer prompt a Menu Footer Prompt Widget is. */
+UENUM(BlueprintType)
+enum class EMenuFooterAction : uint8
+{
+	Back,
+	Reset UMETA(ToolTip = "Reset the page to its defaults (asks first)."),
+	Apply UMETA(ToolTip = "Apply the changes that wait (Apply Button policy)."),
+	Revert UMETA(ToolTip = "Put back every change made since the screen opened."),
+	PreviousTab UMETA(DisplayName = "Previous Tab"),
+	NextTab UMETA(DisplayName = "Next Tab")
+};
+
+/** What the description panel says about the setting it describes. */
+USTRUCT(BlueprintType)
+struct NAMETBD_API FMenuSettingDescription
+{
+	GENERATED_BODY()
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText Title;
+
+	/** "Current: High    Default: Medium" (empty for actions and info). */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText ValueLine;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText CurrentValue;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText DefaultValue;
+
+	/** The setting's description. */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText Body;
+
+	/** The picked option's own description. */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText OptionText;
+
+	/** Why it can't be changed now. */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText Warning;
+
+	/** Restart / confirmation notes. */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FText Note;
+
+	/** The setting's or the option's preview image. */
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FMenuImage Preview;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	bool bEnabled = true;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	bool bRequiresRestart = false;
+};
+
+/** The base of a Settings Menu's custom part widgets: the style it is shown with, and a way back to the screen. */
+UCLASS(Abstract, Blueprintable)
+class NAMETBD_API UMenuPartWidget : public UUserWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The style of the screen showing it (its colours, fonts, sizes). */
+	UFUNCTION(BlueprintPure, Category = "Menu|Part")
+	FMenuStyle GetMenuStyle() const;
+
+	/** The palette in use (High Contrast Colors while High Contrast Menus is on). */
+	UFUNCTION(BlueprintPure, Category = "Menu|Part")
+	FMenuStylePalette GetMenuPalette() const;
+
+	/** The style changed (edited, High Contrast turned on): restyle. Also called once when it is made. */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Part")
+	void OnMenuStyleChanged();
+
+	/** C++: the style holder of the screen showing it. */
+	void SetStyleHolder(const FMenuStyleRef& InHolder);
+
+	/** C++: tells it the style changed. */
+	void NotifyStyleChanged() { OnMenuStyleChanged(); }
+
+protected:
+	FMenuStyleRef StyleHolder = MakeShared<FMenuStyleHolder>();
+};
+
+/** A page tab. Clicking anywhere on it that your widget doesn't handle selects it; a Button inside calls Select Tab. */
+UCLASS(Abstract, Blueprintable, meta = (DisplayName = "Menu Tab Widget"))
+class NAMETBD_API UMenuTabWidget : public UMenuPartWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(BlueprintReadOnly, Category = "Tab")
+	FName PageId;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Tab")
+	FText PageName;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Tab")
+	FMenuImage PageIcon;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Tab")
+	int32 TabIndex = 0;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Tab")
+	bool bSelected = false;
+
+	/** Filled with the page's name (in capitals with the style's Uppercase Tabs). */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> LabelText;
+
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Tab")
+	void OnTabAssigned(FName InPageId, const FText& InPageName, const FMenuImage& InPageIcon, int32 InTabIndex);
+
+	/** Selected (the current page), hovered, pressed. */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Tab")
+	void OnTabStateChanged(bool bIsSelected, bool bIsHovered, bool bIsPressed);
+
+	/** Shows this tab's page. */
+	UFUNCTION(BlueprintCallable, Category = "Menu|Tab")
+	void SelectTab();
+
+	/** C++: filled by the screen. */
+	void AssignTab(FName InPageId, const FText& InPageName, const FMenuImage& InPageIcon, int32 InTabIndex, TFunction<void()> InSelect);
+	void SetTabState(bool bInSelected, bool bInHovered, bool bInPressed);
+
+private:
+	TFunction<void()> SelectFunction;
+	bool bLastHovered = false;
+	bool bLastPressed = false;
+	bool bStateSent = false;
+};
+
+/** A section heading ("DISPLAY") or a key binding category heading ("Movement"). */
+UCLASS(Abstract, Blueprintable, meta = (DisplayName = "Menu Heading Widget"))
+class NAMETBD_API UMenuHeadingWidget : public UMenuPartWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(BlueprintReadOnly, Category = "Heading")
+	FText HeadingText;
+
+	/** A key binding category under a section, rather than a section. */
+	UPROPERTY(BlueprintReadOnly, Category = "Heading")
+	bool bCategory = false;
+
+	/** Filled with the heading (sections in capitals with the style's Uppercase Sections). */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> LabelText;
+
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Heading")
+	void OnHeadingAssigned(const FText& InHeadingText, bool bIsCategory);
+
+	void AssignHeading(const FText& InHeadingText, bool bInCategory);
+};
+
+/** A footer prompt ([B] Back, [Y] Reset to Defaults, Apply, Revert) or a tab-change prompt beside the tabs. Clicking it does it. */
+UCLASS(Abstract, Blueprintable, meta = (DisplayName = "Menu Footer Prompt Widget"))
+class NAMETBD_API UMenuFooterPromptWidget : public UMenuPartWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	UPROPERTY(BlueprintReadOnly, Category = "Prompt")
+	EMenuFooterAction Action = EMenuFooterAction::Back;
+
+	/** "Back", "Reset to Defaults" (empty for the tab prompts). */
+	UPROPERTY(BlueprintReadOnly, Category = "Prompt")
+	FText PromptLabel;
+
+	/** The key for the device in use (art, or a label for a key cap). */
+	UPROPERTY(BlueprintReadOnly, Category = "Prompt")
+	FMenuKeyGlyph Glyph;
+
+	/** Filled with the label. */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> LabelText;
+
+	/** Filled with the key's label ("Esc", "B"), for a key cap of your own. */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> KeyText;
+
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Prompt")
+	void OnPromptAssigned(EMenuFooterAction InAction, const FText& InLabel);
+
+	/** The device or the binding changed: show this key. Invalid Key: none for this device (touch: still tappable). */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Prompt")
+	void OnGlyphChanged(const FMenuKeyGlyph& NewGlyph);
+
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Prompt")
+	void OnPromptStateChanged(bool bPromptEnabled, bool bIsHovered, bool bIsPressed);
+
+	/** Does what the prompt says, as clicking it. */
+	UFUNCTION(BlueprintCallable, Category = "Menu|Prompt")
+	void Press();
+
+	void AssignPrompt(EMenuFooterAction InAction, const FText& InLabel, TFunction<void()> InPress);
+	void SetGlyph(const FMenuKeyGlyph& InGlyph);
+	void SetPromptState(bool bInEnabled, bool bInHovered, bool bInPressed);
+
+private:
+	TFunction<void()> PressFunction;
+	bool bLastEnabled = true;
+	bool bLastHovered = false;
+	bool bLastPressed = false;
+	bool bStateSent = false;
+};
+
+/** The description panel: what the focused (or hovered) setting does, its value, default, preview and notes. */
+UCLASS(Abstract, Blueprintable, meta = (DisplayName = "Menu Description Widget"))
+class NAMETBD_API UMenuDescriptionWidget : public UMenuPartWidget
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The setting described (none: nothing focused yet). */
+	UPROPERTY(BlueprintReadOnly, Transient, Category = "Description")
+	TObjectPtr<UMenuSetting> DescribedSetting;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Description")
+	FMenuSettingDescription CurrentDescription;
+
+	/** Each filled with its line and collapsed while it is empty. */
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> TitleText;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> ValueLineText;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> BodyText;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> OptionText;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> WarningText;
+
+	UPROPERTY(BlueprintReadOnly, Category = "Parts", meta = (BindWidgetOptional))
+	TObjectPtr<UTextBlock> NoteText;
+
+	/** Another setting is described, or its value changed. Setting: none when nothing is described. */
+	UFUNCTION(BlueprintImplementableEvent, Category = "Menu|Description")
+	void OnDescriptionChanged(UMenuSetting* NewSetting, const FMenuSettingDescription& NewDescription);
+
+	void Describe(UMenuSetting* InSetting, const FMenuSettingDescription& InDescription);
+};
+
+/** The search box. An Editable Text named SearchText (or an Editable Text Box named SearchTextBox) is wired up for you. */
+UCLASS(Abstract, Blueprintable, meta = (DisplayName = "Menu Search Widget"))
+class NAMETBD_API UMenuSearchWidget : public UMenuPartWidget
+{
+	GENERATED_BODY()
+
+public:
