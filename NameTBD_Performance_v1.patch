+		{
+		}
+
+		~FScope()
+		{
+			// Emptied as it is handed back, so nothing it pointed at is held on to between uses.
+			Result.ResetKeepingCapacity();
+			--GetDepth();
+		}
+
+		FScope(const FScope&) = delete;
+		FScope& operator=(const FScope&) = delete;
