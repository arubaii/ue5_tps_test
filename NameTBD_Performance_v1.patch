+			for (int32 Index = 0; Index < Panel->GetChildrenCount(); ++Index)
+			{
+				if (UWidget* Found = FindBySegments(Panel->GetChildAt(Index), Segments, Depth + 1))
+				{
+					return Found;
+				}
+			}
+		}
