+	private:
+		static FWidgetAnimResult& Acquire()
+		{
+			TArray<TUniquePtr<FWidgetAnimResult>>& Pool = GetPool();
+			const int32 Depth = GetDepth()++;
+			while (Pool.Num() <= Depth)
