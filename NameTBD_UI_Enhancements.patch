+			GlassStyle.SurfaceTint = Target.PrimaryColor;
+			GlassStyle.CornerRadii = Target.CornerRadii;
+			if (MyBlurWidget.IsValid())
+			{
+				MyBlurWidget->SetStyle(GlassStyle);
+			}
+			return true;
+		}
