@@ -0,0 +1,104 @@
+// Copyright NameTBD Plugin. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Widgets/SCompoundWidget.h"
+#include "Core/NameTBDTypes.h"
+#include "SNameTBDDropShadow.generated.h"
+
+/**
+ * Drop shadow style presets from simple classic drop shadow to sleek modern dual-layer elevation.
+ */
+UENUM(BlueprintType)
+enum class ENameTBDShadowStylePreset : uint8
+{
+	SimpleDrop UMETA(DisplayName = "Simple Drop Shadow"),
+	ModernElevation UMETA(DisplayName = "Sleek Modern Elevation (Ambient + Key Dual-Layer)"),
+	ColoredNeonGlow UMETA(DisplayName = "Colored Ambient / Neon Glow"),
+	ContactFloorShadow UMETA(DisplayName = "Contact Floor Shadow"),
+	SoftFloat UMETA(DisplayName = "Soft Floating Card Shadow")
+};
+
+/**
+ * Configuration struct for Drop Shadow rendering.
+ */
+USTRUCT(BlueprintType)
+struct NAMETBD_API FNameTBDDropShadowStyle
+{
+	GENERATED_BODY()
+
+	/** Preset controlling single-layer vs sleek dual-layer (ambient + key) shadow composition. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow")
+	ENameTBDShadowStylePreset Preset = ENameTBDShadowStylePreset::ModernElevation;
+
+	/** Primary directional key shadow offset in Slate units. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow")
+	FVector2D ShadowOffset = FVector2D(0.0, 8.0);
+
+	/** Soft blur falloff radius in Slate units. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow", meta = (ClampMin = "0.0", ClampMax = "128.0"))
+	float BlurRadius = 22.0f;
+
+	/** Expansion/contraction of the shadow footprint before blur falloff. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow", meta = (ClampMin = "-32.0", ClampMax = "64.0"))
+	float Spread = 0.0f;
+
+	/** Primary shadow color and opacity. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow")
+	FLinearColor ShadowColor = FLinearColor(0.0f, 0.0f, 0.02f, 0.34f);
+
+	/** Secondary tight ambient occlusion shadow color (used in ModernElevation mode). */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow|Dual Layer", meta = (EditCondition = "Preset == ENameTBDShadowStylePreset::ModernElevation"))
+	FLinearColor AmbientShadowColor = FLinearColor(0.0f, 0.0f, 0.02f, 0.16f);
+
+	/** Corner radius of the shadow caster matching the target widget (TL, TR, BR, BL). */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow")
+	FVector4 CornerRadii = FVector4(12.0, 12.0, 12.0, 12.0);
+
+	/** Number of smooth penumbra rings used to render the analytical soft shadow [4..24]. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Shadow|Quality", meta = (ClampMin = "4", ClampMax = "24"))
+	int32 QualityRings = 12;
+};
+
+/**
+ * Slate widget that renders simple or sleek modern multi-layered analytical SDF drop shadows
+ * behind any child or target widget.
+ */
+class NAMETBD_API SNameTBDDropShadow : public SCompoundWidget
+{
+public:
+	SLATE_BEGIN_ARGS(SNameTBDDropShadow)
+		: _ShadowStyle()
+		, _MotionSettings()
+	{}
+		SLATE_ARGUMENT(FNameTBDDropShadowStyle, ShadowStyle)
+		SLATE_ARGUMENT(FNameTBDMotionSettings, MotionSettings)
+		SLATE_DEFAULT_SLOT(FArguments, Content)
+	SLATE_END_ARGS()
+
+	void Construct(const FArguments& InArgs);
+
+	void SetShadowStyle(const FNameTBDDropShadowStyle& InStyle);
+	const FNameTBDDropShadowStyle& GetShadowStyle() const { return TargetStyle; }
+
+	void SetMotionSettings(const FNameTBDMotionSettings& InMotion);
+	void SetContent(const TSharedRef<SWidget>& InContent);
+
+	/** Smoothly transitions the elevation factor (e.g., 1.0 = normal, 1.5 = lifted on hover). */
+	void SetElevationMultiplier(float InMultiplier);
+
+	virtual void Tick(const FGeometry& AllottedGeometry, const double InCurrentTime, const float InDeltaTime) override;
+	virtual int32 OnPaint(const FPaintArgs& Args, const FGeometry& AllottedGeometry, const FSlateRect& MyCullingRect,
+		FSlateWindowElementList& OutDrawElements, int32 LayerId, const FWidgetStyle& InWidgetStyle, bool bParentEnabled) const override;
+
+private:
+	void PaintSoftShadowLayer(const FGeometry& AllottedGeometry, FSlateWindowElementList& OutDrawElements, int32 LayerId,
+		const FVector2D& Offset, float InBlurRadius, float InSpread, const FLinearColor& Color, const FVector4& Radii, int32 Rings) const;
+
+private:
+	FNameTBDDropShadowStyle TargetStyle;
+	FNameTBDMotionSettings MotionSettings;
+	float CurrentElevationMultiplier = 1.0f;
+	float TargetElevationMultiplier = 1.0f;
+};

diff --git a/Plugins/NameTBD/Source/NameTBD/Private/Widgets/SNameTBDDropShadow.cpp b/Plugins/NameTBD/Source/NameTBD/Private/Widgets/SNameTBDDropShadow.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Private/Widgets/SNameTBDDropShadow.cpp
@@ -0,0 +1,183 @@
+// Copyright NameTBD Plugin. All Rights Reserved.
+
+#include "Widgets/SNameTBDDropShadow.h"
+#include "Rendering/DrawElements.h"
+#include "Styling/CoreStyle.h"
+
+void SNameTBDDropShadow::Construct(const FArguments& InArgs)
+{
+	TargetStyle = InArgs._ShadowStyle;
+	MotionSettings = InArgs._MotionSettings;
+	SetCanTick(true);
+
+	ChildSlot
+	[
+		InArgs._Content.Widget
+	];
+}
+
+void SNameTBDDropShadow::SetShadowStyle(const FNameTBDDropShadowStyle& InStyle)
+{
+	TargetStyle = InStyle;
+	Invalidate(EInvalidateWidgetReason::Paint);
+}
+
+void SNameTBDDropShadow::SetMotionSettings(const FNameTBDMotionSettings& InMotion)
+{
+	MotionSettings = InMotion;
+}
+
+void SNameTBDDropShadow::SetContent(const TSharedRef<SWidget>& InContent)
+{
+	ChildSlot
+	[
+		InContent
+	];
+}
+
+void SNameTBDDropShadow::SetElevationMultiplier(float InMultiplier)
+{
+	TargetElevationMultiplier = FMath::Max(0.0f, InMultiplier);
+	if (MotionSettings.Motion == ENameTBDMotionType::Instant)
+	{
+		CurrentElevationMultiplier = TargetElevationMultiplier;
+	}
+}
+
+void SNameTBDDropShadow::Tick(const FGeometry& AllottedGeometry, const double InCurrentTime, const float InDeltaTime)
+{
+	SCompoundWidget::Tick(AllottedGeometry, InCurrentTime, InDeltaTime);
+
+	if (!FMath::IsNearlyEqual(CurrentElevationMultiplier, TargetElevationMultiplier, KINDA_SMALL_NUMBER))
+	{
+		const bool bEntering = TargetElevationMultiplier > CurrentElevationMultiplier;
+		const float Duration = bEntering ? FMath::Max(MotionSettings.EnterDuration, 0.001f) : FMath::Max(MotionSettings.ExitDuration, 0.001f);
+		CurrentElevationMultiplier = FMath::FInterpTo(CurrentElevationMultiplier, TargetElevationMultiplier, InDeltaTime, 1.0f / Duration);
+	}
+}
+
+int32 SNameTBDDropShadow::OnPaint(const FPaintArgs& Args, const FGeometry& AllottedGeometry, const FSlateRect& MyCullingRect,
+	FSlateWindowElementList& OutDrawElements, int32 LayerId, const FWidgetStyle& InWidgetStyle, bool bParentEnabled) const
+{
+	const FLinearColor Tint = InWidgetStyle.GetColorAndOpacityTint();
+	const int32 Rings = FMath::Clamp(TargetStyle.QualityRings, 4, 24);
+	const FVector2D ScaledOffset = TargetStyle.ShadowOffset * static_cast<double>(CurrentElevationMultiplier);
+	const float ScaledBlur = TargetStyle.BlurRadius * CurrentElevationMultiplier;
+
+	if (TargetStyle.Preset == ENameTBDShadowStylePreset::ModernElevation)
+	{
+		// 1. Tight Ambient Contact Layer
+		PaintSoftShadowLayer(
+			AllottedGeometry,
+			OutDrawElements,
+			LayerId,
+			ScaledOffset * 0.25,
+			FMath::Max(2.0f, ScaledBlur * 0.35f),
+			TargetStyle.Spread * 0.5f,
+			TargetStyle.AmbientShadowColor * Tint,
+			TargetStyle.CornerRadii,
+			FMath::Max(4, Rings / 2)
+		);
+		++LayerId;
+
+		// 2. Wide Key Directional Penumbra Layer
+		PaintSoftShadowLayer(
+			AllottedGeometry,
+			OutDrawElements,
+			LayerId,
+			ScaledOffset,
+			ScaledBlur,
+			TargetStyle.Spread,
+			TargetStyle.ShadowColor * Tint,
+			TargetStyle.CornerRadii,
+			Rings
+		);
+		++LayerId;
+	}
+	else if (TargetStyle.Preset == ENameTBDShadowStylePreset::ContactFloorShadow)
+	{
+		const FVector2D LocalSize = AllottedGeometry.GetLocalSize();
+		const FVector2D FloorOffset(ScaledOffset.X, LocalSize.Y * 0.42 + ScaledOffset.Y);
+		PaintSoftShadowLayer(
+			AllottedGeometry,
+			OutDrawElements,
+			LayerId,
+			FloorOffset,
+			ScaledBlur * 0.8f,
+			static_cast<float>(-LocalSize.Y * 0.32),
+			TargetStyle.ShadowColor * Tint,
+			FVector4(LocalSize.X * 0.5, LocalSize.X * 0.5, LocalSize.X * 0.5, LocalSize.X * 0.5),
+			Rings
+		);
+		++LayerId;
+	}
+	else
+	{
+		// SimpleDrop, ColoredNeonGlow, SoftFloat
+		PaintSoftShadowLayer(
+			AllottedGeometry,
+			OutDrawElements,
+			LayerId,
+			ScaledOffset,
+			ScaledBlur,
+			TargetStyle.Spread,
+			TargetStyle.ShadowColor * Tint,
+			TargetStyle.CornerRadii,
+			Rings
+		);
+		++LayerId;
+	}
+
+	return SCompoundWidget::OnPaint(Args, AllottedGeometry, MyCullingRect, OutDrawElements, LayerId, InWidgetStyle, bParentEnabled);
+}
+
+void SNameTBDDropShadow::PaintSoftShadowLayer(const FGeometry& AllottedGeometry, FSlateWindowElementList& OutDrawElements, int32 LayerId,
+	const FVector2D& Offset, float InBlurRadius, float InSpread, const FLinearColor& Color, const FVector4& Radii, int32 Rings) const
+{
+	if (Color.A <= KINDA_SMALL_NUMBER)
+	{
+		return;
+	}
+
+	const FVector2D BaseSize = AllottedGeometry.GetLocalSize();
+	if (BaseSize.X <= 0.0 || BaseSize.Y <= 0.0)
+	{
+		return;
+	}
+
+	const float EffectiveBlur = FMath::Max(0.5f, InBlurRadius);
+
+	// Concentric Gaussian-weighted rounded-box penumbra shells from outermost soft edge to core shadow
+	for (int32 RingIdx = Rings - 1; RingIdx >= 0; --RingIdx)
+	{
+		const float NormalizedDist = static_cast<float>(RingIdx) / static_cast<float>(Rings);
+		const double Expansion = static_cast<double>(InSpread + NormalizedDist * EffectiveBlur);
+
+		const float GaussianWeight = FMath::Exp(-3.5f * NormalizedDist * NormalizedDist) / static_cast<float>(Rings) * 2.2f;
+		FLinearColor ShellColor = Color;
+		ShellColor.A = FMath::Clamp(Color.A * GaussianWeight, 0.0f, 1.0f);
+
+		const FVector2D ShellOrigin = Offset - FVector2D(Expansion, Expansion);
+		const FVector2D ShellSize = BaseSize + FVector2D(Expansion * 2.0, Expansion * 2.0);
+
+		if (ShellSize.X > 0.0 && ShellSize.Y > 0.0)
+		{
+			const FVector4 ExpandedRadii(
+				FMath::Max(0.0, Radii.X + Expansion),
+				FMath::Max(0.0, Radii.Y + Expansion),
+				FMath::Max(0.0, Radii.Z + Expansion),
+				FMath::Max(0.0, Radii.W + Expansion)
+			);
+			const FSlateBrush ShellRoundedBrush = NameTBDMath::MakeRoundedBoxBrush(ExpandedRadii);
+
+			FSlateDrawElement::MakeBox(
+				OutDrawElements,
+				LayerId,
+				AllottedGeometry.ToPaintGeometry(ShellSize, FSlateLayoutTransform(ShellOrigin)),
+				&ShellRoundedBrush,
+				ESlateDrawEffect::None,
+				ShellColor
+			);
+		}
+	}
+}

