+
+bool UNameTBDBlurWidget::SetActiveDesignTargetByID_Implementation(FName InTargetID, bool bAnimateTransition)
+{
+	(void)bAnimateTransition;
+	for (const FNameTBDDesignTarget& Target : DesignTargets)
