+// Copyright NameTBD Plugin. All Rights Reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/Widget.h"
+#include "Components/NamedSlotInterface.h"
+#include "Core/NameTBDTypes.h"
+#include "Widgets/SNameTBDFoldableDropdown.h"
+#include "NameTBDFoldableDropdown.generated.h"
+
+DECLARE_DYNAMIC_MULTICAST_DELEGATE_OneParam(FOnNameTBDFoldableExpansionChanged, bool, bIsExpanded);
+
+/**
+ * Better Dropdown (Foldable) UMG Widget with smooth collapse and open animations.
+ * Provides two named slots (HeaderContent and BodyContent), Enter/Exit durations right after Motion,
+ * animated chevron indicator, and optional accordion group auto-collapse.
+ */
+UCLASS(meta = (DisplayName = "NameTBD Foldable Dropdown"))
+class NAMETBD_API UNameTBDFoldableDropdown : public UWidget, public INamedSlotInterface, public INameTBDDesignTargetInterface
+{
+	GENERATED_BODY()
+
+public:
+	UNameTBDFoldableDropdown();
+
+	/** Whether the foldable dropdown starts in the expanded/open state. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Foldable")
+	bool bIsExpanded = false;
+
+	/** Fold/Unfold visual animation mode. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Foldable")
+	ENameTBDFoldAnimationMode AnimationMode = ENameTBDFoldAnimationMode::SlideAndFade;
+
+	/** Motion preset for opening and collapsing. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Motion")
+	ENameTBDMotionType Motion = ENameTBDMotionType::SmoothLerp;
+
+	/** Duration (in seconds) for the open / expand animation. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Motion", meta = (ClampMin = "0.0", UIMin = "0.0", UIMax = "2.0", EditCondition = "Motion != ENameTBDMotionType::Instant", EditConditionHides))
+	float EnterDuration = 0.26f;
+
+	/** Duration (in seconds) for the collapse / close animation. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Motion", meta = (ClampMin = "0.0", UIMin = "0.0", UIMax = "2.0", EditCondition = "Motion != ENameTBDMotionType::Instant", EditConditionHides))
+	float ExitDuration = 0.20f;
+
+	/** Easing curve for the open and collapse animations. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Motion", meta = (EditCondition = "Motion != ENameTBDMotionType::Instant", EditConditionHides))
+	ENameTBDEasingType Easing = ENameTBDEasingType::EaseOutCubic;
+
+	/** Whether to draw the animated chevron arrow in the header. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Foldable")
+	bool bShowHeaderChevron = true;
+
+	/** Optional accordion group name. Expanding one foldable in a group automatically collapses sibling foldables with the same group name. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Foldable")
+	FName AccordionGroupName = NAME_None;
+
+	/** Optional runtime shape/design targets. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Design Targets")
+	TArray<FNameTBDDesignTarget> DesignTargets;
+
+	/** Currently active design target ID. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Design Targets")
+	FName ActiveDesignTargetID = NAME_None;
+
+	/** Fired when the dropdown is expanded or collapsed. */
+	UPROPERTY(BlueprintAssignable, Category = "Foldable|Events")
+	FOnNameTBDFoldableExpansionChanged OnExpansionChanged;
+
+protected:
+	UPROPERTY()
+	TObjectPtr<UWidget> HeaderContent;
+
+	UPROPERTY()
+	TObjectPtr<UWidget> BodyContent;
+
+public:
+	/** Expands or collapses the dropdown with optional smooth animation. */
+	UFUNCTION(BlueprintCallable, Category = "NameTBD|Foldable Dropdown")
+	void SetExpanded(bool bInExpanded, bool bAnimate = true);
+
+	/** Toggles the current expanded/collapsed state. */
+	UFUNCTION(BlueprintCallable, Category = "NameTBD|Foldable Dropdown")
+	void ToggleExpanded(bool bAnimate = true);
+
+	/** Returns true if currently expanded (or animating toward expanded). */
+	UFUNCTION(BlueprintPure, Category = "NameTBD|Foldable Dropdown")
+	bool IsExpanded() const { return bIsExpanded; }
+
+	/** Returns the current normalized expansion alpha [0..1]. */
+	UFUNCTION(BlueprintPure, Category = "NameTBD|Foldable Dropdown")
+	float GetExpansionAlpha() const;
+
+	// INamedSlotInterface
+	virtual void GetSlotNames(TArray<FName>& SlotNames) const override;
+	virtual UWidget* GetContentForSlot(FName SlotName) const override;
+	virtual void SetContentForSlot(FName SlotName, UWidget* Content) override;
+
+	// INameTBDDesignTargetInterface
+	virtual bool SetActiveDesignTargetByID_Implementation(FName InTargetID, bool bAnimateTransition = true) override;
+	virtual bool SetActiveDesignTargetByValue_Implementation(float NormalizedValue, bool bAnimateTransition = true) override;
+	virtual FName GetActiveDesignTargetID_Implementation() const override { return ActiveDesignTargetID; }
+
+	// UWidget interface
+	virtual void SynchronizeProperties() override;
+	virtual void ReleaseSlateResources(bool bReleaseChildren) override;
+
+#if WITH_EDITOR
+	virtual const FText GetPaletteCategory() override;
+#endif
+
+protected:
+	virtual TSharedRef<SWidget> RebuildWidget() override;
+	void HandleSlateExpansionChanged(bool bNewExpanded);
+	FNameTBDMotionSettings BuildMotionStruct() const;
+
+protected:
+	TSharedPtr<SNameTBDFoldableDropdown> MyFoldable;
+	static const FName HeaderSlotName;
+	static const FName BodySlotName;
+};

diff --git a/Plugins/NameTBD/Source/NameTBD/Private/Widgets/NameTBDFoldableDropdown.cpp b/Plugins/NameTBD/Source/NameTBD/Private/Widgets/NameTBDFoldableDropdown.cpp
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Private/Widgets/NameTBDFoldableDropdown.cpp
@@ -0,0 +1,194 @@
+// Copyright NameTBD Plugin. All Rights Reserved.
+
+#include "Widgets/NameTBDFoldableDropdown.h"
+#include "Components/PanelWidget.h"
+
+#define LOCTEXT_NAMESPACE "NameTBD"
+
+const FName UNameTBDFoldableDropdown::HeaderSlotName(TEXT("HeaderContent"));
+const FName UNameTBDFoldableDropdown::BodySlotName(TEXT("BodyContent"));
+
+UNameTBDFoldableDropdown::UNameTBDFoldableDropdown()
+{
+	bIsVariable = true;
+}
+
+FNameTBDMotionSettings UNameTBDFoldableDropdown::BuildMotionStruct() const
+{
+	FNameTBDMotionSettings Settings;
+	Settings.Motion = Motion;
+	Settings.EnterDuration = EnterDuration;
+	Settings.ExitDuration = ExitDuration;
+	Settings.Easing = Easing;
+	return Settings;
+}
+
+TSharedRef<SWidget> UNameTBDFoldableDropdown::RebuildWidget()
+{
+	MyFoldable = SNew(SNameTBDFoldableDropdown)
+		.bInitiallyExpanded(bIsExpanded)
+		.AnimationMode(AnimationMode)
+		.MotionSettings(BuildMotionStruct())
+		.bShowChevron(bShowHeaderChevron)
+		.OnExpansionChanged(BIND_UOBJECT_DELEGATE(FOnNameTBDFoldStateChangedSlate, HandleSlateExpansionChanged))
+		.HeaderContent()
+		[
+			HeaderContent ? HeaderContent->TakeWidget() : SNullWidget::NullWidget
+		]
+		.BodyContent()
+		[
+			BodyContent ? BodyContent->TakeWidget() : SNullWidget::NullWidget
+		];
+
+	return MyFoldable.ToSharedRef();
+}
+
+void UNameTBDFoldableDropdown::SynchronizeProperties()
+{
+	Super::SynchronizeProperties();
+	if (MyFoldable.IsValid())
+	{
+		MyFoldable->SetMotionSettings(BuildMotionStruct());
+		MyFoldable->SetAnimationMode(AnimationMode);
+		MyFoldable->SetExpanded(bIsExpanded, false);
+	}
+}
+
+void UNameTBDFoldableDropdown::ReleaseSlateResources(bool bReleaseChildren)
+{
+	Super::ReleaseSlateResources(bReleaseChildren);
+	MyFoldable.Reset();
+	if (bReleaseChildren)
+	{
+		if (HeaderContent)
+		{
+			HeaderContent->ReleaseSlateResources(true);
+		}
+		if (BodyContent)
+		{
+			BodyContent->ReleaseSlateResources(true);
+		}
+	}
+}
+
+void UNameTBDFoldableDropdown::SetExpanded(bool bInExpanded, bool bAnimate)
+{
+	bIsExpanded = bInExpanded;
+	if (MyFoldable.IsValid())
+	{
+		MyFoldable->SetExpanded(bInExpanded, bAnimate);
+	}
+	else
+	{
+		HandleSlateExpansionChanged(bInExpanded);
+	}
+}
+
+void UNameTBDFoldableDropdown::ToggleExpanded(bool bAnimate)
+{
+	SetExpanded(!bIsExpanded, bAnimate);
+}
+
+float UNameTBDFoldableDropdown::GetExpansionAlpha() const
+{
+	return MyFoldable.IsValid() ? MyFoldable->GetExpansionAlpha() : (bIsExpanded ? 1.0f : 0.0f);
+}
+
+void UNameTBDFoldableDropdown::HandleSlateExpansionChanged(bool bNewExpanded)
+{
+	bIsExpanded = bNewExpanded;
+
+	if (bIsExpanded && !AccordionGroupName.IsNone())
+	{
+		if (UPanelWidget* ParentPanel = GetParent())
+		{
+			const int32 SiblingCount = ParentPanel->GetChildrenCount();
+			for (int32 i = 0; i < SiblingCount; ++i)
+			{
+				if (UNameTBDFoldableDropdown* Sibling = Cast<UNameTBDFoldableDropdown>(ParentPanel->GetChildAt(i)))
+				{
+					if (Sibling != this && Sibling->AccordionGroupName == AccordionGroupName && Sibling->IsExpanded())
+					{
+						Sibling->SetExpanded(false, true);
+					}
+				}
+			}
+		}
+	}
+
+	OnExpansionChanged.Broadcast(bIsExpanded);
+}
+
+void UNameTBDFoldableDropdown::GetSlotNames(TArray<FName>& SlotNames) const
+{
+	SlotNames.Add(HeaderSlotName);
+	SlotNames.Add(BodySlotName);
+}
+
+UWidget* UNameTBDFoldableDropdown::GetContentForSlot(FName SlotName) const
+{
+	if (SlotName == HeaderSlotName)
+	{
+		return HeaderContent;
+	}
+	if (SlotName == BodySlotName)
+	{
+		return BodyContent;
+	}
+	return nullptr;
+}
+
+void UNameTBDFoldableDropdown::SetContentForSlot(FName SlotName, UWidget* Content)
+{
+	if (SlotName == HeaderSlotName)
+	{
+		HeaderContent = Content;
+		if (MyFoldable.IsValid())
+		{
+			MyFoldable->SetHeaderContent(Content ? Content->TakeWidget() : SNullWidget::NullWidget);
+		}
+	}
+	else if (SlotName == BodySlotName)
+	{
+		BodyContent = Content;
+		if (MyFoldable.IsValid())
+		{
+			MyFoldable->SetBodyContent(Content ? Content->TakeWidget() : SNullWidget::NullWidget);
+		}
+	}
+}
+
+bool UNameTBDFoldableDropdown::SetActiveDesignTargetByID_Implementation(FName InTargetID, bool bAnimateTransition)
+{
+	(void)bAnimateTransition;
+	for (const FNameTBDDesignTarget& Target : DesignTargets)
+	{
+		if (Target.TargetID == InTargetID)
+		{
+			ActiveDesignTargetID = Target.TargetID;
+			return true;
+		}
+	}
+	return false;
+}
+
+bool UNameTBDFoldableDropdown::SetActiveDesignTargetByValue_Implementation(float NormalizedValue, bool bAnimateTransition)
+{
+	for (const FNameTBDDesignTarget& Target : DesignTargets)
+	{
+		if (NormalizedValue >= Target.MinValueThreshold && NormalizedValue <= Target.MaxValueThreshold)
+		{
+			return Execute_SetActiveDesignTargetByID(this, Target.TargetID, bAnimateTransition);
+		}
+	}
+	return false;
+}
+
+#if WITH_EDITOR
+const FText UNameTBDFoldableDropdown::GetPaletteCategory()
+{
+	return LOCTEXT("NameTBDPaletteCategory", "NameTBD");
+}
+#endif
+
+#undef LOCTEXT_NAMESPACE

