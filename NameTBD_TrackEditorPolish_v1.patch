+	FString SanitizeAssetName(const FString& Text)
+	{
+		FString Out = Text.TrimStartAndEnd().Replace(TEXT(" "), TEXT(""));
+		const FString Invalid = FString(INVALID_OBJECTNAME_CHARACTERS) + INVALID_LONGPACKAGE_CHARACTERS;
+		for (TCHAR& Char : Out)
