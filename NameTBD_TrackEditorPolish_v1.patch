+FString SWidgetAnimTimeline::FormatPlayheadTag(float Seconds) const
+{
+	if (IsPercentTime())
+	{
+		return FormatPercent(Seconds);
+	}
+	if (IsFrameTime())
+	{
+		return FormatFrames(Seconds, GetFrameRate());
+	}
+	return FString::Printf(TEXT("%.2f"), Seconds);
+}
