+bool UFlowList::RemoveItemInternal(UWidget* Content, bool bAnimate)
+{
+	if (!Content || Content->GetParent() != this)
+	{
+		return false;
+	}
+	TGuardValue<bool> Animate(bAnimateNextChange, bAnimate);
+	return RemoveChild(Content);
+}
