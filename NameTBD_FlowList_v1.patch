+	if (Slot)
+	{
+		Slot->SetSizeOverride(InSizeOverride);
+		if (const TSharedPtr<SFlowList> Pinned = List.Pin())
+		{
+			Pinned->Invalidate(EInvalidateWidgetReason::Layout);
+		}
+	}
+}
