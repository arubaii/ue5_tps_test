+namespace WidgetAnimTransformDebug
+{
+	/**
+	 * WidgetAnim.DebugTransforms: for chasing a pose that flickers at runtime. 1 logs a warning whenever a widget's render
+	 * transform is found changed by something else since this library last wrote it (another writer - a button's own hover
+	 * scale, a UMG animation, a second component - fighting over it), or is written twice in one frame with different
+	 * poses. 2 also logs every write. Off by default; costs nothing then.
+	 */
+	static TAutoConsoleVariable<int32> CVarDebugTransforms(
+		TEXT("WidgetAnim.DebugTransforms"),
+		0,
+		TEXT("Widget Animations: 1 logs when a widget's render transform was changed by something else between two of its animation's writes, or written twice in a frame with different poses. 2 also logs every write."),
+		ECVF_Default);
+
+	struct FLastWrite
+	{
+		uint64 Frame = 0;
+		FWidgetTransform Pose;
+		float Opacity = 1.f;
+	};
+
+	static bool SamePose(const FWidgetTransform& A, const FWidgetTransform& B)
+	{
+		return A.Translation.Equals(B.Translation, 0.01) && A.Scale.Equals(B.Scale, 0.0001) && A.Shear.Equals(B.Shear, 0.0001) && FMath::IsNearlyEqual(A.Angle, B.Angle, 0.01f);
+	}
+
+	static FString Describe(const FWidgetTransform& Pose, float Opacity)
+	{
+		return FString::Printf(TEXT("translation (%.2f, %.2f) scale (%.4f, %.4f) shear (%.3f, %.3f) angle %.2f opacity %.3f"),
+			Pose.Translation.X, Pose.Translation.Y, Pose.Scale.X, Pose.Scale.Y, Pose.Shear.X, Pose.Shear.Y, Pose.Angle, Opacity);
+	}
+
+	/** Called just before Target is posed: compares what it holds with what was last written, then remembers this write. */
+	static void Check(UWidget* Target, const FWidgetTransform& Pose, float Opacity)
+	{
+		const int32 Level = CVarDebugTransforms.GetValueOnGameThread();
+		if (Level <= 0 || !Target)
+		{
+			return;
+		}
+
+		static TMap<TWeakObjectPtr<UWidget>, FLastWrite> LastWrites;
+		if (LastWrites.Num() > 4096)
+		{
+			LastWrites.Reset();
+		}
+
+		const FWidgetTransform& Held = Target->GetRenderTransform();
+		if (FLastWrite* Last = LastWrites.Find(Target))
+		{
+			if (!SamePose(Held, Last->Pose))
+			{
+				UE_LOG(LogTemp, Warning, TEXT("WidgetAnim.DebugTransforms: %s was changed by something else since frame %llu. Wrote %s; found %s."),
+					*Target->GetPathName(), Last->Frame, *Describe(Last->Pose, Last->Opacity), *Describe(Held, Target->GetRenderOpacity()));
+			}
+			if (Last->Frame == GFrameCounter && !SamePose(Pose, Last->Pose))
+			{
+				UE_LOG(LogTemp, Warning, TEXT("WidgetAnim.DebugTransforms: %s posed twice in frame %llu: %s, then %s."),
+					*Target->GetPathName(), GFrameCounter, *Describe(Last->Pose, Last->Opacity), *Describe(Pose, Opacity));
+			}
+		}
+		if (Level >= 2)
+		{
+			UE_LOG(LogTemp, Log, TEXT("WidgetAnim.DebugTransforms: frame %llu %s: %s"), GFrameCounter, *Target->GetName(), *Describe(Pose, Opacity));
+		}
+
+		FLastWrite& Write = LastWrites.FindOrAdd(Target);
+		Write.Frame = GFrameCounter;
+		Write.Pose = Pose;
+		Write.Opacity = Opacity;
+	}
+}
