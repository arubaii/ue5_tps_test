+	void SWidgetShapePathCanvas::PencilDown(const FVector2D& Screen, const FVector2D& Canvas)
+	{
+		PencilPoints.Reset();
+		PencilCanvas.Reset();
+		PencilContinue = FVertexId();
+		bPencilPrepend = false;
+		PencilPoints.Add(ScreenToBox(Screen));
+		PencilCanvas.Add(Canvas);
