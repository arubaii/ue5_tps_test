+	{
+		Size = DesiredSize;
+	}
+	const FWidgetShapeFrame DrawnFrame = MakeFrame(FVector2f(static_cast<float>(FMath::Max(Size.X, 1.0)), static_cast<float>(FMath::Max(Size.Y, 1.0))));
