@@ -0,0 +1,64 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Widgets/SCompoundWidget.h"
+
+class SRetainerWidget;
+class SWidgetAnimText;
+
+/**
+ * The soft glow behind an animated text's <glow> words and every tag with Glow ticked.
+ *
+ * Slate can't blur what it draws, so the glow is drawn the way a Retainer Box with an effect material draws: a second
+ * SWidgetAnimText in Glow Only mode - the glowing letters alone, each in its glow color, moving exactly as the text's
+ * do - is rendered into a small render target, and the project's Text Glow Material (UWidgetAnimRuntimeSettings)
+ * blurs that into the glow, drawn under the text. The text widget builds this for itself: nothing to wrap it in.
+ *
+ * It costs nothing while its text has no glowing tag - the retainer is collapsed, so nothing renders and the glow copy
+ * isn't even laid out - and one small render target, re-rendered each frame, while it has one. With no material set,
+ * or the material missing, texts simply don't glow.
+ *
+ * Its layer reaches past the text by twice the glow's radius on every side, so the glow isn't cut off at the text's
+ * edges, while taking up exactly the text's own room in the layout.
+ */
+class NAMETBD_API SWidgetAnimTextGlow : public SCompoundWidget
+{
+public:
+
+	SLATE_BEGIN_ARGS(SWidgetAnimTextGlow) {}
+		/** The text as drawn: whether it has glowing tags, and how far they reach. */
+		SLATE_ARGUMENT(TSharedPtr<SWidgetAnimText>, Text)
+
+		/** The copy that draws only the glowing letters - see SWidgetAnimText's Glow Only. */
+		SLATE_ARGUMENT(TSharedPtr<SWidgetAnimText>, GlowText)
+	SLATE_END_ARGS()
+
+	void Construct(const FArguments& InArgs);
+
+	// SWidget
+	virtual void Tick(const FGeometry& AllottedGeometry, const double InCurrentTime, const float InDeltaTime) override;
+
+private:
+
+	/** Room around the text for the glow, in Slate units - reached out into past the text, then padded back in. */
+	FMargin GetOuterPadding() const { return FMargin(-Pad); }
+	FMargin GetInnerPadding() const { return FMargin(Pad); }
+
+	/** Whether the effect material is in place on the retainer, loading it the first time it is needed. */
+	bool EnsureMaterial();
+
+	TWeakPtr<SWidgetAnimText> Text;
+	TSharedPtr<SWidgetAnimText> GlowText;
+	TSharedPtr<SRetainerWidget> Retainer;
+
+	float Pad = 0.f;
+	bool bMaterialTried = false;
+	bool bMaterialSet = false;
+	bool bShown = false;
+
+	/** The material parameters last set, so they're only set again when they change. */
+	float AppliedRadius = -1.f;
+	float AppliedStrength = -1.f;
+};
