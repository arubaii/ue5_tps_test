+	if (!Shown.IsValid() || !GlowText.IsValid() || !Retainer.IsValid())
+	{
+		return;
+	}
+
+	// The text as drawn is always up to date; the glow copy keeps itself up to date only while it is shown (and ticked),
+	// so it is brought up to date as it is about to be.
+	const float Radius = Shown->GetGlowRadius();
+	const bool bGlow = Radius > 0.f && EnsureMaterial();
+	if (bGlow && !bShown)
+	{
+		GlowText->PullStyle();
+	}
+
+	if (bGlow != bShown)
+	{
+		bShown = bGlow;
+		Retainer->SetVisibility(bGlow ? EVisibility::HitTestInvisible : EVisibility::Collapsed);
+		Invalidate(EInvalidateWidgetReason::Layout);
+	}
+	if (!bGlow)
+	{
+		return;
+	}
+
+	// Twice the radius each way, so the blur fades out well inside the layer rather than being cut off at its edge.
+	const float NewPad = FMath::CeilToFloat(Radius * 2.f) + 2.f;
+	if (NewPad != Pad)
+	{
+		Pad = NewPad;
+		Invalidate(EInvalidateWidgetReason::Layout);
+	}
+
+	// The radius in the render target's pixels, which follow the text's scale on screen.
+	const float PixelRadius = Radius * AllottedGeometry.Scale;
+	const float Strength = GlowText->GetGlowStrength();
+	if (UMaterialInstanceDynamic* Material = Retainer->GetEffectMaterial())
+	{
+		if (PixelRadius != AppliedRadius)
+		{
+			AppliedRadius = PixelRadius;
+			Material->SetScalarParameterValue(WidgetAnimTextGlow::RadiusParameter, PixelRadius);
+		}
+		if (Strength != AppliedStrength)
+		{
+			AppliedStrength = Strength;
+			Material->SetScalarParameterValue(WidgetAnimTextGlow::TagStrengthParameter, Strength);
+		}
+	}
+}
diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/SWidgetAnimTextGlow.h b/Plugins/NameTBD/Source/NameTBD/Widgets/SWidgetAnimTextGlow.h
