+namespace WidgetAnimTextGlow
+{
+	/** The material parameters the glow sets - see UWidgetAnimRuntimeSettings::TextGlowMaterial. */
+	const FName TextureParameter(TEXT("Texture"));
+	const FName RadiusParameter(TEXT("Radius"));
+	const FName TagStrengthParameter(TEXT("TagStrength"));
+}
+
+void SWidgetAnimTextGlow::Construct(const FArguments& InArgs)
+{
+	Text = InArgs._Text;
+	GlowText = InArgs._GlowText;
+
+	// Collapsed until the text has something that glows: nothing renders, and the glow copy isn't laid out.
+	ChildSlot
+	.Padding(TAttribute<FMargin>::CreateSP(this, &SWidgetAnimTextGlow::GetOuterPadding))
+	[
+		SAssignNew(Retainer, SRetainerWidget)
+		.RenderOnPhase(true)
+		.RenderOnInvalidation(false)
+		.Phase(0)
+		.PhaseCount(1)
+		.Visibility(EVisibility::Collapsed)
+		[
+			SNew(SBox)
+			.Padding(TAttribute<FMargin>::CreateSP(this, &SWidgetAnimTextGlow::GetInnerPadding))
+			[
+				GlowText.IsValid() ? GlowText.ToSharedRef() : SNullWidget::NullWidget
+			]
+		]
+	];
+
+	SetCanTick(true);
+}
+
+bool SWidgetAnimTextGlow::EnsureMaterial()
+{
+	if (!bMaterialTried)
+	{
+		bMaterialTried = true;
+		if (UMaterialInterface* Material = UWidgetAnimRuntimeSettings::Get().TextGlowMaterial.LoadSynchronous())
+		{
+			Retainer->SetEffectMaterial(Material);
+			Retainer->SetTextureParameter(WidgetAnimTextGlow::TextureParameter);
+			bMaterialSet = true;
+		}
+	}
+	return bMaterialSet;
+}
+
