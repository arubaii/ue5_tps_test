 	// The layer first and the toolbar after it, so the toolbar is drawn - and clicked - on top where they overlap.
 	const TSharedRef<SWidgetShapePathCanvas> Canvas = SNew(SWidgetShapePathCanvas).Widget(Selection[0]);
