+	SurfaceElements.Add(MakeShared<FDesignerSurfaceElement>(Canvas->MakeToolbar(), EExtensionLayoutLocation::TopCenter, FVector2D(0.0, -ToolbarLift), FVector2D(0.5, 1.0)));
 }
 
