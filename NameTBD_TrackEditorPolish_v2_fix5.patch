+		Toolbar->AddSlot()[MakeMenuButton(LOCTEXT("PlayButton", "Play"), WidgetAnimTips::TextEditorPlayTooltip(), &SWidgetAnimTextEditor::MakePlayMenu)];
+		AddGroupBreak();
+		Toolbar->AddSlot()[MakeButton(LOCTEXT("ClearButton", "Clear Tags"), WidgetAnimTips::TextEditorClearTooltip(), [this]() { ClearTags(); })];
+
+		ChildSlot
+		[
+			SNew(SVerticalBox)
+
+			+ SVerticalBox::Slot()
+			.AutoHeight()
+			[
+				SNew(SBorder)
+				.BorderImage(FAppStyle::GetBrush("Brushes.Header"))
+				.Padding(FMargin(4.f, 3.f))
+				.IsEnabled_Lambda([this]() { return IsEditable(); })
+				[
+					Toolbar
+				]
+			]
+
+			+ SVerticalBox::Slot()
+			.AutoHeight()
+			.Padding(FMargin(0.f, 2.f, 0.f, 0.f))
+			[
+				SNew(SBox)
+				.MinDesiredHeight(64.f)
+				.MaxDesiredHeight(220.f)
+				[
+					SAssignNew(Box, SMultiLineEditableTextBox)
+					.Font(IDetailLayoutBuilder::GetDetailFont())
+					.AutoWrapText(true)
+					.SelectAllTextWhenFocused(false)
+					.ClearTextSelectionOnFocusLoss(false)
+					.IsReadOnly_Lambda([this]() { return !IsEditable(); })
+					.ToolTipText(WidgetAnimTips::TextEditorBoxTooltip())
+					.OnTextCommitted_Lambda([this](const FText& NewText, ETextCommit::Type)
+					{
+						Commit(NewText.ToString());
+					})
+				]
+			]
+
+			// Where the cursor is: the tags around it, innermost last - as a word processor shows the styles in force.
+			+ SVerticalBox::Slot()
+			.AutoHeight()
+			.Padding(FMargin(2.f, 2.f, 0.f, 0.f))
+			[
+				SNew(STextBlock)
+				.Font(IDetailLayoutBuilder::GetDetailFontItalic())
+				.ColorAndOpacity(FSlateColor::UseSubduedForeground())
+				.Text_Lambda([this]() { return GetCursorTagsText(); })
+			]
+		];
+
+		Box->SetText(FText::FromString(ReadProperty()));
+	}
