+	virtual void Tick(const FGeometry& AllottedGeometry, const double InCurrentTime, const float InDeltaTime) override
+	{
+		SCompoundWidget::Tick(AllottedGeometry, InCurrentTime, InDeltaTime);
+
+		// The text edited elsewhere - the Text row above, an undo - is taken in, unless it is being typed in here.
+		if (Box.IsValid() && !Box->HasKeyboardFocus())
+		{
+			const FString Property = ReadProperty();
+			if (Property != Box->GetText().ToString())
+			{
+				Box->SetText(FText::FromString(Property));
+			}
+		}
+	}
