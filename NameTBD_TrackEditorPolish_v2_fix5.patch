+		Menu.BeginSection("Event", LOCTEXT("EventHeading", "Event Here"));
+		const TWeakPtr<SWidgetAnimTextEditor> WeakThis = SharedThis(this);
+		AddNameEntry(Menu, LOCTEXT("EventHint", "Event name, then Enter"), [WeakThis](const FString& Name)
+		{
+			if (const TSharedPtr<SWidgetAnimTextEditor> Pinned = WeakThis.Pin())
+			{
+				Pinned->Insert(FString::Printf(TEXT("<event=%s>"), *Name));
+			}
+		});
+		AddNote(Menu, WidgetAnimTips::TextEditorEventTooltip());
+		Menu.EndSection();
+		return Menu.MakeWidget();
+	}
+
+	TSharedRef<SWidget> MakePlayMenu()
+	{
+		FMenuBuilder Menu(/*bShouldCloseWindowAfterMenuSelection=*/true, nullptr);
+		Menu.BeginSection("Play", LOCTEXT("PlayHeading", "Play Animation Here"));
+		const TWeakPtr<SWidgetAnimTextEditor> WeakThis = SharedThis(this);
+		AddNameEntry(Menu, LOCTEXT("PlayHint", "Anim ID, then Enter"), [WeakThis](const FString& Name)
+		{
+			if (const TSharedPtr<SWidgetAnimTextEditor> Pinned = WeakThis.Pin())
+			{
+				Pinned->Insert(FString::Printf(TEXT("<play=%s>"), *Name));
+			}
+		});
+		AddNote(Menu, WidgetAnimTips::TextEditorPlayTooltip());
+		Menu.EndSection();
+		return Menu.MakeWidget();
+	}
+};
+
+// =====================================================================================================
+// FWidgetAnimTextDetails
+// =====================================================================================================
+
+TSharedRef<IDetailCustomization> FWidgetAnimTextDetails::MakeInstance()
+{
+	return MakeShared<FWidgetAnimTextDetails>();
+}
+
+const TArray<FName>& FWidgetAnimTextDetails::GetCustomizedClassNames()
+{
+	static const TArray<FName> Names =
+	{
+		TEXT("WidgetAnimTextBlock"),
+		TEXT("WidgetAnimRichTextBlock"),
+		TEXT("CommonAnimatedText"),
+		TEXT("CommonAnimatedRichText"),
+	};
+	return Names;
+}
+
+void FWidgetAnimTextDetails::CustomizeDetails(IDetailLayoutBuilder& DetailBuilder)
+{
+	const TSharedRef<IPropertyHandle> TextHandle = DetailBuilder.GetProperty(TEXT("Text"));
+	if (!TextHandle->IsValidHandle() || !CastField<FTextProperty>(TextHandle->GetProperty()))
+	{
+		return;
+	}
+
+	TArray<TWeakObjectPtr<UObject>> Objects;
+	DetailBuilder.GetObjectsBeingCustomized(Objects);
+
+	// The Text row where it always is, for its localization options - and the editor right under it.
+	IDetailCategoryBuilder& Content = DetailBuilder.EditCategory(TEXT("Content"));
+	Content.AddProperty(TextHandle);
+	Content.AddCustomRow(LOCTEXT("TextEditorRow", "Text Editor"))
+		.WholeRowContent()
+		[
+			SNew(SWidgetAnimTextEditor)
+			.TextHandle(TextHandle)
+			.Objects(Objects)
+		];
+}
+
+#undef LOCTEXT_NAMESPACE
