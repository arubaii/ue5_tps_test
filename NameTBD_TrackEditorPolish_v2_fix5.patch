+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "IDetailCustomization.h"
+
+/**
+ * The Details panel of the plugin's animated text widgets - Animated Text Block, Animated Rich Text Block and their Common
+ * UI kin, registered by class name so this module needs no Common UI.
+ *
+ * Under the stock Text row - kept, for its localization options - a Text Editor: the text in a roomy box, and above it a
+ * toolbar, laid out as a word processor's is, that writes the tags for whatever is selected - so nobody types <Bold>...</>
+ * or <shake a=2>...</> by hand:
+ *
+ *   Style          - the rows of the widget's Text Style Set (a rich text only): the project's own rich text styles.
+ *   Effect         - the project's Text Tags (Project Settings > Plugins > Widget Animations > Text Tags): shake, wave...
+ *   Color, Size, Glow                       - the built-in look tags.
+ *   Speed, Instant, Pause, Event, Play      - the built-in Text Reveal tags: pacing, and what happens as it is reached.
+ *   Clear          - takes the tags around or inside the selection off again.
+ *
+ * Each wraps the selection in its tag - the selection kept, so several can be stacked - or, with nothing selected, puts an
+ * empty pair at the cursor, the cursor inside it. Pause, Event and Play, which tag a moment rather than words, go in at the
+ * cursor. Every change is one Details edit of Text: one undo step, on every selected widget, keeping the text's localization
+ * key.
+ */
+class FWidgetAnimTextDetails : public IDetailCustomization
+{
+public:
+	static TSharedRef<IDetailCustomization> MakeInstance();
+
+	virtual void CustomizeDetails(IDetailLayoutBuilder& DetailBuilder) override;
+
+	/** The classes this lays out, by name: what the editor module registers it for. */
+	static const TArray<FName>& GetCustomizedClassNames();
+};
