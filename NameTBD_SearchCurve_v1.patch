+
+	/** Replaces the curve with a ready-made one (its Smoothing too). */
+	UFUNCTION(BlueprintCallable, Category = "Shape|Curve")
+	void SetCurveFromTemplate(EWidgetCurveTemplate Template);
+
+	/**
