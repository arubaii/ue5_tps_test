+UWidgetSpringPresetSettings& UWidgetSpringPresetSettings::Get()
+{
+	return *GetMutableDefault<UWidgetSpringPresetSettings>();
+}
+
+void UWidgetSpringPresetSettings::AddPreset(const FWidgetSpringPreset& Preset)
+{
+	const int32 Existing = Presets.IndexOfByPredicate([&Preset](const FWidgetSpringPreset& Other) { return Other.Name == Preset.Name; });
+	if (Existing != INDEX_NONE)
+	{
+		Presets[Existing] = Preset;
+	}
+	else
+	{
+		Presets.Add(Preset);
+	}
+	Save();
+}
+
+void UWidgetSpringPresetSettings::RemovePreset(int32 Index)
+{
+	if (Presets.IsValidIndex(Index))
+	{
+		Presets.RemoveAt(Index);
+		Save();
+	}
+}
+
+void UWidgetSpringPresetSettings::Save()
+{
+	// Into the project's DefaultEditor.ini, which is checked in: the whole team gets them.
+	SaveConfig();
+	TryUpdateDefaultConfigFile();
+}
+
+// =====================================================================================================
+// Built-in presets
+// =====================================================================================================
+
+namespace WidgetSpringPresets
+{
+	namespace
+	{
+		FWidgetSpringParams DurationAndBounce(float VisualDuration, float Bounce)
+		{
+			FWidgetSpringParams Spring;
+			Spring.Mode = EWidgetSpringMode::DurationAndBounce;
+			Spring.VisualDuration = VisualDuration;
+			Spring.Bounce = Bounce;
+			return Spring;
+		}
+
+		FWidgetSpringParams Physical(float Stiffness, float Damping, float Mass = 1.f)
+		{
+			FWidgetSpringParams Spring;
+			Spring.Mode = EWidgetSpringMode::Physical;
+			Spring.Stiffness = Stiffness;
+			Spring.Damping = Damping;
+			Spring.Mass = Mass;
+			return Spring;
+		}
+
+		/** A spring given as stiffness and damping ratio, as Material and Compose give theirs: mass 1. */
+		FWidgetSpringParams Ratio(float Stiffness, float DampingRatio)
+		{
+			return Physical(Stiffness, 2.f * DampingRatio * FMath::Sqrt(Stiffness));
+		}
+	}
+
+	const TArray<FBuiltIn>& GetBuiltIns()
+	{
+		static const TArray<FBuiltIn> BuiltIns = []()
+		{
+			const FText SwiftUI = LOCTEXT("GroupSwiftUI", "SwiftUI (Apple)");
+			const FText Motion = LOCTEXT("GroupMotion", "Motion (Framer)");
+			const FText Figma = LOCTEXT("GroupFigma", "Figma");
+			const FText ReactSpring = LOCTEXT("GroupReactSpring", "React Spring");
+			const FText Material = LOCTEXT("GroupMaterial", "Material 3 (Google)");
+
+			TArray<FBuiltIn> List;
+			auto Add = [&List](const FText& Group, const FText& Name, const FText& Description, const FWidgetSpringParams& Spring)
+			{
+				List.Add({ Group, Name, Description, Spring });
+			};
+
+			// SwiftUI's named springs (iOS 17): a duration and a bounce, as Duration and Bounce here.
+			Add(SwiftUI, LOCTEXT("Smooth", "Smooth"), LOCTEXT("SmoothDesc", "No overshoot at all - SwiftUI's default spring, for most of what moves on screen."), DurationAndBounce(0.5f, 0.f));
+			Add(SwiftUI, LOCTEXT("Snappy", "Snappy"), LOCTEXT("SnappyDesc", "A touch of overshoot that reads as quick and decided."), DurationAndBounce(0.5f, 0.15f));
+			Add(SwiftUI, LOCTEXT("Bouncy", "Bouncy"), LOCTEXT("BouncyDesc", "A visible bounce - playful, for something arriving."), DurationAndBounce(0.5f, 0.3f));
+			Add(SwiftUI, LOCTEXT("Interactive", "Interactive"), LOCTEXT("InteractiveDesc", "Fast and almost still at the end - for something that follows a finger or a stick."), DurationAndBounce(0.15f, 0.14f));
+
+			// Motion's default physical spring, and its visual-duration springs as its docs use them.
+			Add(Motion, LOCTEXT("MotionDefault", "Default"), LOCTEXT("MotionDefaultDesc", "Motion's own default spring: stiffness 100, damping 10, mass 1 - lively, with a clear wobble."), Physical(100.f, 10.f));
+			Add(Motion, LOCTEXT("MotionPop", "Quick Pop"), LOCTEXT("MotionPopDesc", "Visual Duration 0.3, Bounce 0.25 - a quick pop, the example spring of Motion's docs."), DurationAndBounce(0.3f, 0.25f));
+			Add(Motion, LOCTEXT("MotionCalm", "Calm"), LOCTEXT("MotionCalmDesc", "Visual Duration 0.8, no bounce - a slow, settled move for large panels."), DurationAndBounce(0.8f, 0.f));
+
+			// Figma's Smart Animate springs.
+			Add(Figma, LOCTEXT("FigmaGentle", "Gentle"), LOCTEXT("FigmaGentleDesc", "Figma's Gentle: stiffness 100, damping 15."), Physical(100.f, 15.f));
+			Add(Figma, LOCTEXT("FigmaQuick", "Quick"), LOCTEXT("FigmaQuickDesc", "Figma's Quick: stiffness 300, damping 20."), Physical(300.f, 20.f));
+			Add(Figma, LOCTEXT("FigmaBouncy", "Bouncy"), LOCTEXT("FigmaBouncyDesc", "Figma's Bouncy: stiffness 600, damping 15."), Physical(600.f, 15.f));
+			Add(Figma, LOCTEXT("FigmaSlow", "Slow"), LOCTEXT("FigmaSlowDesc", "Figma's Slow: stiffness 80, damping 20."), Physical(80.f, 20.f));
+
+			// React Spring's config presets: tension is stiffness, friction is damping, mass 1.
+			Add(ReactSpring, LOCTEXT("RSDefault", "Default"), LOCTEXT("RSDefaultDesc", "React Spring's default: tension 170, friction 26."), Physical(170.f, 26.f));
+			Add(ReactSpring, LOCTEXT("RSGentle", "Gentle"), LOCTEXT("RSGentleDesc", "React Spring's gentle: tension 120, friction 14."), Physical(120.f, 14.f));
+			Add(ReactSpring, LOCTEXT("RSWobbly", "Wobbly"), LOCTEXT("RSWobblyDesc", "React Spring's wobbly: tension 180, friction 12."), Physical(180.f, 12.f));
+			Add(ReactSpring, LOCTEXT("RSStiff", "Stiff"), LOCTEXT("RSStiffDesc", "React Spring's stiff: tension 210, friction 20."), Physical(210.f, 20.f));
+			Add(ReactSpring, LOCTEXT("RSSlow", "Slow"), LOCTEXT("RSSlowDesc", "React Spring's slow: tension 280, friction 60."), Physical(280.f, 60.f));
+			Add(ReactSpring, LOCTEXT("RSMolasses", "Molasses"), LOCTEXT("RSMolassesDesc", "React Spring's molasses: tension 280, friction 120."), Physical(280.f, 120.f));
+
+			// Material 3's motion springs: spatial ones move things, effects ones fade and color them (no overshoot).
+			Add(Material, LOCTEXT("M3FastSpatial", "Fast Spatial"), LOCTEXT("M3FastSpatialDesc", "Material 3 standard fast spatial: stiffness 1400, damping ratio 0.9 - small things moving."), Ratio(1400.f, 0.9f));
+			Add(Material, LOCTEXT("M3DefaultSpatial", "Default Spatial"), LOCTEXT("M3DefaultSpatialDesc", "Material 3 standard default spatial: stiffness 700, damping ratio 0.9."), Ratio(700.f, 0.9f));
+			Add(Material, LOCTEXT("M3SlowSpatial", "Slow Spatial"), LOCTEXT("M3SlowSpatialDesc", "Material 3 standard slow spatial: stiffness 300, damping ratio 0.9 - large surfaces moving."), Ratio(300.f, 0.9f));
+			Add(Material, LOCTEXT("M3ExpressiveSpatial", "Expressive Spatial"), LOCTEXT("M3ExpressiveSpatialDesc", "Material 3 expressive default spatial: stiffness 380, damping ratio 0.8 - with some bounce."), Ratio(380.f, 0.8f));
+			Add(Material, LOCTEXT("M3ExpressiveFast", "Expressive Fast Spatial"), LOCTEXT("M3ExpressiveFastDesc", "Material 3 expressive fast spatial: stiffness 800, damping ratio 0.6 - a lively pop."), Ratio(800.f, 0.6f));
+			Add(Material, LOCTEXT("M3FastEffects", "Fast Effects"), LOCTEXT("M3FastEffectsDesc", "Material 3 fast effects: stiffness 3800, critically damped - opacity and color, quickly."), Ratio(3800.f, 1.f));
+			Add(Material, LOCTEXT("M3DefaultEffects", "Default Effects"), LOCTEXT("M3DefaultEffectsDesc", "Material 3 default effects: stiffness 1600, critically damped."), Ratio(1600.f, 1.f));
+			Add(Material, LOCTEXT("M3SlowEffects", "Slow Effects"), LOCTEXT("M3SlowEffectsDesc", "Material 3 slow effects: stiffness 800, critically damped."), Ratio(800.f, 1.f));
+			return List;
+		}();
+		return BuiltIns;
+	}
+
+	bool IsSameSpring(const FWidgetSpringParams& A, const FWidgetSpringParams& B)
+	{
+		if (A.Mode != B.Mode)
+		{
+			return false;
+		}
+		auto Near = [](float X, float Y) { return FMath::Abs(X - Y) <= FMath::Max(0.001f, 0.002f * FMath::Max(FMath::Abs(X), FMath::Abs(Y))); };
+		return A.Mode == EWidgetSpringMode::DurationAndBounce
+			? Near(A.VisualDuration, B.VisualDuration) && Near(A.Bounce, B.Bounce)
+			: Near(A.Stiffness, B.Stiffness) && Near(A.Damping, B.Damping) && Near(A.Mass, B.Mass);
+	}
+}
