+/**
+ * A plane of the system laid on the screen (see ENiagaraUIPlane): Right and Down are the system's axes along the screen's
+ * X and Y, Depth points toward the viewer (Right x Down, so the view is the one an editor camera along -Depth sees).
+ */
+struct FNiagaraUIPlaneAxes
+{
+	FVector3f Right = FVector3f(1.f, 0.f, 0.f);
+	FVector3f Down = FVector3f(0.f, 0.f, -1.f);
+	FVector3f Depth = FVector3f(0.f, 1.f, 0.f);
+
+	static FNiagaraUIPlaneAxes Get(ENiagaraUIPlane Plane);
+
+	/** A point or direction of the system in the plane's 2D coordinates (Y down, as Slate's). */
+	FVector2f Project(const FVector3f& Value) const { return FVector2f(FVector3f::DotProduct(Value, Right), FVector3f::DotProduct(Value, Down)); }
+
+	/** How far toward the viewer a point is. */
+	float DepthOf(const FVector3f& Point) const { return FVector3f::DotProduct(Point, Depth); }
+};
+
+/**
+ * Where one simulation's particles land on screen: a point of the plane, in Niagara units, to Slate absolute space -
+ * Origin + AxisX * X + AxisY * Y. Local-space emitters are mapped through the widget's whole render transform; world-space
+ * ones through its scale alone, so what they left behind stays where it was.
+ */
+struct FNiagaraUISpace
+{
+	FVector2f Origin = FVector2f::ZeroVector;
+	FVector2f AxisX = FVector2f(1.f, 0.f);
+	FVector2f AxisY = FVector2f(0.f, 1.f);
+
+	/** How long one Niagara unit is on screen, whichever way it points - for ribbon widths and tiling. */
+	float LengthScale = 1.f;
+
+	/** The point of the plane perspective scales about: the system's origin. */
+	FVector2f Center = FVector2f::ZeroVector;
+
+	FVector2f ToAbsolute(const FVector2f& PlanePoint) const { return Origin + AxisX * PlanePoint.X + AxisY * PlanePoint.Y; }
+	FVector2f ToAbsoluteVector(const FVector2f& PlaneVector) const { return AxisX * PlaneVector.X + AxisY * PlaneVector.Y; }
+};
+
+/** One simulation to draw this paint, and where. Handed from UNiagaraUIWidget::PrepareForPaint to the mesh. */
+struct FNiagaraUISource
+{
+	UNiagaraComponent* Component = nullptr;
+	FNiagaraUISpace LocalSpace;
+	FNiagaraUISpace WorldSpace;
+};
+
+/** Everything about the widget the mesh needs, read as it paints. */
+struct FNiagaraUIBuildSettings
+{
+	ENiagaraUIPlane Plane = ENiagaraUIPlane::XZ;
+	float PerspectiveDistance = 0.f;
+	bool bSmoothRibbons = true;
+
+	/** The widget's color, opacity and its parents' - multiplies every particle. */
+	FLinearColor Tint = FLinearColor::White;
+
+	/** Slate absolute space. Particles wholly outside it aren't built. */
+	FSlateRect CullRect;
+
+	const TMap<TObjectPtr<UMaterialInterface>, TObjectPtr<UMaterialInterface>>* MaterialRemap = nullptr;
+
+	/** The widget's Particle Image when it has one; null for the built-in soft dot. */
+	const FSlateBrush* ParticleImage = nullptr;
+
+	/** Named in warnings. */
+	const UObject* Owner = nullptr;
+};
+
+/**
+ * The meshes one Niagara Particles widget draws: one batch per run of renderers that draw with the same brush, rebuilt
+ * from the particle data only when it has changed - a simulation ticked, the widget moved or recolored - so a paused
+ * effect, or one painted twice in a frame, costs nothing to build again. Every array is kept between builds and only grows.
+ *
+ * Game thread only.
+ */
+class FNiagaraUIMesh
+{
+public:
+	/** Works out the batches for Sources, or keeps the last ones when nothing they came from has changed. */
+	void Build(TConstArrayView<FNiagaraUISource> Sources, const FNiagaraUIBuildSettings& Settings);
+
+	/** Draws the batches as custom-vertex elements at LayerId. */
+	void Paint(FSlateWindowElementList& OutDrawElements, int32 LayerId) const;
+
+	/** Forgets what was built; the next Build builds. Keeps the memory. */
+	void Reset();
+
+private:
+	struct FBatch
+	{
+		TSharedPtr<FSlateBrush> Brush;
+		TArray<FSlateVertex> Vertices;
+		TArray<SlateIndex> Indices;
+	};
+
+	/** What a renderer draws with: its UI material, a remap of it, or the Particle Image / soft dot, and their tint and UVs. */
+	struct FBrushChoice
+	{
+		TSharedPtr<FSlateBrush> Brush;
+		FLinearColor Tint = FLinearColor::White;
+		FVector2f UVMin = FVector2f(0.f, 0.f);
+		FVector2f UVSize = FVector2f(1.f, 1.f);
+	};
+
+	/** One renderer of one emitter of one simulation, in the order drawn. */
+	struct FDrawEntry
+	{
+		const FNiagaraEmitterInstance* Emitter = nullptr;
+		const UNiagaraRendererProperties* Renderer = nullptr;
+		const FNiagaraUISpace* Space = nullptr;
+		int32 SortOrder = 0;
+		int32 EmitterIndex = 0;
+		int32 RendererIndex = 0;
+		int32 SourceIndex = 0;
+		int32 NumParticles = 0;
+	};
+
+	struct FSortKey
+	{
+		float Key = 0.f;
+		int32 Index = 0;
+	};
+
+	struct FRibbonParticle
+	{
+		uint64 Ribbon = 0;
+		double Order = 0.0;
+		int32 Index = 0;
+	};
+
+	struct FRibbonPoint
+	{
+		FVector2f Position = FVector2f::ZeroVector;
+		float Width = 0.f;
+		FLinearColor Color = FLinearColor::White;
+		/** Which particle along its ribbon it is (fractions between, once smoothed) - for Scaled Uniformly UVs. */
+		float Param = 0.f;
+		float Distance = 0.f;
+	};
+
+	/** Gathers what to draw and how it all hashes - which says whether anything changed. */
+	uint32 Gather(TConstArrayView<FNiagaraUISource> Sources, const FNiagaraUIBuildSettings& Settings);
+
+	FBrushChoice ChooseBrush(UMaterialInterface* Material, const FNiagaraUIBuildSettings& Settings, const FDrawEntry& Entry);
+	FBatch& BatchFor(const TSharedPtr<FSlateBrush>& Brush);
+
+	void AddSprites(const FDrawEntry& Entry, const FNiagaraUIBuildSettings& Settings, const FNiagaraUIPlaneAxes& Axes, const FBrushChoice& Choice, FBatch& Batch);
+	void AddRibbons(const FDrawEntry& Entry, const FNiagaraUIBuildSettings& Settings, const FNiagaraUIPlaneAxes& Axes, const FBrushChoice& Choice, FBatch& Batch);
+	void AddRibbonStrip(int32 NumParticles, const FDrawEntry& Entry, const FNiagaraUIBuildSettings& Settings, const FBrushChoice& Choice, FBatch& Batch);
+
+	TArray<FBatch> Batches;
+	int32 NumBatches = 0;
+	int32 NumParticlesDrawn = 0;
+
+	bool bBuilt = false;
+	uint32 BuiltHash = 0;
+
+	/** The widget's Particle Image, copied so a batch can hold it safely; replaced when the image changes. */
+	TSharedPtr<FSlateBrush> ImageBrush;
+
+	/** What this widget has already warned about - a material, an emitter, a renderer - so each is said once, and cheaply. */
+	TSet<const void*> Warned;
+
+	// Scratch, kept between builds so building allocates nothing once warmed up.
+	TArray<FDrawEntry> Entries;
+	TArray<FSortKey> SortScratch;
+	TArray<FRibbonParticle> RibbonScratch;
+	TArray<FRibbonPoint> RibbonPoints;
+	TArray<FRibbonPoint> SmoothedPoints;
+};
+
+namespace NiagaraUIMesh
+{
+	/** Particles alive now in Component's CPU emitters. */
+	int32 CountParticles(UNiagaraComponent* Component);
+}
diff --git a/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.cpp b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.cpp
new file mode 100644
index 0000000..e718beb
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.cpp
@@ -0,0 +1,305 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "NiagaraUIRuntime.h"
+
+#include "NiagaraUILog.h"
+#include "NiagaraUIWidget.h"
+
+#include "Containers/Ticker.h"
+#include "Engine/Texture2D.h"
+#include "Engine/World.h"
+#include "HAL/IConsoleManager.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialInterface.h"
+#include "Misc/App.h"
+#include "Styling/SlateBrush.h"
+#include "TextureResource.h"
+#include "UObject/GCObject.h"
+
+namespace NiagaraUIRuntime
+{
+	namespace
+	{
+		TAutoConsoleVariable<int32> CVarEnable(
+			TEXT("NiagaraUI.Enable"),
+			1,
+			TEXT("0 stops every Niagara Particles widget simulating and drawing, for profiling. 1 (the default) runs them."));
+
+		TAutoConsoleVariable<int32> CVarLog(
+			TEXT("NiagaraUI.Log"),
+			0,
+			TEXT("1 logs the Niagara Particles widgets' simulations as they are made, let go, paused and resumed (LogNiagaraUI)."));
+
+		/** Seconds a brush nothing has drawn with is kept before it is let go - and its material with it. */
+		constexpr double BrushKeepSeconds = 10.0;
+
+		/** Edge of the soft dot texture, in pixels. Big enough to stay soft at the sizes particles are drawn in UI. */
+		constexpr int32 DotSize = 64;
+
+		/**
+		 * The shared state. An FGCObject: it keeps the materials it has brushes for, and the dot texture, from being
+		 * collected while a brush may still draw with them.
+		 */
+		class FRuntime : public FGCObject
+		{
+		public:
+			FRuntime()
+			{
+				TickerHandle = FTSTicker::GetCoreTicker().AddTicker(FTickerDelegate::CreateRaw(this, &FRuntime::Tick));
+				WorldCleanupHandle = FWorldDelegates::OnWorldCleanup.AddRaw(this, &FRuntime::HandleWorldCleanup);
+			}
+
+			virtual ~FRuntime() override
+			{
+				FTSTicker::RemoveTicker(TickerHandle);
+				FWorldDelegates::OnWorldCleanup.Remove(WorldCleanupHandle);
+			}
+
+			virtual void AddReferencedObjects(FReferenceCollector& Collector) override
+			{
+				for (TPair<const UMaterialInterface*, FBrushEntry>& Pair : MaterialBrushes)
+				{
+					Collector.AddReferencedObject(Pair.Value.Material);
+				}
+				Collector.AddReferencedObject(DotTexture);
+			}
+
+			virtual FString GetReferencerName() const override
+			{
+				return TEXT("NiagaraUIRuntime");
+			}
+
+			void Track(UNiagaraUIWidget* Widget)
+			{
+				Tracked.AddUnique(Widget);
+			}
+
+			void Untrack(UNiagaraUIWidget* Widget)
+			{
+				Tracked.RemoveAllSwap([Widget](const TWeakObjectPtr<UNiagaraUIWidget>& Entry)
+				{
+					return !Entry.IsValid() || Entry.Get() == Widget;
+				});
+			}
+
+			void WarnOnce(const FString& Message)
+			{
+				bool bAlreadyWarned = false;
+				Warned.Add(Message, &bAlreadyWarned);
+				if (!bAlreadyWarned)
+				{
+					UE_LOG(LogNiagaraUI, Warning, TEXT("%s"), *Message);
+				}
+			}
+
+			TSharedPtr<FSlateBrush> GetMaterialBrush(UMaterialInterface* Material)
+			{
+				FBrushEntry& Entry = MaterialBrushes.FindOrAdd(Material);
+				if (!Entry.Brush.IsValid() || Entry.Material != Material)
+				{
+					Entry.Material = Material;
+					Entry.Brush = MakeShared<FSlateBrush>();
+					Entry.Brush->SetResourceObject(Material);
+					Entry.Brush->ImageSize = FVector2D(DotSize, DotSize);
+				}
+				Entry.LastUsed = FApp::GetCurrentTime();
+				return Entry.Brush;
+			}
+
+			TSharedPtr<FSlateBrush> GetDefaultParticleBrush()
+			{
+				if (!DotBrush.IsValid() || !DotTexture)
+				{
+					DotTexture = MakeDotTexture();
+					DotBrush = MakeShared<FSlateBrush>();
+					// Without a texture (no RHI) the brush draws plain squares, which is still something.
+					DotBrush->SetResourceObject(DotTexture);
+					DotBrush->ImageSize = FVector2D(DotSize, DotSize);
+				}
+				return DotBrush;
+			}
+
+		private:
+			struct FBrushEntry
+			{
+				TObjectPtr<UMaterialInterface> Material = nullptr;
+				TSharedPtr<FSlateBrush> Brush;
+				double LastUsed = 0.0;
+			};
+
+			bool Tick(float /*DeltaTime*/)
+			{
+				// Backwards: a widget gone is dropped as it is met.
+				const uint64 Frame = GFrameCounter;
+				for (int32 Index = Tracked.Num() - 1; Index >= 0; --Index)
+				{
+					UNiagaraUIWidget* Widget = Tracked[Index].Get();
+					if (!Widget)
+					{
+						Tracked.RemoveAtSwap(Index);
+						continue;
+					}
+					Widget->TickRuntime(Frame);
+				}
+
+				const double Now = FApp::GetCurrentTime();
+				if (Now >= NextPrune)
+				{
+					NextPrune = Now + 2.0;
+					PruneBrushes(Now);
+				}
+				return true;
+			}
+
+			/** Lets go of brushes no batch holds any more and nothing has drawn with lately, and of deleted materials'. */
+			void PruneBrushes(double Now)
+			{
+				for (auto It = MaterialBrushes.CreateIterator(); It; ++It)
+				{
+					const FBrushEntry& Entry = It.Value();
+					const bool bHeldElsewhere = Entry.Brush.IsValid() && Entry.Brush.GetSharedReferenceCount() > 1;
+					if (!Entry.Material || (!bHeldElsewhere && Now - Entry.LastUsed > BrushKeepSeconds))
+					{
+						It.RemoveCurrent();
+					}
+				}
+			}
+
+			void HandleWorldCleanup(UWorld* World, bool /*bSessionEnded*/, bool /*bCleanupResources*/)
+			{
+				// A copy: letting go of a widget's simulations takes it off the list.
+				const TArray<TWeakObjectPtr<UNiagaraUIWidget>> Widgets = Tracked;
+				for (const TWeakObjectPtr<UNiagaraUIWidget>& Entry : Widgets)
+				{
+					if (UNiagaraUIWidget* Widget = Entry.Get())
+					{
+						Widget->ReleaseSimulationsIn(World);
+					}
+				}
+			}
+
+			/** A white dot, opaque in the middle and fading smoothly to nothing at its edge. */
+			static UTexture2D* MakeDotTexture()
+			{
+				UTexture2D* Texture = UTexture2D::CreateTransient(DotSize, DotSize, PF_B8G8R8A8, TEXT("NiagaraUISoftDot"));
+				if (!Texture || !Texture->GetPlatformData() || Texture->GetPlatformData()->Mips.Num() == 0)
+				{
+					return Texture;
+				}
+
+				Texture->SRGB = true;
+				Texture->Filter = TF_Bilinear;
+				Texture->AddressX = TA_Clamp;
+				Texture->AddressY = TA_Clamp;
+
+				FTexture2DMipMap& Mip = Texture->GetPlatformData()->Mips[0];
+				if (uint8* Pixels = static_cast<uint8*>(Mip.BulkData.Lock(LOCK_READ_WRITE)))
+				{
+					const float Radius = DotSize * 0.5f;
+					for (int32 Y = 0; Y < DotSize; ++Y)
+					{
+						for (int32 X = 0; X < DotSize; ++X)
+						{
+							const float DeltaX = (X + 0.5f - Radius) / Radius;
+							const float DeltaY = (Y + 0.5f - Radius) / Radius;
+							const float Inside = FMath::Clamp(1.f - FMath::Sqrt(DeltaX * DeltaX + DeltaY * DeltaY), 0.f, 1.f);
+							const float Alpha = Inside * Inside * (3.f - 2.f * Inside);
+
+							uint8* Pixel = Pixels + (Y * DotSize + X) * 4;
+							Pixel[0] = 255;
+							Pixel[1] = 255;
+							Pixel[2] = 255;
+							Pixel[3] = static_cast<uint8>(FMath::RoundToInt(Alpha * 255.f));
+						}
+					}
+					Mip.BulkData.Unlock();
+				}
+				Texture->UpdateResource();
+				return Texture;
+			}
+
+			TArray<TWeakObjectPtr<UNiagaraUIWidget>> Tracked;
+			TMap<const UMaterialInterface*, FBrushEntry> MaterialBrushes;
+			TObjectPtr<UTexture2D> DotTexture = nullptr;
+			TSharedPtr<FSlateBrush> DotBrush;
+			TSet<FString> Warned;
+			double NextPrune = 0.0;
+			FTSTicker::FDelegateHandle TickerHandle;
+			FDelegateHandle WorldCleanupHandle;
+		};
+
+		TUniquePtr<FRuntime>& GetRuntime()
+		{
+			static TUniquePtr<FRuntime> Runtime;
+			return Runtime;
+		}
+	}
+
+	void Startup()
+	{
+		GetRuntime() = MakeUnique<FRuntime>();
+	}
+
+	void Shutdown()
+	{
+		GetRuntime().Reset();
+	}
+
+	void Track(UNiagaraUIWidget* Widget)
+	{
+		if (Widget && GetRuntime())
+		{
+			GetRuntime()->Track(Widget);
+		}
+	}
+
+	void Untrack(UNiagaraUIWidget* Widget)
+	{
+		if (GetRuntime())
+		{
+			GetRuntime()->Untrack(Widget);
+		}
+	}
+
+	bool IsEnabled()
+	{
+		return CVarEnable.GetValueOnGameThread() != 0;
+	}
+
+	bool IsLogging()
+	{
+		return CVarLog.GetValueOnGameThread() != 0;
+	}
+
+	void WarnOnce(const FString& Message)
+	{
+		if (GetRuntime())
+		{
+			GetRuntime()->WarnOnce(Message);
+		}
+	}
+
+	bool IsUIMaterial(const UMaterialInterface* Material)
+	{
+		const UMaterial* BaseMaterial = Material ? Material->GetMaterial() : nullptr;
+		return BaseMaterial && BaseMaterial->MaterialDomain == MD_UI;
+	}
+
+	TSharedPtr<FSlateBrush> GetMaterialBrush(UMaterialInterface* Material)
+	{
+		if (!GetRuntime() || !Material)
+		{
+			return nullptr;
+		}
+		return GetRuntime()->GetMaterialBrush(Material);
+	}
+
+	TSharedPtr<FSlateBrush> GetDefaultParticleBrush()
+	{
+		if (!GetRuntime())
+		{
+			return nullptr;
+		}
+		return GetRuntime()->GetDefaultParticleBrush();
+	}
+}
diff --git a/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.h b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.h
new file mode 100644
index 0000000..dde85f7
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIRuntime.h
@@ -0,0 +1,50 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+
+class UMaterialInterface;
+class UNiagaraUIWidget;
+struct FSlateBrush;
+
+/**
+ * What every Niagara Particles widget shares, started and stopped with the module:
+ *
+ *   - One ticker for them all, before the world ticks each frame: Pause When Hidden, and whether each repaints every frame
+ *     (see UNiagaraUIWidget::TickRuntime). Only widgets that have made a simulation are on it.
+ *   - Letting go of their simulations when the world those are registered with is cleaned up (a level change, the end of
+ *     Play In Editor), so no world is kept alive by a widget that outlives it.
+ *   - The brushes particles draw with: one per User Interface material, shared by every widget, and the soft dot drawn
+ *     when a renderer's material can't draw in UI. A brush nothing has drawn with for a while is let go.
+ *   - The console variables NiagaraUI.Enable and NiagaraUI.Log, and warnings logged once.
+ */
+namespace NiagaraUIRuntime
+{
+	void Startup();
+	void Shutdown();
+
+	/** Ticks Widget from the next frame on. Called once it has a simulation. */
+	void Track(UNiagaraUIWidget* Widget);
+
+	/** Stops ticking Widget. Not during garbage collection: a widget being destroyed simply drops off. */
+	void Untrack(UNiagaraUIWidget* Widget);
+
+	/** NiagaraUI.Enable: 0 stops every Niagara Particles widget simulating and drawing, for profiling. */
+	bool IsEnabled();
+
+	/** NiagaraUI.Log: 1 logs simulations made, let go, paused and resumed. */
+	bool IsLogging();
+
+	/** Logs Message as a warning the first time it is seen this run; the same message never again. */
+	void WarnOnce(const FString& Message);
+
+	/** Whether Material can be drawn by Slate: its Material Domain is User Interface. */
+	bool IsUIMaterial(const UMaterialInterface* Material);
+
+	/** The shared brush drawing with Material (a User Interface material). Null after shutdown. */
+	TSharedPtr<FSlateBrush> GetMaterialBrush(UMaterialInterface* Material);
+
+	/** The shared soft round dot, white, drawn when a renderer's material can't draw in UI. Null after shutdown. */
+	TSharedPtr<FSlateBrush> GetDefaultParticleBrush();
+}
diff --git a/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIWidget.cpp b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIWidget.cpp
new file mode 100644
index 0000000..edab5f0
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBDNiagara/Private/NiagaraUIWidget.cpp
@@ -0,0 +1,808 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "NiagaraUIWidget.h"
+
+#include "NiagaraUILog.h"
+#include "NiagaraUIMesh.h"
+#include "NiagaraUIRuntime.h"
+#include "SNiagaraUIWidget.h"
+
+#include "Engine/Engine.h"
+#include "Engine/World.h"
+#include "HAL/PlatformTime.h"
+#include "Materials/MaterialInterface.h"
+#include "NiagaraComponent.h"
+#include "NiagaraEmitterHandle.h"
+#include "NiagaraRibbonRendererProperties.h"
+#include "NiagaraSpriteRendererProperties.h"
+#include "NiagaraSystem.h"
+
+#if WITH_EDITOR
+#include "Editor/WidgetCompilerLog.h"
+#endif
+
+#define LOCTEXT_NAMESPACE "NiagaraUIWidget"
+
+namespace NiagaraUIWidgetPrivate
+{
+	/** The step Prewarm Time is simulated in. */
+	constexpr float PrewarmStep = 1.f / 30.f;
+
+	/** Frames a widget may go undrawn before Pause When Hidden pauses it - one frame of slack for a skipped paint. */
+	constexpr uint64 HiddenAfterFrames = 2;
+}
+
+template <typename FunctionType>
+void UNiagaraUIWidget::ForEachComponent(FunctionType&& Function) const
+{
+	if (IsValid(Main.Component))
+	{
+		Function(Main.Component.Get());
+	}
+	for (const FNiagaraUISimulation& Burst : Bursts)
+	{
+		if (IsValid(Burst.Component))
+		{
+			Function(Burst.Component.Get());
+		}
+	}
+}
+
+UNiagaraUIWidget::UNiagaraUIWidget()
+{
+	// Particles are decoration: a click goes through them to whatever is underneath.
+	SetVisibilityInternal(ESlateVisibility::HitTestInvisible);
+}
+
+// ---------------------------------------------------------------------------------------------
+// UWidget
+// ---------------------------------------------------------------------------------------------
+
+TSharedRef<SWidget> UNiagaraUIWidget::RebuildWidget()
+{
+	MyParticles = SNew(SNiagaraUIWidget).Owner(this);
+	bSlateVolatile = false;
+	return MyParticles.ToSharedRef();
+}
+
+void UNiagaraUIWidget::SynchronizeProperties()
+{
+	Super::SynchronizeProperties();
+
+	// Another system set on a simulation already made: it starts again with that one, if it was playing.
+	if (IsValid(Main.Component) && Main.Component->GetAsset() != NiagaraSystem)
+	{
+		const bool bWasPlaying = Main.Component->IsActive() || Main.bPendingPlay;
+		Main.Component->OnSystemFinished.RemoveAll(this);
+		Main.Component->DeactivateImmediate();
+		Main.Component->SetAsset(NiagaraSystem);
+		Main.Component->OnSystemFinished.AddUniqueDynamic(this, &UNiagaraUIWidget::HandleSystemFinished);
+		Main.bPendingPlay = NiagaraSystem && (bWasPlaying || bAutoPlay);
+		Main.bPendingRestart = true;
+	}
+
+	ForEachComponent([this](UNiagaraComponent* SimComponent)
+	{
+		ApplyRuntimeSettings(SimComponent);
+		ApplyParameters(SimComponent);
+	});
+
+	if (MyParticles.IsValid())
+	{
+		// UWidget::SynchronizeProperties sets volatility from Is Volatile alone; live particles keep it repainting too.
+		MyParticles->ForceVolatile(bSlateVolatile || bIsVolatile);
+		MyParticles->Invalidate(EInvalidateWidgetReason::Layout);
+	}
+}
+
+void UNiagaraUIWidget::ReleaseSlateResources(bool bReleaseChildren)
+{
+	Super::ReleaseSlateResources(bReleaseChildren);
+
+	MyParticles.Reset();
+	bSlateVolatile = false;
+
+	// Not while being garbage collected: the simulations are this widget's alone and go with it, and touching other
+	// objects from here then isn't safe.
+	if (!IsUnreachable())
+	{
+		ReleaseSimulations();
+	}
+}
