+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "NameTBD/WidgetAnimation/WidgetAnimCue.h"
+
+#include "WidgetAnimParticleCue.generated.h"
+
+class UNiagaraSystem;
+class UNiagaraUIWidget;
+class UWidget;
+
+/** What a Particles cue does when it fires. */
+UENUM(BlueprintType)
+enum class EWidgetAnimParticleCueAction : uint8
+{
+	BurstAtTarget UMETA(DisplayName = "Burst At Track's Widget", ToolTip = "Plays a one-shot of the system at the widget this track is aimed at (its Burst Point) - a sparkle as a card lands. Staggered, one burst per item. The Niagara Particles widget can be anywhere around it: an effects layer over the whole screen."),
+
+	Play UMETA(ToolTip = "Plays the Niagara Particles widget's own system from its start."),
+
+	StopEmitting UMETA(DisplayName = "Stop Emitting", ToolTip = "Stops the Niagara Particles widget spawning; its particles live out their lives."),
+
+	Clear UMETA(ToolTip = "Removes every particle of the Niagara Particles widget at once.")
+};
+
+/**
+ * Particles: fires Niagara particles at a moment of the animation - a burst where a card lands, embers starting as a panel
+ * opens, stopping as it closes. Plays on a Niagara Particles widget (see UNiagaraUIWidget): the one named by Particles
+ * Widget, else the first at or inside the track's widget, else the nearest around it. Seen in the editor's previews too,
+ * where the widget has Preview In Designer on.
+ */
+USTRUCT(BlueprintType, meta = (DisplayName = "Particles"))
+struct NAMETBDNIAGARA_API FWidgetAnimParticleCueParams : public FWidgetAnimCueParams
+{
+	GENERATED_BODY()
+
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Particles")
+	EWidgetAnimParticleCueAction Action = EWidgetAnimParticleCueAction::BurstAtTarget;
+
+	/**
+	 * The Niagara Particles widget to play on, by its name in the Widget Blueprint the track's widget is in or any around
+	 * it. None: the first at or inside the track's widget, else the nearest one around it.
+	 */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Particles", meta = (DisplayName = "Particles Widget"))
+	FName ParticlesWidget;
+
+	/** Where on the track's widget the burst plays: 0, 0 its top left, 0.5, 0.5 its middle, 1, 1 its bottom right. */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Particles", meta = (DisplayName = "Burst Point", EditCondition = "Action == EWidgetAnimParticleCueAction::BurstAtTarget", EditConditionHides))
+	FVector2D BurstPoint = FVector2D(0.5, 0.5);
+
+	/** The system the burst plays. None: the Niagara Particles widget's own. A one-shot system (Loop Behavior: Once). */
+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Particles", meta = (DisplayName = "Burst System", EditCondition = "Action == EWidgetAnimParticleCueAction::BurstAtTarget", EditConditionHides))
+	TObjectPtr<UNiagaraSystem> BurstSystem = nullptr;
+};
+
+class NAMETBDNIAGARA_API FWidgetAnimParticleCueEvaluator : public TWidgetAnimCueEvaluator<FWidgetAnimParticleCueParams>
+{
+public:
+
+	virtual FText GetDisplayName() const override;
+	virtual FText GetDescription() const override;
+	virtual FText GetTrackSummary(const FInstancedStruct& Params) const override;
+	virtual bool FiresAtDesignTime(const FInstancedStruct& Params) const override { return true; }
+	virtual void Fire(const FWidgetAnimCueContext& Context) const override;
+
+	/**
+	 * The Niagara Particles widget a cue plays on: the one named WidgetName in the User Widgets around TrackWidget (or
+	 * Host); unnamed, the first at or inside TrackWidget, else the first in each User Widget around it, nearest first.
+	 */
+	static UNiagaraUIWidget* FindParticlesWidget(UWidget* TrackWidget, UWidget* Host, FName WidgetName);
+};
