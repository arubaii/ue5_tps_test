+		if (!FVector2D(Wrapper->GetRenderTransformPivot()).Equals(WantedPivot))
+		{
+			Wrapper->SetRenderTransformPivot(WantedPivot);
+		}
+		if (Inner->GetRenderTransform().IsSet())
