+	if (Wanted == WarmPinnedClip)
+	{
+		return;
+	}
+	ReleaseWarmPin();
+	if (UMediaBoxPool* Pool = Wanted ? GetPool() : nullptr)
+	{
+		Pool->PinClip(Wanted, /*bKeepWarm=*/true);
+		WarmPinnedClip = Wanted;
+		WarmPinPool = Pool;
+	}
