+	/**
+	 * The Inputs panel's Press And Hold button: held while the mouse is down on it, filling - exactly to its own rounded edge -
+	 * as the hold goes on. Untouched it reads as a hold, not a Fire button: a faint wash of the hold color under its label,
+	 * with a thin empty track along its bottom where the fill will run.
+	 */
+	class SWidgetAnimHoldInputButton : public SCompoundWidget
+	{
+	public:
+		SLATE_BEGIN_ARGS(SWidgetAnimHoldInputButton) {}
+			SLATE_ARGUMENT(TFunction<float()>, GetProgress)
+			SLATE_ARGUMENT(TFunction<void(bool)>, OnHeld)
+		SLATE_END_ARGS()
+
+		void Construct(const FArguments& InArgs)
+		{
+			ProgressOf = InArgs._GetProgress;
+			HeldHandler = InArgs._OnHeld;
+			const FLinearColor HoldColor = MachineColors::InputHold;
+			ChildSlot
+			[
+				SNew(SBox)
+				.WidthOverride(64.f)
+				.HeightOverride(20.f)
+				[
+					SNew(SOverlay)
+					// The button: dark, washed with the hold color, lighter while hovered or held.
+					+ SOverlay::Slot()
+					[
+						SNew(SBorder)
+						.BorderImage(WidgetAnimMachineStyle::RoundedBrush(4.f))
+						.BorderBackgroundColor_Lambda([this, HoldColor]()
+						{
+							const FLinearColor Base(0.035f, 0.035f, 0.035f, 1.f);
+							const float Wash = bHeld ? 0.32f : (IsHovered() ? 0.24f : 0.16f);
+							return FSlateColor(FMath::Lerp(Base, HoldColor, Wash));
+						})
+					]
+					// The fill, from the left, as wide as the hold has got - clipped to the same rounded shape.
+					+ SOverlay::Slot()
+					[
+						SNew(SBorder)
+						.BorderImage(FAppStyle::GetNoBrush())
+						.Clipping(EWidgetClipping::ClipToBoundsAlways)
+						.Padding(FMargin(0.f))
+						[
+							SNew(SHorizontalBox)
+							+ SHorizontalBox::Slot()
+							.FillWidth(TAttribute<float>::CreateLambda([this]() { return FMath::Clamp(ProgressOf ? ProgressOf() : 0.f, 0.f, 1.f); }))
+							[
+								SNew(SBorder)
+								.BorderImage(WidgetAnimMachineStyle::RoundedBrush(4.f))
+								.BorderBackgroundColor(FSlateColor(HoldColor))
+								.Padding(FMargin(0.f))
+							]
+							+ SHorizontalBox::Slot()
+							.FillWidth(TAttribute<float>::CreateLambda([this]() { return 1.f - FMath::Clamp(ProgressOf ? ProgressOf() : 0.f, 0.f, 1.f); }))
+							[
+								SNullWidget::NullWidget
+							]
+						]
+					]
+					// Untouched: the empty track the fill will run along.
+					+ SOverlay::Slot()
+					.VAlign(VAlign_Bottom)
+					.Padding(FMargin(4.f, 0.f, 4.f, 2.f))
+					[
+						SNew(SBox)
+						.HeightOverride(2.f)
+						.Visibility_Lambda([this]() { return (ProgressOf ? ProgressOf() : 0.f) > 0.f ? EVisibility::Collapsed : EVisibility::HitTestInvisible; })
+						[
+							SNew(SBorder)
+							.BorderImage(WidgetAnimMachineStyle::RoundedBrush(1.f))
+							.BorderBackgroundColor(FSlateColor(HoldColor.CopyWithNewOpacity(0.55f)))
+						]
+					]
+					+ SOverlay::Slot()
+					.HAlign(HAlign_Center)
+					.VAlign(VAlign_Center)
+					[
+						SNew(STextBlock)
+						.Font(FAppStyle::GetFontStyle(TEXT("SmallFont")))
+						.Text(LOCTEXT("HoldButton", "Hold"))
+					]
+				]
+			];
+		}
+
+		virtual FReply OnMouseButtonDown(const FGeometry& MyGeometry, const FPointerEvent& MouseEvent) override
+		{
+			if (MouseEvent.GetEffectingButton() != EKeys::LeftMouseButton)
+			{
+				return FReply::Unhandled();
+			}
+			SetHeld(true);
+			return FReply::Handled().CaptureMouse(SharedThis(this));
+		}
+
+		virtual FReply OnMouseButtonUp(const FGeometry& MyGeometry, const FPointerEvent& MouseEvent) override
+		{
+			if (MouseEvent.GetEffectingButton() != EKeys::LeftMouseButton || !bHeld)
+			{
+				return FReply::Unhandled();
+			}
+			SetHeld(false);
+			return FReply::Handled().ReleaseMouseCapture();
+		}
+
+		virtual void OnMouseCaptureLost(const FCaptureLostEvent& CaptureLostEvent) override
+		{
+			SetHeld(false);
+		}
+
+	private:
+		void SetHeld(bool bNow)
+		{
+			if (bHeld != bNow)
+			{
+				bHeld = bNow;
+				if (HeldHandler)
+				{
+					HeldHandler(bNow);
+				}
+			}
+		}
+
+		TFunction<float()> ProgressOf;
+		TFunction<void(bool)> HeldHandler;
+		bool bHeld = false;
+	};
+
+	/** An input type from the type picker's kind - see GetTypeKind for the other way. */
+	EWidgetAnimMachineInputType InputTypeOf(WidgetAnimTypePill::EKind Kind)
+	{
+		switch (Kind)
+		{
+		case WidgetAnimTypePill::EKind::Float:    return EWidgetAnimMachineInputType::Number;
+		case WidgetAnimTypePill::EKind::Integer:  return EWidgetAnimMachineInputType::Integer;
+		case WidgetAnimTypePill::EKind::Trigger:  return EWidgetAnimMachineInputType::Trigger;
+		case WidgetAnimTypePill::EKind::Hold:     return EWidgetAnimMachineInputType::Hold;
+		case WidgetAnimTypePill::EKind::Choice:   return EWidgetAnimMachineInputType::Choice;
+		case WidgetAnimTypePill::EKind::Vector2D: return EWidgetAnimMachineInputType::Vector2D;
+		default:                                  return EWidgetAnimMachineInputType::Bool;
+		}
+	}
+}
