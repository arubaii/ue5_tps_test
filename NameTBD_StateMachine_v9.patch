+void SWidgetAnimStateMachineEditor::GoToFindHit(int32 HitIndex)
+{
+	if (!FindHits.IsValidIndex(HitIndex))
+	{
+		return;
+	}
+	const FFindHit Hit = FindHits[HitIndex];
+	FocusOn(Hit.Layer, Hit.Id, /*bSelect=*/true);
+}
