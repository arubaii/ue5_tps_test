+UENUM(BlueprintType)
+enum class EWidgetImageSource : uint8
+{
+	Texture UMETA(DisplayName = "Texture 2D", ToolTip = "The brush: a texture or a material, as before."),
+
+	SVG UMETA(DisplayName = "SVG", ToolTip = "An SVG asset, drawn from its vectors at the size it is shown on screen (redrawn when that size changes), so it is sharp at any size. The brush's Tint, Draw As and Margin still apply.")
+};
+
+/** One colour used in an SVG (in a fill, a stroke or a gradient stop), and the colour to draw it in. */
+USTRUCT(BlueprintType)
+struct NAMETBD_API FWidgetSVGColor
+{
+	GENERATED_BODY()
+
+	/** The colour as the SVG writes it. Opacity is not part of it: the SVG's own opacity is always kept. */
+	UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category = "SVG")
+	FColor Original = FColor::Black;
+
+	/** What to draw it in. Its alpha multiplies the SVG's own opacity (255 keeps it). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "SVG")
+	FColor DrawAs = FColor::Black;
+};
+
+/**
+ * An SVG file, imported (drag a .svg into the Content Browser). Drawn from its vectors at the size it is shown, so it is
+ * sharp at any size: by the SVG Image widget, and by every plugin widget with an image (a shape's Image paint, a Flow
+ * List scroll bar's knob and dots, a Media Box's Error Image, Niagara Particles' Particle Image) when its Image Source is
+ * SVG.
+ *
+ * For engine widgets (Image, Button styles...), which take textures: right-click > Create SVG Texture makes a Texture 2D
+ * drawn from it at a fixed resolution.
+ *
+ * Colours: every colour the SVG uses is listed under Colors and can be changed in place. Draw In White draws every colour
+ * as white instead (keeping opacity), so a widget's tint colours it - the fix for icons that come in black.
+ */
+UCLASS(BlueprintType, hidecategories = Object, meta = (DisplayName = "SVG"))
+class NAMETBD_API UWidgetSVG : public UObject
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The size the SVG says it is, in pixels (its width / height, else its viewBox). An SVG Image's size by default. */
+	UPROPERTY(VisibleAnywhere, Category = "SVG", meta = (DisplayName = "SVG Size"))
+	FVector2D SVGSize = FVector2D::ZeroVector;
+
+	/**
+	 * Draw every colour as white, keeping its opacity, so the widget's tint (an SVG Image's Color And Opacity, a brush's
+	 * Tint, a shape paint's Color) gives the image its colour. Colors below is ignored while this is on.
+	 */
+	UPROPERTY(EditAnywhere, Category = "SVG", meta = (DisplayName = "Draw In White (Tint With Widget)"))
+	bool bDrawInWhite = false;
+
+	/**
+	 * Every colour the SVG uses, in the order it first uses them. Change Draw As to recolour every fill, stroke and
+	 * gradient stop of that colour. An SVG that gives a shape no fill draws it black: that is the black entry here.
+	 */
+	UPROPERTY(EditAnywhere, EditFixedSize, Category = "SVG", meta = (EditCondition = "!bDrawInWhite"))
+	TArray<FWidgetSVGColor> Colors;
+
+	/** The SVG file's text, as last imported. Cooked: the game draws from it. */
+	UPROPERTY()
+	FString SVGSource;
+
+#if WITH_EDITORONLY_DATA
+	/** Where the SVG was imported from, for Reimport. */
+	UPROPERTY(VisibleAnywhere, Instanced, Category = "Import Settings")
+	TObjectPtr<class UAssetImportData> AssetImportData;
+#endif
+
+	/** The size the SVG says it is, in pixels. */
+	UFUNCTION(BlueprintPure, Category = "SVG")
+	FVector2D GetSVGSize() const { return SVGSize; }
+
+	/** Changes whenever what the SVG draws changes (an edit, a reimport): drawings made before are then out of date. */
+	uint32 GetRevision() const { return Revision; }
+
+#if WITH_EDITOR
+	/**
+	 * Takes new SVG text (import, reimport), keeping the Draw As of every colour still in it. On failure nothing changes
+	 * and OutError says why.
+	 */
+	bool SetSVGSource(const FString& InSVGText, FText& OutError);
+
+	virtual void PostEditChangeProperty(FPropertyChangedEvent& PropertyChangedEvent) override;
+	virtual void PostEditUndo() override;
+#endif
+
+#if WITH_EDITORONLY_DATA
+	virtual void PostInitProperties() override;
+#endif
+
+private:
+
+	/** Bumped on every change (never saved: drawings are not either). */
+	uint32 Revision = 0;
+
+	void BumpRevision();
+};
diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.cpp b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.cpp
new file mode 100644
index 0000000..4c5cc74
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.cpp
@@ -0,0 +1,238 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetSVGBrush.h"
+
+#include "Async/Async.h"
+#include "Brushes/SlateDynamicImageBrush.h"
+#include "Framework/Application/SlateApplication.h"
+#include "Layout/Geometry.h"
+#include "Rendering/SlateRenderer.h"
+#include "UObject/ObjectKey.h"
+#include "Widgets/SWidget.h"
+#include "WidgetSVG.h"
+#include "WidgetSVGRaster.h"
+
+/** Which drawing: an SVG, at one revision of it, at one size in pixels. */
+struct FWidgetSVGDrawingKey
+{
+	FObjectKey SVG;
+	uint32 Revision = 0;
+	FIntPoint PixelSize = FIntPoint::ZeroValue;
+
+	bool operator==(const FWidgetSVGDrawingKey& Other) const
+	{
+		return SVG == Other.SVG && Revision == Other.Revision && PixelSize == Other.PixelSize;
+	}
+
+	friend uint32 GetTypeHash(const FWidgetSVGDrawingKey& Key)
+	{
+		return HashCombineFast(HashCombineFast(GetTypeHash(Key.SVG), ::GetTypeHash(Key.Revision)), GetTypeHash(Key.PixelSize));
+	}
+};
+
+/** An SVG drawn at one size, held as a Slate dynamic image while any widget shows it. Game thread only. */
+class FWidgetSVGDrawing : public TSharedFromThis<FWidgetSVGDrawing>
+{
+public:
+
+	FWidgetSVGDrawingKey Key;
+
+	/** Done: drawn (ImageBrush set), or failed (ImageBrush null). */
+	bool bDone = false;
+
+	/** The image, once drawn. */
+	TSharedPtr<FSlateDynamicImageBrush> ImageBrush;
+
+	/** Widgets to repaint once drawn. */
+	TArray<TWeakPtr<SWidget>> Waiters;
+
+	~FWidgetSVGDrawing()
+	{
+		FSlateRenderer* Renderer = FSlateApplication::IsInitialized() ? FSlateApplication::Get().GetRenderer() : nullptr;
+		if (ImageBrush.IsValid() && Renderer)
+		{
+			Renderer->ReleaseDynamicResource(*ImageBrush);
+		}
+	}
+
+	/** Takes the drawn pixels (game thread): makes the Slate image and repaints the widgets waiting for it. */
+	void Finish(bool bDrawn, const TArray<uint8>& Pixels, const FIntPoint& DrawnSize)
+	{
+		bDone = true;
+		FSlateRenderer* Renderer = FSlateApplication::IsInitialized() ? FSlateApplication::Get().GetRenderer() : nullptr;
+		if (bDrawn && Renderer)
+		{
+			static uint64 NextResourceId = 0;
+			const FName ResourceName(*FString::Printf(TEXT("NameTBD_SVG_%llu"), ++NextResourceId));
+			if (Renderer->GenerateDynamicImageResource(ResourceName, DrawnSize.X, DrawnSize.Y, Pixels))
+			{
+				ImageBrush = MakeShared<FSlateDynamicImageBrush>(ResourceName, FVector2D(DrawnSize.X, DrawnSize.Y));
+			}
+		}
+		for (const TWeakPtr<SWidget>& Waiter : Waiters)
+		{
+			if (const TSharedPtr<SWidget> PinnedWaiter = Waiter.Pin())
+			{
+				PinnedWaiter->Invalidate(EInvalidateWidgetReason::Paint);
+			}
+		}
+		Waiters.Empty();
+	}
+};
+
+namespace WidgetSVGBrushPrivate
+{
+	/** Every drawing alive, so widgets showing the same SVG at the same size share one. */
+	static TMap<FWidgetSVGDrawingKey, TWeakPtr<FWidgetSVGDrawing>> Drawings;
+
+	/** Drawn at once (not on a worker thread) while a widget shows nothing yet, up to this many pixels: a typical icon. */
+	static constexpr int32 MaxPixelsDrawnAtOnce = 512 * 512;
+
+	static TSharedRef<FWidgetSVGDrawing> FindOrStart(const FWidgetSVGDrawingKey& Key, const UWidgetSVG& SVG, bool bMayDrawAtOnce)
+	{
+		if (const TWeakPtr<FWidgetSVGDrawing>* Found = Drawings.Find(Key))
+		{
+			if (const TSharedPtr<FWidgetSVGDrawing> Existing = Found->Pin())
+			{
+				return Existing.ToSharedRef();
+			}
+		}
+
+		// Now and then, forget the drawings nothing shows any more.
+		if (Drawings.Num() >= 64 && (Drawings.Num() & 31) == 0)
+		{
+			for (auto It = Drawings.CreateIterator(); It; ++It)
+			{
+				if (!It.Value().IsValid())
+				{
+					It.RemoveCurrent();
+				}
+			}
+		}
+
+		const TSharedRef<FWidgetSVGDrawing> Drawing = MakeShared<FWidgetSVGDrawing>();
+		Drawing->Key = Key;
+		Drawings.Add(Key, Drawing);
+
+		// The SVG at the scale that covers the size both ways (a stretched box is then drawn smaller one way, not bigger).
+		const float Scale = static_cast<float>(FMath::Max(Key.PixelSize.X / FMath::Max(SVG.SVGSize.X, 1.0), Key.PixelSize.Y / FMath::Max(SVG.SVGSize.Y, 1.0)));
+
+		if (bMayDrawAtOnce && Key.PixelSize.X * Key.PixelSize.Y <= MaxPixelsDrawnAtOnce)
+		{
+			TArray<uint8> Pixels;
+			FIntPoint DrawnSize;
+			const bool bDrawn = WidgetSVGRaster::Draw(SVG.SVGSource, SVG.Colors, SVG.bDrawInWhite, Scale, FWidgetSVGBrush::MaxPixelSide, Pixels, DrawnSize);
+			Drawing->Finish(bDrawn, Pixels, DrawnSize);
+			return Drawing;
+		}
+
+		// On a worker thread, from copies; back on the game thread to make the Slate image (if it is still wanted).
+		TWeakPtr<FWidgetSVGDrawing> WeakDrawing = Drawing;
+		Async(EAsyncExecution::ThreadPool, [WeakDrawing, Source = SVG.SVGSource, SVGColors = SVG.Colors, bWhite = SVG.bDrawInWhite, Scale]()
+		{
+			TArray<uint8> Pixels;
+			FIntPoint DrawnSize;
+			const bool bDrawn = WidgetSVGRaster::Draw(Source, SVGColors, bWhite, Scale, FWidgetSVGBrush::MaxPixelSide, Pixels, DrawnSize);
+			AsyncTask(ENamedThreads::GameThread, [WeakDrawing, bDrawn, Pixels = MoveTemp(Pixels), DrawnSize]()
+			{
+				if (const TSharedPtr<FWidgetSVGDrawing> PinnedDrawing = WeakDrawing.Pin())
+				{
+					PinnedDrawing->Finish(bDrawn, Pixels, DrawnSize);
+				}
+			});
+		});
+		return Drawing;
+	}
+}
+
+FIntPoint FWidgetSVGBrush::GetPixelSize(const FGeometry& Geometry, const FVector2f& LocalSize)
+{
+	const FSlateRenderTransform& RenderTransform = Geometry.GetAccumulatedRenderTransform();
+	const FVector2f AxisX = RenderTransform.TransformVector(FVector2f(LocalSize.X, 0.f));
+	const FVector2f AxisY = RenderTransform.TransformVector(FVector2f(0.f, LocalSize.Y));
+	return FIntPoint(
+		FMath::Clamp(FMath::CeilToInt(AxisX.Size() - 0.01f), 1, MaxPixelSide),
+		FMath::Clamp(FMath::CeilToInt(AxisY.Size() - 0.01f), 1, MaxPixelSide));
+}
+
+const FSlateBrush* FWidgetSVGBrush::Get(const UWidgetSVG* SVG, const FSlateBrush* Template, const FGeometry& Geometry, const FVector2f& LocalSize, const SWidget& Widget)
+{
+	if (LocalSize.X <= 0.f || LocalSize.Y <= 0.f)
+	{
+		return nullptr;
+	}
+	const FSlateBrush* Brush = GetAtPixelSize(SVG, Template, GetPixelSize(Geometry, LocalSize), &Widget);
+	if (Brush)
+	{
+		Composed.ImageSize = FVector2D(LocalSize);
+	}
+	return Brush;
+}
+
+const FSlateBrush* FWidgetSVGBrush::GetAtPixelSize(const UWidgetSVG* SVG, const FSlateBrush* Template, const FIntPoint& PixelSize, const SWidget* Widget)
+{
+	using namespace WidgetSVGBrushPrivate;
+
+	if (!SVG || SVG->SVGSource.IsEmpty() || !FSlateApplication::IsInitialized())
+	{
+		Reset();
+		return nullptr;
+	}
+
+	FWidgetSVGDrawingKey Key;
+	Key.SVG = FObjectKey(SVG);
+	Key.Revision = SVG->GetRevision();
+	Key.PixelSize = FIntPoint(FMath::Clamp(PixelSize.X, 1, MaxPixelSide), FMath::Clamp(PixelSize.Y, 1, MaxPixelSide));
+
+	// Another SVG altogether: what was shown is not a stand-in for it.
+	if (Shown.IsValid() && Shown->Key.SVG != Key.SVG)
+	{
+		Shown.Reset();
+	}
+
+	// One drawing at a time: while the one asked for is being made, a new size waits for it (the next paint asks again).
+	const bool bWantedPending = Wanted.IsValid() && !Wanted->bDone && Shown.IsValid();
+	if (!Wanted.IsValid() || (!(Wanted->Key == Key) && !bWantedPending))
+	{
+		Wanted = FindOrStart(Key, *SVG, /*bMayDrawAtOnce=*/!Shown.IsValid());
+	}
+
+	if (Wanted->bDone)
+	{
+		Shown = Wanted;
+	}
+	else if (Widget)
+	{
+		Wanted->Waiters.AddUnique(ConstCastSharedRef<SWidget>(Widget->AsShared()));
+	}
+
+	if (!Shown.IsValid() || !Shown->ImageBrush.IsValid())
+	{
+		return nullptr;
+	}
+
+	// The drawing as the image, with the template's look.
+	Composed = *Shown->ImageBrush;
+	if (Template)
+	{
+		Composed.DrawAs = Template->DrawAs;
+		Composed.Tiling = Template->Tiling;
+		Composed.Mirroring = Template->Mirroring;
+		Composed.Margin = Template->Margin;
+		Composed.TintColor = Template->TintColor;
+		Composed.OutlineSettings = Template->OutlineSettings;
+		Composed.ImageSize = Template->ImageSize;
+	}
+	else
+	{
+		Composed.DrawAs = ESlateBrushDrawType::Image;
+	}
+	return &Composed;
+}
+
+void FWidgetSVGBrush::Reset()
+{
+	Shown.Reset();
+	Wanted.Reset();
+	Composed = FSlateBrush();
+}
diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.h b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.h
new file mode 100644
index 0000000..909abfa
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGBrush.h
@@ -0,0 +1,56 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Styling/SlateBrush.h"
+
+class FWidgetSVGDrawing;
+class SWidget;
+class UWidgetSVG;
+struct FGeometry;
+
+/**
+ * Draws an SVG asset for a Slate widget at the size it is shown on screen, so it is sharp at any size: one per image a
+ * widget draws (an SVG Image has one; a shape one for its fill and one for its stroke). Game thread only (Slate paint).
+ *
+ * A drawing is an image of the SVG at one size in pixels, made on a worker thread (or at once while nothing is shown
+ * yet and it is small) and held as a Slate dynamic image. Drawings are shared: two widgets showing the same SVG at the
+ * same size use one. When the size changes (a resize, a scale animation, the DPI) a new drawing is asked for and the
+ * last one is shown, stretched, until it arrives; one is made at a time, so an animated size doesn't queue a drawing per
+ * frame. An edit to the SVG (its colours, a reimport) draws it again.
+ */
+class NAMETBD_API FWidgetSVGBrush
+{
+public:
+
+	/**
+	 * The brush to draw SVG with over LocalSize (Slate units) of Geometry: Template's look (Tint, Draw As, Margin, Tiling,
+	 * outline; with no Template, a plain Image) with the SVG drawn at that size in screen pixels as its image, Image Size
+	 * LocalSize. Null with no SVG, and while its first drawing isn't ready (Widget is repainted when it is).
+	 */
+	const FSlateBrush* Get(const UWidgetSVG* SVG, const FSlateBrush* Template, const FGeometry& Geometry, const FVector2f& LocalSize, const SWidget& Widget);
+
+	/** The same at a fixed size in pixels, Image Size Template's (Niagara particles: one drawing for every particle). */
+	const FSlateBrush* GetAtPixelSize(const UWidgetSVG* SVG, const FSlateBrush* Template, const FIntPoint& PixelSize, const SWidget* Widget);
+
+	/** Lets go of the drawings (the widget's resources are released). */
+	void Reset();
+
+	/** The size in screen pixels LocalSize of Geometry covers: its render transforms and the DPI scale included. */
+	static FIntPoint GetPixelSize(const FGeometry& Geometry, const FVector2f& LocalSize);
+
+	/** The longest side a drawing is made at, in pixels. Bigger is drawn at this and stretched. */
+	static constexpr int32 MaxPixelSide = 4096;
+
+private:
+
+	/** The drawing shown (ready). */
+	TSharedPtr<FWidgetSVGDrawing> Shown;
+
+	/** The drawing for the size and revision last asked for: Shown once ready. */
+	TSharedPtr<FWidgetSVGDrawing> Wanted;
+
+	/** The brush handed out: Shown's image with the template's look. */
+	FSlateBrush Composed;
+};
diff --git a/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGImage.cpp b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGImage.cpp
new file mode 100644
index 0000000..72b66b1
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Widgets/WidgetSVGImage.cpp
@@ -0,0 +1,174 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "WidgetSVGImage.h"
+
+#include "Rendering/DrawElements.h"
+#include "WidgetSVG.h"
+
+#define LOCTEXT_NAMESPACE "WidgetSVGImage"
+
+// ---- SWidgetSVGImage --------------------------------------------------------------------------------------------
+
+void SWidgetSVGImage::Construct(const FArguments& InArgs)
+{
+}
+
+void SWidgetSVGImage::SetSVG(UWidgetSVG* InSVG)
+{
+	if (SVG.Get() != InSVG)
+	{
+		SVG = InSVG;
+		Invalidate(EInvalidateWidgetReason::Layout);
+	}
+}
+
+void SWidgetSVGImage::SetTint(const FLinearColor& InTint)
+{
+	if (Tint != InTint)
+	{
+		Tint = InTint;
+		Invalidate(EInvalidateWidgetReason::Paint);
+	}
+}
+
+void SWidgetSVGImage::SetFit(EWidgetSVGFit InFit)
+{
+	if (Fit != InFit)
+	{
+		Fit = InFit;
+		Invalidate(EInvalidateWidgetReason::Paint);
+	}
+}
+
+void SWidgetSVGImage::SetDesiredSizeOverride(const TOptional<FVector2D>& InSize)
+{
+	if (DesiredSizeOverride != InSize)
+	{
+		DesiredSizeOverride = InSize;
+		Invalidate(EInvalidateWidgetReason::Layout);
+	}
+}
+
+FVector2D SWidgetSVGImage::ComputeDesiredSize(float LayoutScaleMultiplier) const
+{
+	if (DesiredSizeOverride.IsSet())
+	{
+		return DesiredSizeOverride.GetValue();
+	}
+	const UWidgetSVG* ShownSVG = SVG.Get();
+	return ShownSVG ? ShownSVG->SVGSize : FVector2D::ZeroVector;
+}
+
+int32 SWidgetSVGImage::OnPaint(const FPaintArgs& Args, const FGeometry& AllottedGeometry, const FSlateRect& MyCullingRect,
+	FSlateWindowElementList& OutDrawElements, int32 LayerId, const FWidgetStyle& InWidgetStyle, bool bParentEnabled) const
+{
+	const UWidgetSVG* ShownSVG = SVG.Get();
+	const FVector2D LocalSize = AllottedGeometry.GetLocalSize();
+	const FVector2f BoxSize(static_cast<float>(LocalSize.X), static_cast<float>(LocalSize.Y));
+	if (!ShownSVG || BoxSize.X <= 0.f || BoxSize.Y <= 0.f)
+	{
+		return LayerId;
+	}
+
+	// Contain: the biggest box at the SVG's proportions that fits, centred.
+	FVector2f DrawSize = BoxSize;
+	if (Fit == EWidgetSVGFit::Contain && ShownSVG->SVGSize.X > 0.0 && ShownSVG->SVGSize.Y > 0.0)
+	{
+		const float FitScale = FMath::Min(BoxSize.X / static_cast<float>(ShownSVG->SVGSize.X), BoxSize.Y / static_cast<float>(ShownSVG->SVGSize.Y));
+		DrawSize = FVector2f(static_cast<float>(ShownSVG->SVGSize.X), static_cast<float>(ShownSVG->SVGSize.Y)) * FitScale;
+	}
+	const FGeometry DrawGeometry = AllottedGeometry.MakeChild(DrawSize, FSlateLayoutTransform((BoxSize - DrawSize) * 0.5f));
+
+	const FSlateBrush* Brush = SVGBrush.Get(ShownSVG, nullptr, DrawGeometry, DrawSize, *this);
+	if (!Brush)
+	{
+		return LayerId;
+	}
+
+	const ESlateDrawEffect Effects = ShouldBeEnabled(bParentEnabled) ? ESlateDrawEffect::None : ESlateDrawEffect::DisabledEffect;
+	FSlateDrawElement::MakeBox(OutDrawElements, LayerId, DrawGeometry.ToPaintGeometry(), Brush, Effects,
+		InWidgetStyle.GetColorAndOpacityTint() * Tint);
+	return LayerId;
+}
+
+// ---- UWidgetSVGImage --------------------------------------------------------------------------------------------
+
+TSharedRef<SWidget> UWidgetSVGImage::RebuildWidget()
+{
+	MySVGImage = SNew(SWidgetSVGImage);
+	return MySVGImage.ToSharedRef();
+}
+
+void UWidgetSVGImage::SynchronizeProperties()
+{
+	Super::SynchronizeProperties();
+
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetSVG(SVG);
+		MySVGImage->SetTint(ColorAndOpacity);
+		MySVGImage->SetFit(Fit);
+		MySVGImage->SetDesiredSizeOverride(bOverrideImageSize ? TOptional<FVector2D>(ImageSize) : TOptional<FVector2D>());
+	}
+}
+
+void UWidgetSVGImage::ReleaseSlateResources(bool bReleaseChildren)
+{
+	Super::ReleaseSlateResources(bReleaseChildren);
+	MySVGImage.Reset();
+}
+
+void UWidgetSVGImage::SetSVG(UWidgetSVG* InSVG)
+{
+	SVG = InSVG;
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetSVG(SVG);
+	}
+}
+
+void UWidgetSVGImage::SetColorAndOpacity(FLinearColor InColorAndOpacity)
+{
+	ColorAndOpacity = InColorAndOpacity;
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetTint(ColorAndOpacity);
+	}
+}
+
+void UWidgetSVGImage::SetFit(EWidgetSVGFit InFit)
+{
+	Fit = InFit;
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetFit(Fit);
+	}
+}
+
+void UWidgetSVGImage::SetImageSize(FVector2D InImageSize)
+{
+	bOverrideImageSize = true;
+	ImageSize = InImageSize;
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetDesiredSizeOverride(ImageSize);
+	}
+}
+
+void UWidgetSVGImage::ClearImageSize()
+{
+	bOverrideImageSize = false;
+	if (MySVGImage.IsValid())
+	{
+		MySVGImage->SetDesiredSizeOverride(TOptional<FVector2D>());
+	}
+}
+
+#if WITH_EDITOR
+const FText UWidgetSVGImage::GetPaletteCategory()
+{
+	return LOCTEXT("PaletteCategory", "NameTBD");
+}
+#endif
+
+#undef LOCTEXT_NAMESPACE
