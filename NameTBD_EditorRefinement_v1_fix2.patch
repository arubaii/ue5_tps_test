+			PickLabelWindow->MoveWindowTo(ScreenPosition + FVector2D(18.0, 18.0));
+			if (!PickLabelWindow->IsVisible())
+			{
+				PickLabelWindow->ShowWindow();
+			}
+		}
+		else if (PickLabelWindow->IsVisible())
+		{
+			PickLabelWindow->HideWindow();
+		}
+	}
+}
