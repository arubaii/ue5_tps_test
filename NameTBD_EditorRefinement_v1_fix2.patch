+/**
+ * Watches the mouse everywhere while a Preview Target is being picked: the widget under it in the designer's preview is
+ * named by the cursor, and a click on it picks it - the click taken, so the designer doesn't also select it. The cursor
+ * is an eyedropper the whole time; Escape calls the pick off. Registered only while a pick waits.
+ */
+class FWidgetAnimTargetPickInput : public IInputProcessor
+{
+public:
+
+	explicit FWidgetAnimTargetPickInput(TWeakPtr<SWidgetAnimTimeline> InPanel)
+		: Panel(InPanel)
+	{
+	}
+
+	virtual void Tick(const float DeltaTime, FSlateApplication& SlateApp, TSharedRef<ICursor> Cursor) override
+	{
+		const TSharedPtr<SWidgetAnimTimeline> Pinned = Panel.Pin();
+		if (Pinned && Pinned->IsPickingAnyTarget())
+		{
+			Cursor->SetType(EMouseCursor::EyeDropper);
+		}
+	}
+
+	virtual bool HandleMouseMoveEvent(FSlateApplication& SlateApp, const FPointerEvent& MouseEvent) override
+	{
+		if (const TSharedPtr<SWidgetAnimTimeline> Pinned = Panel.Pin())
+		{
+			Pinned->UpdatePickHover(MouseEvent.GetScreenSpacePosition());
+		}
+		return false;
+	}
+
+	virtual bool HandleMouseButtonDownEvent(FSlateApplication& SlateApp, const FPointerEvent& MouseEvent) override
+	{
+		const TSharedPtr<SWidgetAnimTimeline> Pinned = Panel.Pin();
+		if (!Pinned || MouseEvent.GetEffectingButton() != EKeys::LeftMouseButton)
+		{
+			return false;
+		}
+		Pinned->UpdatePickHover(MouseEvent.GetScreenSpacePosition());
+		return Pinned->CommitPickHover();
+	}
+
+	virtual bool HandleKeyDownEvent(FSlateApplication& SlateApp, const FKeyEvent& InKeyEvent) override
+	{
+		const TSharedPtr<SWidgetAnimTimeline> Pinned = Panel.Pin();
+		if (Pinned && Pinned->IsPickingAnyTarget() && InKeyEvent.GetKey() == EKeys::Escape)
+		{
+			Pinned->CancelTargetPick();
+			return true;
+		}
+		return false;
+	}
+
+	virtual const TCHAR* GetDebugName() const override { return TEXT("WidgetAnimTargetPick"); }
+
+private:
+
+	TWeakPtr<SWidgetAnimTimeline> Panel;
+};
