+UWidget* SWidgetAnimTimeline::FindPreviewWidgetAt(const FVector2D& ScreenPosition, FString& OutOption) const
+{
+	OutOption.Reset();
+
+	UUserWidget* Root = Source.IsValid() ? Source->GetPreviewRoot() : nullptr;
+	const TSharedPtr<SWidget> RootSlate = Root ? Root->GetCachedWidget() : nullptr;
+	if (!Root || !RootSlate.IsValid() || !FSlateApplication::IsInitialized())
+	{
+		return nullptr;
+	}
+
+	// Only over the designer's preview: the window under the mouse is the preview's, and the mouse isn't over this panel
+	// (docked in the same window, it may sit over the preview's stretch of it).
+	FSlateApplication& Slate = FSlateApplication::Get();
+	const FWidgetPath Path = Slate.LocateWindowUnderMouse(ScreenPosition, Slate.GetInteractiveTopLevelWindows(), /*bIgnoreEnabledStatus=*/true);
+	if (!Path.IsValid() || &Path.GetWindow().Get() != Slate.FindWidgetWindow(RootSlate.ToSharedRef()).Get())
+	{
+		return nullptr;
+	}
+	for (int32 Index = 0; Index < Path.Widgets.Num(); ++Index)
+	{
+		if (&Path.Widgets[Index].Widget.Get() == this)
+		{
+			return nullptr;
+		}
+	}
+	if (!Root->GetCachedGeometry().IsUnderLocation(ScreenPosition))
+	{
+		return nullptr;
+	}
+
+	// The smallest visible widget under the mouse that can be a target - by where each is laid out, rather than by
+	// Slate's hit testing, which the designer's own overlays may take over.
+	UWidget* Best = nullptr;
+	FString BestOption;
+	double BestArea = TNumericLimits<double>::Max();
+	if (Root->WidgetTree)
+	{
+		Root->WidgetTree->ForEachWidget([this, &ScreenPosition, &Best, &BestOption, &BestArea](UWidget* Candidate)
+		{
+			const TSharedPtr<SWidget> CandidateSlate = Candidate ? Candidate->GetCachedWidget() : nullptr;
+			if (!CandidateSlate.IsValid() || !CandidateSlate->GetVisibility().IsVisible())
+			{
+				return;
+			}
+			const FGeometry& Geometry = Candidate->GetCachedGeometry();
+			if (!Geometry.IsUnderLocation(ScreenPosition))
+			{
+				return;
+			}
+			const FVector2D Extent(Geometry.GetAbsoluteSize());
+			const double Area = Extent.X * Extent.Y;
+			if (Area < BestArea)
+			{
+				const FString Option = Source->FindTargetOptionFor(Candidate);
+				if (!Option.IsEmpty())
+				{
+					Best = Candidate;
+					BestOption = Option;
+					BestArea = Area;
+				}
+			}
+		});
+	}
+
+	if (!Best)
+	{
+		Best = Root;
+		BestOption = Source->FindTargetOptionFor(Root);
+	}
+	OutOption = BestOption;
+	return OutOption.IsEmpty() ? nullptr : Best;
+}
