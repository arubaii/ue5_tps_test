+			TSharedPtr<SWidget> Walk = Preview ? Preview->GetCachedWidget() : nullptr;
+			while (Walk.IsValid() && Walk->GetType() != GetDesignerType())
+			{
+				Walk = Walk->GetParentWidget();
+			}
+			DesignerWidget = Walk;
