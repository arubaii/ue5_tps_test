+		int32 WidthOfInputType(const FString& Type)
+		{
+			const FString Key = Normalize(Type);
+			if (Key.Contains(TEXT("scalar")) || Key == TEXT("float") || Key == TEXT("float1"))
+			{
+				return 1;
+			}
+			if (Key.Contains(TEXT("2")))
+			{
+				return 2;
+			}
+			if (Key.Contains(TEXT("3")))
+			{
+				return 3;
+			}
+			if (Key.Contains(TEXT("4")))
+			{
+				return 4;
+			}
+			return 0;
+		}
