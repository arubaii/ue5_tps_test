+
+		class FPreparer
+		{
+		public:
+			FPreparer(FGraph& InGraph, int32 InDepth)
+				: Out(InGraph)
+				, Level(InDepth)
+			{
+			}
+
+			void Run(const TSharedPtr<FJsonObject>& In)
+			{
+				TSharedPtr<FJsonObject> Copy = DeepCopy(In);
+				NameTBDAIHelpers::ExpandThemeTokens(Copy, NameTBDAIHelpers::IsDark(FString()));
+				ReadForm(Copy);
+				ExpandMacros();
+				Inline();
+				MakeNodes();
+				MakeWires();
