+	TArray<FString> FGraph::WarningLines() const
+	{
+		TArray<FString> Lines;
+		for (const FProblem& Problem : Problems)
+		{
+			if (!Problem.bError)
+			{
+				Lines.AddUnique(ProblemLine(*this, Problem));
+			}
+		}
+		return Lines;
+	}
