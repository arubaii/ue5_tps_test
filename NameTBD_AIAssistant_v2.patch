+    {"id": "p3", "type": "AppendVector", "inputs": {"A": "p", "B": 0}},
+    {"id": "n", "type": "Noise", "props": {"Scale": 1, "Levels": 3, "OutputMin": 0, "OutputMax": 1, "Quality": 1}, "inputs": {"Position": "p3"}}
+   ]
+  },
+  "time_wave": {
+   "about": "a value waving between Min and Max, Speed times a second (pulses, breathing)",
+   "in": {"Speed": {"def": 1}, "Min": {"def": 0}, "Max": {"def": 1}, "Phase": {"def": 0}},
+   "out": {"Value": "v"},
+   "nodes": [
+    {"id": "t", "type": "Time"},
+    {"id": "ts", "type": "Multiply", "inputs": {"A": "t", "B": "$Speed"}},
+    {"id": "tp", "type": "Add", "inputs": {"A": "ts", "B": "$Phase"}},
+    {"id": "s", "type": "Sine", "inputs": {"Input": "tp"}},
+    {"id": "h", "type": "Multiply", "inputs": {"A": "s", "B": 0.5}},
+    {"id": "n", "type": "Add", "inputs": {"A": "h", "B": 0.5}},
+    {"id": "v", "type": "LinearInterpolate", "inputs": {"A": "$Min", "B": "$Max", "Alpha": "n"}}
+   ]
+  },
+  "uv_tile": {
+   "about": "UV tiled (Tiling [u, v] or a number), offset (Offset [x, y]) and scrolling (Speed [x, y] per second)",
+   "in": {"UV": {"def": "$uv"}, "Tiling": {"def": [1, 1]}, "Offset": {"def": [0, 0]}, "Speed": {"def": [0, 0]}},
+   "out": {"UV": "r"},
+   "nodes": [
+    {"id": "t", "type": "Time"},
+    {"id": "mv", "type": "Multiply", "inputs": {"A": "t", "B": "$Speed"}},
+    {"id": "tl", "type": "Multiply", "inputs": {"A": "$UV", "B": "$Tiling"}},
+    {"id": "o", "type": "Add", "inputs": {"A": "tl", "B": "$Offset"}},
+    {"id": "r", "type": "Add", "inputs": {"A": "o", "B": "mv"}}
+   ]
+  },
+  "band": {
+   "about": "a soft straight band (shimmer, sweep) across the widget at Angle, centered at Position 0..1; Speed > 0 sweeps it (loops)",
+   "in": {"UV": {"def": "$uv"}, "Angle": {"def": 30}, "Position": {"def": 0.5}, "Width": {"def": 0.15}, "Softness": {"def": 0.1}, "Speed": {"def": 0}},
+   "out": {"Mask": "m"},
+   "nodes": [
+    {"id": "ac", "type": "Divide", "inputs": {"A": "$Angle", "B": 360}},
+    {"id": "cx", "type": "Cosine", "inputs": {"Input": "ac"}},
+    {"id": "sy", "type": "Sine", "inputs": {"Input": "ac"}},
+    {"id": "dir", "type": "AppendVector", "inputs": {"A": "cx", "B": "sy"}},
+    {"id": "c", "type": "Subtract", "inputs": {"A": "$UV", "B": [0.5, 0.5]}},
+    {"id": "dt", "type": "DotProduct", "inputs": {"A": "c", "B": "dir"}},
+    {"id": "t", "type": "Add", "inputs": {"A": "dt", "B": 0.5}},
+    {"id": "tm", "type": "Time"},
+    {"id": "mv", "type": "Multiply", "inputs": {"A": "tm", "B": "$Speed"}},
+    {"id": "pm", "type": "Add", "inputs": {"A": "$Position", "B": "mv"}},
+    {"id": "pos", "type": "Frac", "inputs": {"Input": "pm"}},
+    {"id": "df", "type": "Subtract", "inputs": {"A": "t", "B": "pos"}},
+    {"id": "a", "type": "Abs", "inputs": {"Input": "df"}},
+    {"id": "hw", "type": "Multiply", "inputs": {"A": "$Width", "B": 0.5}},
+    {"id": "e", "type": "Add", "inputs": {"A": "hw", "B": "$Softness"}},
+    {"id": "s", "type": "SmoothStep", "inputs": {"Min": "hw", "Max": "e", "Value": "a"}},
+    {"id": "m", "type": "OneMinus", "inputs": {"Input": "s"}}
+   ]
+  },
+  "stripes": {
+   "about": "repeating soft stripes (scanlines, hazard bars): Count across the widget at Angle (90 = horizontal lines), Width 0..1 of each period, Speed scrolls them",
+   "in": {"UV": {"def": "$uv"}, "Count": {"def": 20}, "Angle": {"def": 90}, "Width": {"def": 0.5}, "Softness": {"def": 0.1}, "Speed": {"def": 0}},
+   "out": {"Mask": "m"},
+   "nodes": [
+    {"id": "ac", "type": "Divide", "inputs": {"A": "$Angle", "B": 360}},
+    {"id": "cx", "type": "Cosine", "inputs": {"Input": "ac"}},
+    {"id": "sy", "type": "Sine", "inputs": {"Input": "ac"}},
+    {"id": "dir", "type": "AppendVector", "inputs": {"A": "cx", "B": "sy"}},
+    {"id": "dt", "type": "DotProduct", "inputs": {"A": "$UV", "B": "dir"}},
+    {"id": "sc", "type": "Multiply", "inputs": {"A": "dt", "B": "$Count"}},
+    {"id": "tm", "type": "Time"},
+    {"id": "mv", "type": "Multiply", "inputs": {"A": "tm", "B": "$Speed"}},
+    {"id": "x", "type": "Add", "inputs": {"A": "sc", "B": "mv"}},
+    {"id": "f", "type": "Frac", "inputs": {"Input": "x"}},
+    {"id": "d", "type": "Subtract", "inputs": {"A": "f", "B": 0.5}},
+    {"id": "a", "type": "Abs", "inputs": {"Input": "d"}},
+    {"id": "a2", "type": "Multiply", "inputs": {"A": "a", "B": 2}},
+    {"id": "e", "type": "Add", "inputs": {"A": "$Width", "B": "$Softness"}},
+    {"id": "s", "type": "SmoothStep", "inputs": {"Min": "$Width", "Max": "e", "Value": "a2"}},
+    {"id": "m", "type": "OneMinus", "inputs": {"Input": "s"}}
+   ]
+  },
+  "remap": {
+   "about": "Value from InMin..InMax to OutMin..OutMax (clamped)",
+   "in": {"Value": {"def": 0}, "InMin": {"def": 0}, "InMax": {"def": 1}, "OutMin": {"def": 0}, "OutMax": {"def": 1}},
+   "out": {"Value": "r"},
+   "nodes": [
+    {"id": "a", "type": "Subtract", "inputs": {"A": "$Value", "B": "$InMin"}},
+    {"id": "b", "type": "Subtract", "inputs": {"A": "$InMax", "B": "$InMin"}},
+    {"id": "n", "type": "Divide", "inputs": {"A": "a", "B": "b"}},
+    {"id": "s", "type": "Saturate", "inputs": {"Input": "n"}},
+    {"id": "r", "type": "LinearInterpolate", "inputs": {"A": "$OutMin", "B": "$OutMax", "Alpha": "s"}}
+   ]
+  }
+ }
+}
