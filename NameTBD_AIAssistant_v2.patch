+{
+ "about": "The curated node catalog the material validator (NameTBDAIMaterialGraph) checks graphs against. Pin and output names are matched against the engine's own (reflection) at run time; 'aka' are names models often use instead. 'out' is the output width rule: a number, 'max:Pins' (inputs broadcast, scalars mix with anything), 'same:Pin', 'sum:Pins' (AppendVector), 'mask' (ComponentMask channels). A pin with 'def' is optional (the engine uses that value when it isn't wired); 'w' is the width a pin takes: '1', '2', '3', '1|out' (scalar or the node's own width), 'any'.",
+ "nodes": {
+  "Add": {"cat": "math", "about": "A + B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Plus", "Sum"]},
+  "Subtract": {"cat": "math", "about": "A - B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Sub", "Minus", "Difference"]},
+  "Multiply": {"cat": "math", "about": "A * B (a scalar scales a vector)", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Mul", "Mult", "Times", "Product", "Scale"]},
+  "Divide": {"cat": "math", "about": "A / B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Div", "Quotient"]},
+  "LinearInterpolate": {"cat": "math", "about": "Lerp: A where Alpha=0, B where Alpha=1", "in": [{"pin": "A", "aka": ["From", "X", "Start"]}, {"pin": "B", "aka": ["To", "Y", "End"]}, {"pin": "Alpha", "aka": ["T", "Factor", "Amount", "S", "Mix", "Weight", "Blend"], "w": "1|out"}], "out": "max:A,B", "aka": ["Lerp", "Mix", "Blend", "Interpolate"], "props": {"alpha": "ConstAlpha"}},
+  "OneMinus": {"cat": "math", "about": "1 - Input", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Invert", "Inverse", "Complement"]},
+  "Saturate": {"cat": "math", "about": "clamps to 0..1", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Clamp01"]},
+  "Clamp": {"cat": "math", "about": "Input clamped to Min..Max", "in": [{"pin": "Input"}, {"pin": "Min", "def": 0, "w": "1|out"}, {"pin": "Max", "def": 1, "w": "1|out"}], "out": "same:Input", "props": {"min": "MinDefault", "max": "MaxDefault"}},
+  "Abs": {"cat": "math", "about": "absolute value", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Absolute"]},
+  "Frac": {"cat": "math", "about": "fractional part (repeats 0..1 - loops a ramp)", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Fract", "Fraction"]},
+  "Floor": {"cat": "math", "about": "rounds down", "in": [{"pin": "Input"}], "out": "same:Input"},
+  "Ceil": {"cat": "math", "about": "rounds up", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Ceiling"]},
+  "Round": {"cat": "math", "about": "rounds to nearest", "in": [{"pin": "Input"}], "out": "same:Input"},
+  "Sign": {"cat": "math", "about": "-1, 0 or 1", "in": [{"pin": "Input"}], "out": "same:Input"},
+  "SquareRoot": {"cat": "math", "about": "sqrt", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Sqrt"]},
+  "Power": {"cat": "math", "about": "Base ^ Exponent (sharpens a 0..1 mask when Exponent > 1)", "in": [{"pin": "Base", "aka": ["A", "X", "Value", "Input"]}, {"pin": "Exponent", "aka": ["Exp", "B", "Y", "Power"], "def": 2, "w": "1|out"}], "out": "same:Base", "aka": ["Pow"], "props": {"exponent": "ConstExponent"}},
+  "Max": {"cat": "math", "about": "larger of A and B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Maximum"]},
+  "Min": {"cat": "math", "about": "smaller of A and B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Minimum"]},
+  "Fmod": {"cat": "math", "about": "A modulo B", "in": [{"pin": "A"}, {"pin": "B"}], "out": "max:A,B", "aka": ["Mod", "Modulo"]},
+  "SmoothStep": {"cat": "math", "about": "0 below Min, 1 above Max, smooth between - soft edges", "in": [{"pin": "Min", "aka": ["Edge0", "Low", "From"], "def": 0}, {"pin": "Max", "aka": ["Edge1", "High", "To"], "def": 1}, {"pin": "Value", "aka": ["X", "Input", "T", "Alpha"]}], "out": "max:Min,Max,Value", "aka": ["Smooth"]},
+  "Step": {"cat": "math", "about": "1 where X >= Y, else 0 (hard edge)", "in": [{"pin": "Y", "aka": ["Edge", "Threshold"], "def": 0.5}, {"pin": "X", "aka": ["Value", "Input"]}], "out": "max:Y,X"},
+  "Sine": {"cat": "math", "about": "sin(2*pi*Input / Period); Period 1 by default, so Input = Time * Speed waves Speed times a second", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Sin"], "props": {"period": "Period"}},
+  "Cosine": {"cat": "math", "about": "cos(2*pi*Input / Period)", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["Cos"], "props": {"period": "Period"}},
+  "Arctangent2": {"cat": "math", "about": "atan2(Y, X) in radians - angle around a center (conic sweeps)", "in": [{"pin": "Y"}, {"pin": "X"}], "out": "max:Y,X", "aka": ["Atan2", "Arctan2"]},
+  "Distance": {"cat": "math", "about": "distance between A and B (UV to a center = round shapes)", "in": [{"pin": "A"}, {"pin": "B"}], "out": "1", "aka": ["Dist"]},
+  "DotProduct": {"cat": "math", "about": "dot(A, B)", "in": [{"pin": "A"}, {"pin": "B"}], "out": "1", "aka": ["Dot"]},
+  "CrossProduct": {"cat": "math", "about": "cross(A, B) of float3s", "in": [{"pin": "A", "w": "3"}, {"pin": "B", "w": "3"}], "out": "3", "aka": ["Cross"]},
+  "Normalize": {"cat": "math", "about": "unit-length vector", "in": [{"pin": "VectorInput", "aka": ["Input", "Vector", "A"]}], "out": "same:VectorInput"},
+  "ComponentMask": {"cat": "vector", "about": "keeps some channels: props {channels: \"rg\"} (or R/G/B/A true)", "in": [{"pin": "Input"}], "out": "mask", "aka": ["Mask", "Swizzle", "Channels"]},
+  "AppendVector": {"cat": "vector", "about": "joins A and B into a wider vector (float2 + float = float3)", "in": [{"pin": "A"}, {"pin": "B"}], "out": "sum:A,B", "aka": ["Append", "Combine", "MakeFloat2", "MakeFloat3", "MakeFloat4", "Float2", "Float3", "MakeVector"]},
+  "TextureCoordinate": {"cat": "coords", "about": "UV of the widget: (0,0) top left, (1,1) bottom right; props {tiling: [u, v]}", "in": [], "out": "2", "aka": ["TexCoord", "UV", "UVs", "Coordinates", "TextureCoordinates"], "props": {"index": "CoordinateIndex", "utiling": "UTiling", "vtiling": "VTiling"}},
+  "Panner": {"cat": "coords", "about": "UV scrolling over time: props {speed: [x, y]}", "in": [{"pin": "Coordinate", "aka": ["UV", "UVs", "Coordinates"], "def": "uv", "w": "2"}, {"pin": "Time", "def": "time", "w": "1"}, {"pin": "Speed", "def": 0, "w": "any"}], "out": "2", "aka": ["Pan", "Scroll"], "props": {"speedx": "SpeedX", "speedy": "SpeedY"}},
+  "Rotator": {"cat": "coords", "about": "UV rotating over time around a center: props {speed, center: [x, y]}", "in": [{"pin": "Coordinate", "aka": ["UV", "UVs", "Coordinates"], "def": "uv", "w": "2"}, {"pin": "Time", "def": "time", "w": "1"}], "out": "2", "aka": ["Rotate", "Spin"], "props": {"centerx": "CenterX", "centery": "CenterY"}},
+  "Time": {"cat": "time", "about": "seconds since start (always rising) - drive motion with Time * Speed", "in": [], "out": "1", "aka": ["GameTime", "Seconds", "RealTime"], "props": {"period": "Period"}},
+  "Noise": {"cat": "pattern", "about": "smooth noise of a float3 Position (in UI: UV * Scale, appended with 0); props {Scale, Levels, OutputMin 0, OutputMax 1}", "in": [{"pin": "Position", "aka": ["UV", "P", "Coordinate", "Input"], "w": "3"}, {"pin": "FilterWidth", "def": 0, "w": "1"}], "out": "1", "aka": ["PerlinNoise", "SimplexNoise", "Perlin"], "props": {"min": "OutputMin", "max": "OutputMax", "levels": "Levels", "quality": "Quality", "turbulence": "bTurbulence", "function": "NoiseFunction"}},
+  "SphereMask": {"cat": "pattern", "about": "1 near B, falling to 0 at Radius from it (A = UV, B = center)", "in": [{"pin": "A"}, {"pin": "B"}, {"pin": "Radius", "def": 0.5, "w": "1"}, {"pin": "Hardness", "def": 0.5, "w": "1"}], "out": "1", "props": {"radius": "AttenuationRadius", "hardness": "HardnessPercent"}},
+  "VertexColor": {"cat": "input", "about": "the widget's tint / the particle's color: outputs RGB (default), R, G, B, A", "in": [], "out": "list", "aka": ["Tint", "WidgetColor", "ParticleColor"]},
+  "Constant": {"cat": "constant", "about": "a number (or just write the number as the input)", "in": [], "out": "1", "aka": ["Scalar", "Float", "Constant1Vector", "Number", "Value"], "props": {"value": "R"}},
+  "Constant2Vector": {"cat": "constant", "about": "a float2 (or write [x, y] as the input)", "in": [], "out": "list", "aka": ["Float2Constant", "Vector2", "Constant2"]},
+  "Constant3Vector": {"cat": "constant", "about": "an RGB color (or write \"#RRGGBB\" as the input)", "in": [], "out": "list", "aka": ["Color", "ConstantColor", "Vector3", "Float3Constant", "Constant3", "RGB"], "props": {"value": "Constant", "color": "Constant"}},
+  "Constant4Vector": {"cat": "constant", "about": "an RGBA value", "in": [], "out": "list", "aka": ["Vector4", "Float4Constant", "Constant4", "RGBA"], "props": {"value": "Constant", "color": "Constant"}},
+  "ScalarParameter": {"cat": "parameter", "about": "a number an instance can change: props {ParameterName, DefaultValue} - or write {\"param\": \"Name\", \"value\": 0.5} as any input", "in": [], "out": "1", "aka": ["Param", "FloatParameter", "ScalarParam", "Parameter", "NumberParameter"], "props": {"name": "ParameterName", "value": "DefaultValue", "default": "DefaultValue", "min": "SliderMin", "max": "SliderMax"}},
+  "VectorParameter": {"cat": "parameter", "about": "a color an instance can change: outputs RGB (default), R, G, B, A - or write {\"param\": \"Name\", \"value\": \"#hex\"} as any input", "in": [], "out": "list", "aka": ["ColorParameter", "ColorParam", "VectorParam", "LinearColorParameter"], "props": {"name": "ParameterName", "value": "DefaultValue", "default": "DefaultValue", "color": "DefaultValue"}},
+  "TextureSampleParameter2D": {"cat": "texture", "about": "a texture an instance can change: outputs RGB (default), R, G, B, A, RGBA; props {ParameterName, Texture}", "in": [{"pin": "UVs", "aka": ["UV", "Coordinates", "Coordinate", "TexCoord"], "def": "uv", "w": "2"}], "out": "list", "aka": ["TextureParameter", "TextureParam", "Texture2DParameter", "TextureSampleParameter"], "props": {"name": "ParameterName", "value": "Texture", "texture": "Texture"}},
+  "TextureSample": {"cat": "texture", "about": "a fixed texture: outputs RGB (default), R, G, B, A, RGBA; props {Texture}", "in": [{"pin": "UVs", "aka": ["UV", "Coordinates", "Coordinate", "TexCoord"], "def": "uv", "w": "2"}], "out": "list", "aka": ["Texture", "SampleTexture", "Texture2D", "TextureSample2D"]},
+  "Desaturation": {"cat": "color", "about": "toward grey by Fraction", "in": [{"pin": "Input", "w": "3"}, {"pin": "Fraction", "def": 1, "w": "1"}], "out": "3", "aka": ["Desaturate", "Grayscale", "Greyscale"]},
+  "ConstantBiasScale": {"cat": "math", "about": "(Input + Bias) * Scale - maps -1..1 to 0..1 with Bias 1, Scale 0.5", "in": [{"pin": "Input"}], "out": "same:Input", "aka": ["BiasScale"]},
+  "MaterialFunctionCall": {"cat": "function", "about": "a library Material Function (function: SoftCircle, RoundedRectSDF, PanningNoise, ColorRamp) or one by path; inputs/outputs by the function's own names", "in": [], "out": "function", "aka": ["Function", "FunctionCall", "MaterialFunction"]},
+  "Custom": {"cat": "custom", "about": "HLSL escape hatch: {code: \"return a * b;\", output: float1|float2|float3|float4, inputs {a: ref, b: ref}} - input names are the code's variables", "in": [], "out": "custom", "aka": ["CustomExpression", "HLSL", "Code", "CustomHLSL"], "props": {"code": "Code", "description": "Description"}},
+  "FunctionInput": {"cat": "hidden", "about": "a Material Function's input (function graphs only)", "in": [], "out": "input", "hide": true},
+  "FunctionOutput": {"cat": "hidden", "about": "a Material Function's output (function graphs only)", "in": [{"pin": "A"}], "out": "same:A", "hide": true}
+ },
+ "ui_errors": ["SceneTexture", "SceneColor", "SceneDepth", "PixelDepth", "DepthFade", "CustomDepth", "PostProcessInput", "LightVector", "SkyAtmosphereLightDirection", "DistanceFieldGradient", "DistanceToNearestSurface"],
+ "ui_warnings": ["WorldPosition", "CameraPositionWS", "CameraVectorWS", "ObjectPositionWS", "ActorPositionWS", "VertexNormalWS", "PixelNormalWS", "ReflectionVectorWS", "Fresnel", "ScreenPosition", "ViewSize"],
+ "hints": [
+  {"match": "arithmetic between types", "hint": "two inputs have different widths: mask the wider one (ComponentMask, channels \"rgb\") or AppendVector the narrower one; a scalar mixes with anything"},
+  {"match": "cannot cast from smaller type", "hint": "a narrower value went where a wider one is needed: AppendVector it up to the width (or use a wider source)"},
+  {"match": "implicit truncation", "hint": "a wider value went where a narrower one is needed: ComponentMask it down"},
+  {"match": "missing", "hint": "wire that input (a number works for most)"},
+  {"match": "undeclared identifier", "hint": "Custom code may only use its own inputs' names (case-sensitive) and HLSL built-ins"},
+  {"match": "syntax error", "hint": "Custom code is HLSL: statements end with ';' and it must return a value of its output width (float3(...) for float3)"},
+  {"match": "not supported", "hint": "this node doesn't work in a UI material (no scene, depth or world in UI): build it from UV, Time and maths"},
+  {"match": "domain", "hint": "this node doesn't work in a UI material: build it from UV, Time and maths"},
+  {"match": "texture", "hint": "give the texture (props {Texture: \"/Game/...\"}) or use a TextureSampleParameter2D"},
+  {"match": "x3206", "hint": "a wider value went where a narrower one is needed: ComponentMask it down"},
+  {"match": "x3017", "hint": "Custom code: a function or variable name isn't known - use the input names and HLSL built-ins"}
+ ]
+}
