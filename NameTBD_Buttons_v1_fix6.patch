+
+	// The slot and its content are unchanged; only where the button finds them is. Built again onto a live button.
+	if (MyButton.IsValid())
+	{
+		if (UButtonSlot* PartsSlot = Cast<UButtonSlot>(GetPartsSlot()))
+		{
+			PartsSlot->BuildSlot(MyButton.ToSharedRef());
+		}
+	}
+}
