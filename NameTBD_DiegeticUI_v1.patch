+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Components/WidgetComponent.h"
+
+class UMaterial;
+
+/**
+ * Create Screen Material (a Diegetic Screen's Details): a surface material a Widget Component can draw its widget with - the
+ * parameters it sets (SlateUI, TintColorAndOpacity, OpacityFromTexture) - with Screen Look's parameters on top (Brightness,
+ * ScanlineIntensity, ScanlineCount, Curvature, ChromaticAberration, Vignette, Flicker, Noise; see FDiegeticScreenLook).
+ * Unlit: the picture is its own light, so Brightness past 1 blooms. Built node by node (UMaterialEditingLibrary), the
+ * effects in three Custom nodes of plain HLSL with no includes, so it compiles wherever the engine's own widget materials do.
+ */
+namespace DiegeticScreenMaterial
+{
+	/**
+	 * Makes the material in Folder (a long package path, /Game/Diegetic) under a name of its own (M_DiegeticScreen, _1...), for
+	 * a screen drawn with BlendMode (Opaque, Masked or Transparent) and two-sided or not. Left unsaved, as a new asset is. Null,
+	 * with OutError, when it couldn't.
+	 */
+	UMaterial* Create(const FString& Folder, EWidgetBlendMode BlendMode, bool bTwoSided, FText& OutError);
+}
