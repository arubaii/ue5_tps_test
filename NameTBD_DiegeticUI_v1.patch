+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "DiegeticScreenMaterial.h"
+
+#include "AssetToolsModule.h"
+#include "Engine/Texture2D.h"
+#include "Factories/MaterialFactoryNew.h"
+#include "IAssetTools.h"
+#include "MaterialEditingLibrary.h"
+#include "Materials/Material.h"
+#include "Materials/MaterialExpressionComponentMask.h"
+#include "Materials/MaterialExpressionCustom.h"
+#include "Materials/MaterialExpressionScalarParameter.h"
+#include "Materials/MaterialExpressionTextureCoordinate.h"
+#include "Materials/MaterialExpressionTextureSampleParameter2D.h"
+#include "Materials/MaterialExpressionTime.h"
+#include "Materials/MaterialExpressionVectorParameter.h"
+#include "Misc/PackageName.h"
+#include "Modules/ModuleManager.h"
+
+#define LOCTEXT_NAMESPACE "DiegeticScreenMaterial"
+
+namespace DiegeticScreenMaterialPrivate
+{
+	/** The group Screen Look's parameters are listed under in a material instance. */
+	const FName LookGroup(TEXT("Screen Look"));
+
+	/** The parameters the Widget Component sets on its material (UWidgetComponent::UpdateMaterialInstanceParameters). */
+	const FName SlateUIParam(TEXT("SlateUI"));
+	const FName TintParam(TEXT("TintColorAndOpacity"));
+	const FName OpacityFromTextureParam(TEXT("OpacityFromTexture"));
+
+	/** The picture bulged toward the middle, as on a CRT. UV and Curvature in; a UV out. */
+	const TCHAR* WarpCode =
+		TEXT("float2 C = UV * 2.0 - 1.0;\n")
+		TEXT("C *= 1.0 + Curvature * dot(C, C);\n")
+		TEXT("return C * 0.5 + 0.5;");
+
+	/** Red and blue read from either side of the warped UV, pulled apart toward the edges. RG: red's UV, BA: blue's. */
+	const TCHAR* FringeCode =
+		TEXT("float2 D = UV - 0.5;\n")
+		TEXT("return float4(UV + D * Amount, UV - D * Amount);");
+
+	/**
+	 * Everything else, from the three samples: scan lines, vignette, flicker, grain, brightness, the tint and the opacity. Its
+	 * inputs are named apart from anything the material template defines (Time, Noise...).
+	 */
+	const TCHAR* ScreenCode =
+		TEXT("float Inside = step(0.0, UV.x) * step(UV.x, 1.0) * step(0.0, UV.y) * step(UV.y, 1.0);\n")
+		TEXT("float3 Color = float3(Red, Picture.g, Blue);\n")
+		TEXT("float Lines = 1.0 - saturate(ScanlineIntensity) * (0.5 + 0.5 * cos(UV.y * max(ScanlineCount, 1.0) * 6.2831853));\n")
+		TEXT("float2 Edge = saturate(Raw) * (1.0 - saturate(Raw));\n")
+		TEXT("float Corner = saturate(Edge.x * Edge.y * 16.0);\n")
+		TEXT("float Shade = lerp(1.0, sqrt(Corner), saturate(VignetteAmount));\n")
+		TEXT("float Frame = floor(Seconds * 24.0);\n")
+		TEXT("float Flick = 1.0 - saturate(FlickerAmount) * frac(sin(Frame * 12.9898) * 43758.5453);\n")
+		TEXT("float Grain = frac(sin(dot(floor(Raw * 512.0) + Frame, float2(12.9898, 78.233))) * 43758.5453) - 0.5;\n")
+		TEXT("Color = max(Color + Grain * saturate(NoiseAmount), 0.0) * Lines * Shade * Flick * max(Brightness, 0.0) * Tint.rgb;\n")
+		TEXT("float Alpha = lerp(1.0, PictureAlpha, OpacityFromTexture) * Tint.a * Inside;\n")
+		TEXT("return float4(Color * Inside, Alpha);");
+
+	template <typename T>
+	T* Make(UMaterial* Material, int32 X, int32 Y)
+	{
+		return Cast<T>(UMaterialEditingLibrary::CreateMaterialExpression(Material, T::StaticClass(), X, Y));
+	}
+
+	UMaterialExpressionCustom* MakeCustom(UMaterial* Material, int32 X, int32 Y, const TCHAR* Description, const TCHAR* Code,
+		ECustomMaterialOutputType Output, std::initializer_list<const TCHAR*> InputNames)
+	{
+		UMaterialExpressionCustom* Custom = Make<UMaterialExpressionCustom>(Material, X, Y);
+		if (Custom)
+		{
+			Custom->Description = Description;
+			Custom->Code = Code;
+			Custom->OutputType = Output;
+			Custom->Inputs.Reset();
+			for (const TCHAR* InputName : InputNames)
+			{
+				FCustomInput Input;
+				Input.InputName = FName(InputName);
+				Custom->Inputs.Add(Input);
+			}
+		}
+		return Custom;
+	}
+
+	UMaterialExpressionScalarParameter* MakeScalar(UMaterial* Material, int32 X, int32 Y, FName ParamName, float Default, FName Group)
+	{
+		UMaterialExpressionScalarParameter* Param = Make<UMaterialExpressionScalarParameter>(Material, X, Y);
+		if (Param)
+		{
+			Param->ParameterName = ParamName;
+			Param->DefaultValue = Default;
+			Param->Group = Group;
+		}
+		return Param;
+	}
+
+	UMaterialExpressionTextureSampleParameter2D* MakeSample(UMaterial* Material, int32 X, int32 Y, UTexture* Default)
+	{
+		UMaterialExpressionTextureSampleParameter2D* Sample = Make<UMaterialExpressionTextureSampleParameter2D>(Material, X, Y);
+		if (Sample)
+		{
+			// The same parameter three times: the Widget Component sets it once, and all three read its render target.
+			Sample->ParameterName = SlateUIParam;
+			Sample->Texture = Default;
+			Sample->SamplerType = SAMPLERTYPE_Color;
+			// Clamped: the warp reads past the edges, which the screen code blacks out.
+			Sample->SamplerSource = SSM_Clamp_WorldGroupSettings;
+		}
+		return Sample;
+	}
+
+	UMaterialExpressionComponentMask* MakeMask(UMaterial* Material, int32 X, int32 Y, bool bR, bool bG, bool bB, bool bA)
+	{
+		UMaterialExpressionComponentMask* Mask = Make<UMaterialExpressionComponentMask>(Material, X, Y);
+		if (Mask)
+		{
+			Mask->R = bR ? 1 : 0;
+			Mask->G = bG ? 1 : 0;
+			Mask->B = bB ? 1 : 0;
+			Mask->A = bA ? 1 : 0;
+		}
+		return Mask;
+	}
+}
+
+UMaterial* DiegeticScreenMaterial::Create(const FString& Folder, EWidgetBlendMode BlendMode, bool bTwoSided, FText& OutError)
+{
+	using namespace DiegeticScreenMaterialPrivate;
+
+	IAssetTools& AssetTools = FModuleManager::LoadModuleChecked<FAssetToolsModule>(TEXT("AssetTools")).Get();
+	FString PackageName;
+	FString AssetName;
+	AssetTools.CreateUniqueAssetName(Folder / TEXT("M_DiegeticScreen"), FString(), PackageName, AssetName);
+
+	UMaterialFactoryNew* Factory = NewObject<UMaterialFactoryNew>();
+	UMaterial* Material = Cast<UMaterial>(AssetTools.CreateAsset(AssetName, FPackageName::GetLongPackagePath(PackageName), UMaterial::StaticClass(), Factory));
+	if (!Material)
+	{
+		OutError = FText::Format(LOCTEXT("CouldNotCreate", "couldn't create {0} in {1}."), FText::FromString(AssetName), FText::FromString(Folder));
+		return nullptr;
+	}
+
+	Material->MaterialDomain = MD_Surface;
+	Material->SetShadingModel(MSM_Unlit);
+	Material->BlendMode = BlendMode == EWidgetBlendMode::Opaque ? BLEND_Opaque : BlendMode == EWidgetBlendMode::Masked ? BLEND_Masked : BLEND_Translucent;
+	Material->TwoSided = bTwoSided;
+
+	UTexture* DefaultTexture = LoadObject<UTexture2D>(nullptr, TEXT("/Engine/EngineResources/DefaultTexture.DefaultTexture"));
+
+	// Left to right: inputs and parameters, the warp, the samples, the screen, the outputs.
+	UMaterialExpressionTextureCoordinate* UV = Make<UMaterialExpressionTextureCoordinate>(Material, -1800, 0);
+	UMaterialExpressionTime* Time = Make<UMaterialExpressionTime>(Material, -1800, 120);
+	UMaterialExpressionScalarParameter* Curvature = MakeScalar(Material, -1800, 240, TEXT("Curvature"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* Fringe = MakeScalar(Material, -1800, 360, TEXT("ChromaticAberration"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* ScanlineIntensity = MakeScalar(Material, -700, 400, TEXT("ScanlineIntensity"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* ScanlineCount = MakeScalar(Material, -700, 500, TEXT("ScanlineCount"), 360.f, LookGroup);
+	UMaterialExpressionScalarParameter* Vignette = MakeScalar(Material, -700, 600, TEXT("Vignette"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* Flicker = MakeScalar(Material, -700, 700, TEXT("Flicker"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* Noise = MakeScalar(Material, -700, 800, TEXT("Noise"), 0.f, LookGroup);
+	UMaterialExpressionScalarParameter* Brightness = MakeScalar(Material, -700, 900, TEXT("Brightness"), 1.f, LookGroup);
+	UMaterialExpressionScalarParameter* OpacityFromTexture = MakeScalar(Material, -700, 1000, OpacityFromTextureParam, 1.f, NAME_None);
+	UMaterialExpressionVectorParameter* Tint = Make<UMaterialExpressionVectorParameter>(Material, -700, 1100);
+	if (Tint)
+	{
+		Tint->ParameterName = TintParam;
+		Tint->DefaultValue = FLinearColor::White;
+	}
+
+	UMaterialExpressionCustom* Warp = MakeCustom(Material, -1500, 0, TEXT("Curvature"), WarpCode, CMOT_Float2, { TEXT("UV"), TEXT("Curvature") });
+	UMaterialExpressionCustom* Split = MakeCustom(Material, -1250, 200, TEXT("Chromatic Aberration"), FringeCode, CMOT_Float4, { TEXT("UV"), TEXT("Amount") });
+	UMaterialExpressionComponentMask* RedUV = MakeMask(Material, -1050, 150, true, true, false, false);
+	UMaterialExpressionComponentMask* BlueUV = MakeMask(Material, -1050, 300, false, false, true, true);
+	UMaterialExpressionTextureSampleParameter2D* CenterSample = MakeSample(Material, -900, -200, DefaultTexture);
+	UMaterialExpressionTextureSampleParameter2D* RedSample = MakeSample(Material, -900, 50, DefaultTexture);
+	UMaterialExpressionTextureSampleParameter2D* BlueSample = MakeSample(Material, -900, 250, DefaultTexture);
+	UMaterialExpressionCustom* Screen = MakeCustom(Material, -400, 200, TEXT("Diegetic Screen"), ScreenCode, CMOT_Float4,
+		{ TEXT("Picture"), TEXT("PictureAlpha"), TEXT("Red"), TEXT("Blue"), TEXT("UV"), TEXT("Raw"), TEXT("Seconds"), TEXT("Tint"),
+		  TEXT("OpacityFromTexture"), TEXT("ScanlineIntensity"), TEXT("ScanlineCount"), TEXT("VignetteAmount"), TEXT("FlickerAmount"),
+		  TEXT("NoiseAmount"), TEXT("Brightness") });
+	UMaterialExpressionComponentMask* ColorOut = MakeMask(Material, -150, 150, true, true, true, false);
+	UMaterialExpressionComponentMask* AlphaOut = MakeMask(Material, -150, 300, false, false, false, true);
+
+	const bool bMade = UV && Time && Curvature && Fringe && ScanlineIntensity && ScanlineCount && Vignette && Flicker && Noise && Brightness
+		&& OpacityFromTexture && Tint && Warp && Split && RedUV && BlueUV && CenterSample && RedSample && BlueSample && Screen && ColorOut && AlphaOut;
+	if (!bMade)
+	{
+		OutError = LOCTEXT("CouldNotBuild", "couldn't make its nodes.");
+		return nullptr;
+	}
+
+	auto Wire = [](UMaterialExpression* From, const TCHAR* FromOutput, UMaterialExpression* To, const TCHAR* ToInput)
+	{
+		return UMaterialEditingLibrary::ConnectMaterialExpressions(From, FromOutput, To, ToInput);
+	};
+	bool bWired = true;
+	bWired &= Wire(UV, TEXT(""), Warp, TEXT("UV"));
+	bWired &= Wire(Curvature, TEXT(""), Warp, TEXT("Curvature"));
+	bWired &= Wire(Warp, TEXT(""), Split, TEXT("UV"));
+	bWired &= Wire(Fringe, TEXT(""), Split, TEXT("Amount"));
+	bWired &= Wire(Split, TEXT(""), RedUV, TEXT(""));
+	bWired &= Wire(Split, TEXT(""), BlueUV, TEXT(""));
+	bWired &= Wire(Warp, TEXT(""), CenterSample, TEXT("UVs"));
+	bWired &= Wire(RedUV, TEXT(""), RedSample, TEXT("UVs"));
+	bWired &= Wire(BlueUV, TEXT(""), BlueSample, TEXT("UVs"));
+	bWired &= Wire(CenterSample, TEXT("RGB"), Screen, TEXT("Picture"));
+	bWired &= Wire(CenterSample, TEXT("A"), Screen, TEXT("PictureAlpha"));
+	bWired &= Wire(RedSample, TEXT("R"), Screen, TEXT("Red"));
+	bWired &= Wire(BlueSample, TEXT("B"), Screen, TEXT("Blue"));
+	bWired &= Wire(Warp, TEXT(""), Screen, TEXT("UV"));
+	bWired &= Wire(UV, TEXT(""), Screen, TEXT("Raw"));
+	bWired &= Wire(Time, TEXT(""), Screen, TEXT("Seconds"));
+	bWired &= Wire(Tint, TEXT(""), Screen, TEXT("Tint"));
+	bWired &= Wire(OpacityFromTexture, TEXT(""), Screen, TEXT("OpacityFromTexture"));
+	bWired &= Wire(ScanlineIntensity, TEXT(""), Screen, TEXT("ScanlineIntensity"));
+	bWired &= Wire(ScanlineCount, TEXT(""), Screen, TEXT("ScanlineCount"));
+	bWired &= Wire(Vignette, TEXT(""), Screen, TEXT("VignetteAmount"));
+	bWired &= Wire(Flicker, TEXT(""), Screen, TEXT("FlickerAmount"));
+	bWired &= Wire(Noise, TEXT(""), Screen, TEXT("NoiseAmount"));
+	bWired &= Wire(Brightness, TEXT(""), Screen, TEXT("Brightness"));
+	bWired &= Wire(Screen, TEXT(""), ColorOut, TEXT(""));
+	bWired &= Wire(Screen, TEXT(""), AlphaOut, TEXT(""));
+	bWired &= UMaterialEditingLibrary::ConnectMaterialProperty(ColorOut, TEXT(""), MP_EmissiveColor);
+	if (BlendMode == EWidgetBlendMode::Transparent)
+	{
+		bWired &= UMaterialEditingLibrary::ConnectMaterialProperty(AlphaOut, TEXT(""), MP_Opacity);
+	}
+	else if (BlendMode == EWidgetBlendMode::Masked)
+	{
+		bWired &= UMaterialEditingLibrary::ConnectMaterialProperty(AlphaOut, TEXT(""), MP_OpacityMask);
+	}
+	if (!bWired)
+	{
+		OutError = LOCTEXT("CouldNotWire", "couldn't wire its nodes (see the Output Log).");
+		return nullptr;
+	}
+
+	UMaterialEditingLibrary::RecompileMaterial(Material);
+	Material->MarkPackageDirty();
+	return Material;
+}
+
+#undef LOCTEXT_NAMESPACE
