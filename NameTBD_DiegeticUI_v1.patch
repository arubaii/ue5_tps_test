+ * screen material (DiegeticScreenMaterial.h) and gives it to the selected screens through the panel's Materials handle, so
+ * it is one undo step and reaches a Blueprint's component template as any Details edit does.
+ */
+class FDiegeticScreenDetails : public IDetailCustomization
+{
+public:
+	static TSharedRef<IDetailCustomization> MakeInstance();
+
+	virtual void CustomizeDetails(IDetailLayoutBuilder& DetailBuilder) override;
+
+private:
+	FReply OnCreateScreenMaterial();
+
+	TArray<TWeakObjectPtr<UObject>> Objects;
+	TSharedPtr<IPropertyHandle> MaterialsHandle;
+};
