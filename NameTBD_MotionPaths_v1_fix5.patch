+bool SWidgetAnimTimeline::BeginKeyHandleDrag(int32 LayerIndex, int32 KeyIndex)
+{
+	if (!BeginKeyPositionDrag(LayerIndex, KeyIndex))
+	{
+		return false;
+	}
+	if (KeyPositionTransaction.IsValid())
+	{
+		// One drag, one undo step: named for what it does.
