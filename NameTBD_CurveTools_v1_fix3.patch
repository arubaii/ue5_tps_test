+				]
+				+ SHorizontalBox::Slot().AutoWidth().VAlign(VAlign_Center).Padding(FMargin(0.f, 2.f, 8.f, 2.f))
+				[
+					ToolChip(ETool::Pencil, FNameTBDStyle::ShapePencilIcon, LOCTEXT("PencilTool", "Pencil"), Tips::PencilToolTooltip())
+				]
+				+ SHorizontalBox::Slot().AutoWidth().VAlign(VAlign_Center).Padding(FMargin(0.f, 2.f, 4.f, 2.f))
+				[
+					SNew(STextBlock).Font(Font).Text(LOCTEXT("PencilFit", "Fit")).ToolTipText(Tips::PencilFitTooltip())
+				]
+				+ SHorizontalBox::Slot().AutoWidth().VAlign(VAlign_Center)
+				[
+					SNew(SBox)
+					.WidthOverride(60.f)
+					[
+						SNew(SNumericEntryBox<float>)
