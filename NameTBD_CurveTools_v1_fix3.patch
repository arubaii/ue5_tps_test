+	// While editing: the canvas tools here too (the toolbar above the shape has them as well), so they are always at hand.
+	{
+		using WidgetShapePathEditing::ETool;
+		auto ToolChip = [First](ETool Tool, FName Icon, const FText& Label, const FText& ToolTip)
+		{
+			FChip Chip;
+			Chip.Icon = Icon;
+			Chip.Label = Label;
+			Chip.ToolTip = ToolTip;
+			Chip.IsActive = [First, Tool]() { return First.IsValid() && WidgetShapePathEditing::GetState(First->GetFName()).Tool == Tool; };
+			Chip.OnClick = [First, Tool]()
+			{
+				if (First.IsValid())
+				{
+					WidgetShapePathEditing::GetState(First->GetFName()).Tool = Tool;
+				}
+			};
+			return MakeChip(Chip);
+		};
+		Category.AddCustomRow(Tips::CanvasToolsRow())
+			.Visibility(TAttribute<EVisibility>::CreateLambda([First]() { return WidgetShapePathEditing::IsEditing(First.Get()) ? EVisibility::Visible : EVisibility::Collapsed; }))
+			.NameContent()
+			.VAlign(VAlign_Center)
+			[
+				SNew(STextBlock).Font(Font).Text(Tips::CanvasToolsRow())
+			]
+			.ValueContent()
+			.MinDesiredWidth(280.f)
+			.VAlign(VAlign_Center)
+			[
+				SNew(SHorizontalBox)
+				+ SHorizontalBox::Slot().AutoWidth().VAlign(VAlign_Center).Padding(FMargin(0.f, 2.f, 4.f, 2.f))
+				[
+					ToolChip(ETool::Select, FNameTBDStyle::ShapeSelectIcon, LOCTEXT("SelectTool", "Select"), Tips::SelectToolTooltip())
+				]
+				+ SHorizontalBox::Slot().AutoWidth().VAlign(VAlign_Center).Padding(FMargin(0.f, 2.f, 4.f, 2.f))
+				[
