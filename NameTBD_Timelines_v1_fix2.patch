 			return FReply::Handled();
 		})
 		[
-			SNew(STextBlock)
-			.Font(FAppStyle::GetFontStyle("NormalFontBold"))
-			.ColorAndOpacity(FSlateColor::UseForeground())
-			.Text_Lambda([IsEditingExisting]()
-			{
