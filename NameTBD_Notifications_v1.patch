+	FNotificationStackSettings StackSettings;
+
+	FOnNotificationStackItem OnItemGone;
+	FOnNotificationStackItem OnItemClicked;
+	FOnNotificationStackItem OnItemSwiped;
+	FOnNotificationStackHover OnHoverChanged;
