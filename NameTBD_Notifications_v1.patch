+	{
+		Record->Request.Title = InTitle;
+	}
+	if (!InBody.IsEmpty())
+	{
+		Record->Request.Body = InBody;
+	}
+	PushViewToHost(*Record, false);
+	OnNotificationUpdated.Broadcast(Record->MakeView());
+	return true;
+}
