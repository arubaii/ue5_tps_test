 	const FName DockBesideTabIds[] = { TEXT("WidgetDetails"), TEXT("Inspector"), TEXT("DetailsTab"), TEXT("Details"), TEXT("PropertiesTab") };
+
+	/**
+	 * Hands the tab manager the very tab to dock beside, rather than an id for it to look up: an id search that misses
+	 * makes the tab manager float the new tab in a window of its own, which is exactly what docking is meant to avoid.
+	 */
+	class FBesideTab : public FTabManager::FSearchPreference
+	{
+	public:
+		explicit FBesideTab(const TSharedRef<SDockTab>& InBeside) : Beside(InBeside) {}
+
+		virtual TSharedPtr<SDockTab> Search(const FTabManager& Manager, FName PlaceholderId, const TSharedRef<SDockTab>& UnmanagedTab) const override
+		{
+			return Beside;
+		}
+
+	private:
+		TSharedRef<SDockTab> Beside;
+	};
+
+	/** Every tab in a widget tree. Tabs are their wells' children, so a Details tab behind another in its well is found too. */
+	void GatherTabs(const TSharedRef<SWidget>& Widget, TArray<TSharedRef<SDockTab>>& OutTabs, int32 Depth)
+	{
+		if (Depth > 256)
+		{
+			return;
+		}
+		if (Widget->GetType() == FName(TEXT("SDockTab")))
+		{
+			OutTabs.Add(StaticCastSharedRef<SDockTab>(Widget));
+		}
+		if (FChildren* Children = Widget->GetChildren())
+		{
+			for (int32 ChildIndex = 0; ChildIndex < Children->Num(); ++ChildIndex)
+			{
+				GatherTabs(Children->GetChildAt(ChildIndex), OutTabs, Depth + 1);
+			}
+		}
+	}
+
+	void GatherWindows(const TSharedRef<SWindow>& Window, TArray<TSharedRef<SWindow>>& OutWindows)
+	{
+		OutWindows.Add(Window);
+		for (const TSharedRef<SWindow>& Child : Window->GetChildWindows())
+		{
+			GatherWindows(Child, OutWindows);
+		}
+	}
+
+	/** -1 when the tab isn't a Details tab, else where its id falls in DockBesideTabIds (past the end for one only labeled so). */
+	int32 GetDetailsRank(const TSharedRef<SDockTab>& Tab)
+	{
+		if (Tab->GetTabRole() == ETabRole::MajorTab || Tab->GetLayoutIdentifier().TabType == ScriptDockedTabId)
+		{
+			return -1;
+		}
+		const FName TabType = Tab->GetLayoutIdentifier().TabType;
+		const int32 NumIds = static_cast<int32>(UE_ARRAY_COUNT(DockBesideTabIds));
+		for (int32 IdIndex = 0; IdIndex < NumIds; ++IdIndex)
+		{
+			if (TabType == DockBesideTabIds[IdIndex])
+			{
+				return IdIndex;
+			}
+		}
+		const FString TypeString = TabType.ToString();
+		if (TypeString.Contains(TEXT("Details")) || TypeString.Contains(TEXT("Inspector")) || Tab->GetTabLabel().ToString().Equals(TEXT("Details")))
+		{
+			return NumIds;
+		}
+		return -1;
+	}
+
+	/**
+	 * The Details tab of the editor the panel belongs to: one of that editor's own tabs if any (its tab manager is known),
+	 * else one in the panel's own window - never a Details tab of some other editor in another window.
+	 */
+	TSharedPtr<SDockTab> FindDetailsTab(const TSharedPtr<FTabManager>& EditorTabManager, const TSharedPtr<SWindow>& PanelWindow)
+	{
+		TArray<TSharedRef<SWindow>> Windows;
+		for (const TSharedRef<SWindow>& TopLevel : FSlateApplication::Get().GetTopLevelWindows())
+		{
+			GatherWindows(TopLevel, Windows);
+		}
+
+		TSharedPtr<SDockTab> Best;
+		int32 BestScore = 0;
+		for (const TSharedRef<SWindow>& Window : Windows)
+		{
+			TArray<TSharedRef<SDockTab>> Tabs;
+			GatherTabs(Window, Tabs, 0);
+			for (const TSharedRef<SDockTab>& Tab : Tabs)
+			{
+				const int32 Rank = GetDetailsRank(Tab);
+				if (Rank < 0)
+				{
+					continue;
+				}
+				const bool bEditorsOwn = EditorTabManager.IsValid() && Tab->GetTabManagerPtr() == EditorTabManager;
+				const bool bInPanelWindow = PanelWindow.IsValid() && Window == PanelWindow;
+				// Owner first, then window, then the id's place in the list.
+				const int32 Score = (bEditorsOwn ? 2000 : 0) + (bInPanelWindow ? 1000 : 0) + (100 - Rank);
+				UE_LOG(LogWidgetAnimScriptDock, Log, TEXT("Dock as Tab: candidate '%s' (%s)%s%s"), *Tab->GetTabLabel().ToString(),
+					*Tab->GetLayoutIdentifier().ToString(), bEditorsOwn ? TEXT(", this editor's") : TEXT(""), bInPanelWindow ? TEXT(", in the panel's window") : TEXT(""));
+				if ((bEditorsOwn || bInPanelWindow) && Score > BestScore)
+				{
+					Best = Tab;
+					BestScore = Score;
+				}
+			}
+		}
+		return Best;
+	}
