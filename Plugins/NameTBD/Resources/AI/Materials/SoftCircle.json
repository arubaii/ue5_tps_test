{
 "kind": "function",
 "name": "SoftCircle",
 "about": "A soft-edged disc mask: 1 inside Radius, fading to 0 over Softness (a fraction of the radius). UV centered at 0.5.",
 "signature": {
  "inputs": "UV (float2), Radius (0.5), Softness (0..1)",
  "outputs": "Result (float)"
 },
 "hlsl": {
  "inputs": [
   {
    "name": "UV",
    "type": "Vector2",
    "preview": [
     0.5,
     0.5,
     0,
     0
    ]
   },
   {
    "name": "Radius",
    "type": "Scalar",
    "preview": [
     0.5,
     0,
     0,
     0
    ]
   },
   {
    "name": "Softness",
    "type": "Scalar",
    "preview": [
     0.5,
     0,
     0,
     0
    ]
   }
  ],
  "outputs": {
   "Result": {
    "type": "float1",
    "code": [
     "float d = distance(UV, float2(0.5, 0.5));",
     "float r = max(Radius, 0.0001);",
     "return 1.0 - smoothstep(r * (1.0 - saturate(Softness)) - 0.0001, r, d);"
    ]
   }
  }
 }
}
