{
 "kind": "master",
 "name": "SoftDot",
 "about": "A soft round dot - what particles draw with by default; also a small glow.",
 "params": {
  "Color": "color (alpha = strength)",
  "Softness": "0..1, how far the edge fades"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Softness": {
    "value": 0.85,
    "group": "Look"
   },
   "Color": {
    "value": "#FFFFFF",
    "group": "Color"
   }
  },
  "code": [
   "float d = distance(uv, float2(0.5, 0.5));",
   "float m = 1.0 - smoothstep(0.5 * (1.0 - saturate(Softness)) - 0.0001, 0.5, d);",
   "return float4(Color.rgb, m * Color.a);"
  ]
 }
}
