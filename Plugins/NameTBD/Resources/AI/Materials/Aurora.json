{
 "kind": "master",
 "name": "Aurora",
 "about": "Soft aurora light rising from the bottom edge: three colors drifting in slow waves, fading upward. Animates by itself (Speed). For a card's bottom glow paint a shape (or the card) with an instance.",
 "params": {
  "ColorA": "color (teal)",
  "ColorB": "color (green)",
  "ColorC": "color (violet)",
  "Speed": "wave speed, 0 = still",
  "Height": "0..1 how far up it reaches",
  "Falloff": "how quickly it fades upward",
  "Intensity": "opacity strength",
  "Glow": "color brightness"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Speed": {
    "value": 0.15,
    "group": "Motion"
   },
   "Height": {
    "value": 0.8,
    "group": "Shape"
   },
   "Falloff": {
    "value": 1.6,
    "group": "Shape"
   },
   "Intensity": {
    "value": 1.0,
    "group": "Look"
   },
   "ColorA": {
    "value": "@glow1",
    "group": "Color"
   },
   "ColorB": {
    "value": "@glow2",
    "group": "Color"
   },
   "ColorC": {
    "value": "@glow3",
    "group": "Color"
   },
   "Glow": {
    "value": 1.2,
    "group": "Look"
   }
  },
  "code": [
   "float tt = time * Speed;",
   "float w1 = 0.5 + 0.5 * sin(6.2831853 * (uv.x * 1.3 + tt * 0.6));",
   "float w2 = 0.5 + 0.5 * sin(6.2831853 * (uv.x * 2.1 - tt * 0.9 + 0.3));",
   "float h = max((w1 * 0.35 + 0.65) * Height, 0.0001);",
   "float fade = pow(smoothstep(1.0 - h, 1.0, uv.y), max(Falloff, 0.0001));",
   "float alpha = saturate(fade * (w2 * 0.45 + 0.55) * Intensity);",
   "float t = saturate(w2 * 0.7 + uv.x * 0.3);",
   "float3 c = t < 0.5 ? lerp(ColorA.rgb, ColorB.rgb, t * 2.0) : lerp(ColorB.rgb, ColorC.rgb, t * 2.0 - 1.0);",
   "return float4(c * Glow, alpha);"
  ]
 }
}
