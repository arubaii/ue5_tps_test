{
 "kind": "master",
 "name": "Bubble",
 "about": "A soap-bubble disc: a bright soft ring around a faint fill - for bubble particles.",
 "params": {
  "Color": "color",
  "RingOpacity": "0..1",
  "FillOpacity": "0..1"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "RingOpacity": {
    "value": 0.9,
    "group": "Look"
   },
   "FillOpacity": {
    "value": 0.15,
    "group": "Look"
   },
   "Color": {
    "value": "#FFFFFF",
    "group": "Color"
   }
  },
  "code": [
   "float d = distance(uv, float2(0.5, 0.5));",
   "float outer = 1.0 - smoothstep(0.44, 0.5, d);",
   "float inner = 1.0 - smoothstep(0.28, 0.4, d);",
   "float ring = saturate(outer - inner);",
   "float alpha = max(ring * RingOpacity, outer * FillOpacity) * Color.a;",
   "return float4(Color.rgb, saturate(alpha));"
  ]
 }
}
