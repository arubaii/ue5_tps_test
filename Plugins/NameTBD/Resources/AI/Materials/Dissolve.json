{
 "kind": "master",
 "name": "Dissolve",
 "about": "Appears / disappears through a noisy edge that glows. Animate Progress 0 -> 1 (a Material Scalar track) to reveal.",
 "params": {
  "Color": "fill",
  "EdgeColor": "the glowing edge",
  "Progress": "0 hidden .. 1 shown",
  "EdgeWidth": "edge width"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Progress": {
    "value": 0.5,
    "group": "Motion"
   },
   "EdgeWidth": {
    "value": 0.08,
    "group": "Shape"
   },
   "Color": {
    "value": "@surface",
    "group": "Color"
   },
   "EdgeColor": {
    "value": "@accent",
    "group": "Color"
   }
  },
  "code": [
   "float2 p = uv * 6.0;",
   "// 4 octaves of value noise at p, 0..1",
   "float n = 0.0;",
   "float amp = 0.5;",
   "float2 q = p;",
   "for (int k = 0; k < 4; k++)",
   "{",
   "    float2 i = floor(q);",
   "    float2 f = frac(q);",
   "    float2 s = f * f * (3.0 - 2.0 * f);",
   "    float a = frac(sin(dot(i, float2(127.1, 311.7))) * 43758.5453);",
   "    float b = frac(sin(dot(i + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);",
   "    float c = frac(sin(dot(i + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);",
   "    float d = frac(sin(dot(i + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);",
   "    n += amp * lerp(lerp(a, b, s.x), lerp(c, d, s.x), s.y);",
   "    q = q * 2.03 + float2(17.0, 9.0);",
   "    amp *= 0.5;",
   "}",
   "n /= 0.9375;",
   "float e = max(EdgeWidth, 0.0001);",
   "float prog = saturate(Progress) * (1.0 + 2.0 * e);",
   "float shown = 1.0 - smoothstep(prog - e, prog, n);",
   "float inside = 1.0 - smoothstep(prog - 2.0 * e, prog - e, n);",
   "return float4(lerp(EdgeColor.rgb, Color.rgb, inside), shown * Color.a);"
  ]
 }
}
