{
 "kind": "master",
 "name": "Shimmer",
 "about": "A light band sweeping across - for loading placeholders, premium buttons, 'new' badges.",
 "params": {
  "BaseColor": "color under the band (alpha 0 = clear)",
  "HighlightColor": "the band",
  "Width": "band width",
  "Slant": "tilt",
  "Speed": "sweeps per second",
  "Intensity": "strength"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Slant": {
    "value": 0.35,
    "group": "Shape"
   },
   "Speed": {
    "value": 0.5,
    "group": "Motion"
   },
   "Width": {
    "value": 0.08,
    "group": "Shape"
   },
   "BaseColor": {
    "value": "#FFFFFF00",
    "group": "Color"
   },
   "HighlightColor": {
    "value": "#FFFFFFB0",
    "group": "Color"
   },
   "Intensity": {
    "value": 1.0,
    "group": "Look"
   }
  },
  "code": [
   "float x = frac(uv.x + uv.y * Slant - time * Speed);",
   "float band = 1.0 - smoothstep(0.0, max(Width, 0.0001), abs(x - 0.5));",
   "float3 c = lerp(BaseColor.rgb, HighlightColor.rgb, band);",
   "float alpha = lerp(BaseColor.a, HighlightColor.a * Intensity, band);",
   "return float4(c, saturate(alpha));"
  ]
 }
}
