{
 "kind": "master",
 "name": "NoiseFog",
 "about": "Drifting soft fog / smoke - backgrounds with depth, mystery panels.",
 "params": {
  "Color": "color",
  "Scale": "fog detail",
  "Speed": "drift (x, y per second)",
  "Contrast": "patchiness",
  "Density": "opacity"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Scale": {
    "value": 3.0,
    "group": "Shape"
   },
   "Speed": {
    "value": [
     0.03,
     0.01
    ],
    "group": "Motion"
   },
   "Contrast": {
    "value": 1.5,
    "group": "Shape"
   },
   "Density": {
    "value": 0.6,
    "group": "Look"
   },
   "Color": {
    "value": "@glow3",
    "group": "Color"
   }
  },
  "code": [
   "float2 p = uv * Scale + time * Speed;",
   "// 4 octaves of value noise at p, 0..1",
   "float n = 0.0;",
   "float amp = 0.5;",
   "float2 q = p;",
   "for (int k = 0; k < 4; k++)",
   "{",
   "    float2 i = floor(q);",
   "    float2 f = frac(q);",
   "    float2 s = f * f * (3.0 - 2.0 * f);",
   "    float a = frac(sin(dot(i, float2(127.1, 311.7))) * 43758.5453);",
   "    float b = frac(sin(dot(i + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);",
   "    float c = frac(sin(dot(i + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);",
   "    float d = frac(sin(dot(i + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);",
   "    n += amp * lerp(lerp(a, b, s.x), lerp(c, d, s.x), s.y);",
   "    q = q * 2.03 + float2(17.0, 9.0);",
   "    amp *= 0.5;",
   "}",
   "n /= 0.9375;",
   "float alpha = saturate(pow(n, max(Contrast, 0.0001)) * Density * Color.a);",
   "return float4(Color.rgb, alpha);"
  ]
 }
}
