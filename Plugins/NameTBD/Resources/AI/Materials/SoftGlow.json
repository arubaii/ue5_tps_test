{
 "kind": "master",
 "name": "SoftGlow",
 "about": "A round soft glow that can breathe (PulseAmount, PulseSpeed). Behind icons, buttons, titles.",
 "params": {
  "Color": "color",
  "Radius": "0..0.5",
  "Falloff": "edge softness (higher = tighter)",
  "Intensity": "strength",
  "PulseSpeed": "cycles per second",
  "PulseAmount": "0..1"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Radius": {
    "value": 0.5,
    "group": "Shape"
   },
   "Falloff": {
    "value": 2.0,
    "group": "Shape"
   },
   "PulseSpeed": {
    "value": 0.5,
    "group": "Motion"
   },
   "PulseAmount": {
    "value": 0.1,
    "group": "Motion"
   },
   "Intensity": {
    "value": 1.0,
    "group": "Look"
   },
   "Color": {
    "value": "@accent",
    "group": "Color"
   }
  },
  "code": [
   "float d = distance(uv, float2(0.5, 0.5)) / max(Radius, 0.0001);",
   "float g = pow(saturate(1.0 - d), max(Falloff, 0.0001));",
   "float pulse = 1.0 + sin(6.2831853 * time * PulseSpeed) * PulseAmount;",
   "return float4(Color.rgb, saturate(g * Intensity * pulse * Color.a));"
  ]
 }
}
