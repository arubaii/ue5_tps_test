{
 "kind": "master",
 "name": "Gradient",
 "about": "A three-color linear gradient at any Angle (0 = left to right, 90 = top to bottom) that can drift slowly (Drift).",
 "params": {
  "ColorA": "start",
  "ColorB": "middle",
  "ColorC": "end",
  "Angle": "degrees",
  "Drift": "0..0.3 how far it sways",
  "DriftSpeed": "cycles per second",
  "Opacity": "0..1"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Angle": {
    "value": 90,
    "group": "Shape"
   },
   "DriftSpeed": {
    "value": 0.1,
    "group": "Motion"
   },
   "Drift": {
    "value": 0.0,
    "group": "Motion"
   },
   "ColorA": {
    "value": "@accent",
    "group": "Color"
   },
   "ColorB": {
    "value": "@glow3",
    "group": "Color"
   },
   "ColorC": {
    "value": "@glow1",
    "group": "Color"
   },
   "Opacity": {
    "value": 1.0,
    "group": "Look"
   }
  },
  "code": [
   "float r = radians(Angle);",
   "float2 dir = float2(cos(r), sin(r));",
   "float t = saturate(dot(uv - 0.5, dir) + 0.5 + sin(6.2831853 * time * DriftSpeed) * Drift);",
   "float3 c = t < 0.5 ? lerp(ColorA.rgb, ColorB.rgb, t * 2.0) : lerp(ColorB.rgb, ColorC.rgb, t * 2.0 - 1.0);",
   "return float4(c, saturate(Opacity));"
  ]
 }
}
