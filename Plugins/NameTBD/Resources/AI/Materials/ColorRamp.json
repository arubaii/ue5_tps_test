{
 "kind": "function",
 "name": "ColorRamp",
 "about": "Three colors blended along T (0..1): A at 0, B at 0.5, C at 1.",
 "signature": {
  "inputs": "T (float), ColorA, ColorB, ColorC (float3)",
  "outputs": "Color (float3)"
 },
 "hlsl": {
  "inputs": [
   {
    "name": "T",
    "type": "Scalar",
    "preview": [
     0.5,
     0,
     0,
     0
    ]
   },
   {
    "name": "ColorA",
    "type": "Vector3",
    "preview": [
     0,
     0,
     1,
     0
    ]
   },
   {
    "name": "ColorB",
    "type": "Vector3",
    "preview": [
     0,
     1,
     0,
     0
    ]
   },
   {
    "name": "ColorC",
    "type": "Vector3",
    "preview": [
     1,
     0,
     0,
     0
    ]
   }
  ],
  "outputs": {
   "Color": {
    "type": "float3",
    "code": [
     "float t = saturate(T);",
     "return t < 0.5 ? lerp(ColorA, ColorB, t * 2.0) : lerp(ColorB, ColorC, t * 2.0 - 1.0);"
    ]
   }
  }
 }
}
