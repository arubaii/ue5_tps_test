{
 "kind": "master",
 "name": "Vignette",
 "about": "Darkens (or tints) toward the edges - focus on the middle of a screen or card.",
 "params": {
  "Color": "edge color",
  "Inner": "where it starts (0..0.7)",
  "Outer": "where it is full",
  "Strength": "0..1"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Inner": {
    "value": 0.35,
    "group": "Shape"
   },
   "Outer": {
    "value": 0.75,
    "group": "Shape"
   },
   "Strength": {
    "value": 0.8,
    "group": "Look"
   },
   "Color": {
    "value": "#000000",
    "group": "Color"
   }
  },
  "code": [
   "float d = distance(uv, float2(0.5, 0.5));",
   "float v = smoothstep(Inner, max(Outer, Inner + 0.0001), d);",
   "return float4(Color.rgb, saturate(v * Strength * Color.a));"
  ]
 }
}
