{
 "kind": "master",
 "name": "RingPulse",
 "about": "Rings expanding outward and fading, over and over - 'ready', notifications, map pings.",
 "params": {
  "Color": "color",
  "Speed": "rings per second",
  "Thickness": "ring width",
  "Intensity": "strength"
 },
 "hlsl": {
  "blend": "Translucent",
  "params": {
   "Speed": {
    "value": 0.6,
    "group": "Motion"
   },
   "Thickness": {
    "value": 0.04,
    "group": "Shape"
   },
   "Intensity": {
    "value": 1.0,
    "group": "Look"
   },
   "Color": {
    "value": "@accent",
    "group": "Color"
   }
  },
  "code": [
   "float d = distance(uv, float2(0.5, 0.5));",
   "float ph = frac(time * Speed);",
   "float ring = 1.0 - smoothstep(0.0, max(Thickness, 0.0001), abs(d - ph * 0.5));",
   "float alpha = saturate(ring * (1.0 - ph) * Intensity * Color.a);",
   "return float4(Color.rgb, alpha);"
  ]
 }
}
