{
 "kind": "function",
 "name": "RoundedRectSDF",
 "about": "A rounded rectangle mask (signed distance): HalfSize (fractions of the box, 0.5 = edge to edge), corner Radius, edge Softness.",
 "signature": {
  "inputs": "UV (float2), HalfSize (float2, default 0.45), Radius (0.1), Softness (0.01)",
  "outputs": "Mask (float), Distance (float)"
 },
 "hlsl": {
  "inputs": [
   {
    "name": "UV",
    "type": "Vector2",
    "preview": [
     0.5,
     0.5,
     0,
     0
    ]
   },
   {
    "name": "HalfSize",
    "type": "Vector2",
    "preview": [
     0.45,
     0.45,
     0,
     0
    ]
   },
   {
    "name": "Radius",
    "type": "Scalar",
    "preview": [
     0.1,
     0,
     0,
     0
    ]
   },
   {
    "name": "Softness",
    "type": "Scalar",
    "preview": [
     0.01,
     0,
     0,
     0
    ]
   }
  ],
  "outputs": {
   "Mask": {
    "type": "float1",
    "code": [
     "float2 q = abs(UV - 0.5) - (HalfSize - Radius);",
     "float dist = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - Radius;",
     "float s = max(Softness, 0.0001);",
     "return 1.0 - smoothstep(-s, s, dist);"
    ]
   },
   "Distance": {
    "type": "float1",
    "code": [
     "float2 q = abs(UV - 0.5) - (HalfSize - Radius);",
     "return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - Radius;"
    ]
   }
  }
 }
}
