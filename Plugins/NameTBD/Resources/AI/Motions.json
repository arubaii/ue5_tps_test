{
 "fade_in": {
  "about": "Fades in.",
  "params": {
   "duration": 0.35,
   "delay": 0
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   }
  ]
 },
 "pop_in": {
  "about": "Fades in while growing from a little smaller, on a snappy spring - the default entrance for cards and dialogs.",
  "params": {
   "duration": 0.3,
   "delay": 0,
   "scale": 0.9
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Scale",
    "fields": {
     "Timing": "Spring",
     "StartScale": [
      "{scale}",
      "{scale}"
     ],
     "EndScale": [
      1,
      1
     ],
     "Delay": "{delay}",
     "Spring": "@spring.Snappy"
    }
   }
  ]
 },
 "bounce_in": {
  "about": "Fades in and springs up from small with a visible bounce - playful.",
  "params": {
   "duration": 0.25,
   "delay": 0,
   "scale": 0.6
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Scale",
    "fields": {
     "Timing": "Spring",
     "StartScale": [
      "{scale}",
      "{scale}"
     ],
     "EndScale": [
      1,
      1
     ],
     "Delay": "{delay}",
     "Spring": "@spring.Bouncy"
    }
   }
  ]
 },
 "slide_up_in": {
  "about": "Fades in while rising into place.",
  "params": {
   "duration": 0.4,
   "delay": 0,
   "distance": 40
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Slide",
    "fields": {
     "SlideFromDirection": "Down",
     "SlideDistance": "{distance}",
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   }
  ]
 },
 "slide_in_left": {
  "about": "Fades in while sliding in from the left.",
  "params": {
   "duration": 0.4,
   "delay": 0,
   "distance": 60
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Slide",
    "fields": {
     "SlideFromDirection": "Left",
     "SlideDistance": "{distance}",
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   }
  ]
 },
 "slide_in_right": {
  "about": "Fades in while sliding in from the right.",
  "params": {
   "duration": 0.4,
   "delay": 0,
   "distance": 60
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Slide",
    "fields": {
     "SlideFromDirection": "Right",
     "SlideDistance": "{distance}",
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   }
  ]
 },
 "drop_in": {
  "about": "Drops in from above and bounces as it lands.",
  "params": {
   "duration": 0.3,
   "delay": 0,
   "distance": 60
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": 0,
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Delay": "{delay}",
     "Easing": "EaseOut"
    }
   },
   {
    "type": "Slide",
    "fields": {
     "Timing": "Spring",
     "SlideFromDirection": "Up",
     "SlideDistance": "{distance}",
     "Delay": "{delay}",
     "Spring": "@spring.Bouncy"
    }
   }
  ]
 },
 "pulse_loop": {
  "about": "A gentle heartbeat pulse in scale. Use with when=loop.",
  "params": {
   "duration": 1.2,
   "amount": 0.05
  },
  "tracks": [
   {
    "type": "Pulse",
    "fields": {
     "PulseScaleAmount": "{amount}",
     "Duration": "{duration}"
    }
   }
  ]
 },
 "breathe_loop": {
  "about": "Opacity breathes between min and full - for glows. Use with when=loop (ping-pong).",
  "params": {
   "duration": 2.4,
   "min": 0.6
  },
  "tracks": [
   {
    "type": "Fade",
    "fields": {
     "StartOpacity": "{min}",
     "EndOpacity": 1,
     "Duration": "{duration}",
     "Easing": "EaseInOut"
    }
   }
  ]
 },
 "float_loop": {
  "about": "Bobs up and down a few pixels. Use with when=loop (ping-pong).",
  "params": {
   "duration": 1.8,
   "distance": 6
  },
  "tracks": [
   {
    "type": "Slide",
    "fields": {
     "SlideFromDirection": "Down",
     "SlideDistance": "{distance}",
     "Duration": "{duration}",
     "Easing": "EaseInOut"
    }
   }
  ]
 },
 "spin_loop": {
  "about": "Turns round and round. Use with when=loop and ping_pong=false.",
  "params": {
   "duration": 2.0
  },
  "tracks": [
   {
    "type": "Rotate",
    "fields": {
     "StartAngle": 0,
     "EndAngle": 360,
     "Duration": "{duration}",
     "Easing": "Linear"
    }
   }
  ]
 },
 "wiggle": {
  "about": "A quick attention wiggle that settles - for 'look here'. Use with when=by_id or on_visible.",
  "params": {
   "angle": -8
  },
  "tracks": [
   {
    "type": "Rotate",
    "fields": {
     "Timing": "Spring",
     "StartAngle": "{angle}",
     "EndAngle": 0,
     "Spring": "@spring.Wobbly"
    }
   }
  ]
 },
 "shake": {
  "about": "Jitters and lands where it started - an error or a hit. Use with when=by_id.",
  "params": {
   "duration": 0.4
  },
  "tracks": [
   {
    "type": "Shake",
    "fields": {
     "Duration": "{duration}"
    }
   }
  ]
 }
}
