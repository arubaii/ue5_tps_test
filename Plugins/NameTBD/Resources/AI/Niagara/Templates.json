{
 "RisingBubbles": {
  "about": "Faint circles that bubble up from the bottom and fade as they rise - calm backgrounds, greeting cards.",
  "base_systems": [],
  "base_emitters": [
   "/Niagara/DefaultAssets/Templates/Emitters/Fountain",
   "Fountain"
  ],
  "material": "Bubble",
  "constants": {
   "SpawnRate.SpawnRate": 10,
   "GravityForce.Gravity": [
    0,
    0,
    30
   ],
   "AddVelocityInCone.VelocityStrength": 70,
   "AddVelocityInCone.ConeAngle": 20,
   "InitializeParticle.LifetimeMin": 3.2,
   "InitializeParticle.LifetimeMax": 4.8,
   "InitializeParticle.UniformSpriteSizeMin": 6,
   "InitializeParticle.UniformSpriteSizeMax": 14,
   "InitializeParticle.Color": [
    1,
    1,
    1,
    0.25
   ],
   "Drag.Drag": 0.6
  },
  "params": {
   "rate": {
    "default": 10,
    "about": "particles per second",
    "constants": {
     "SpawnRate.SpawnRate": "{value}"
    }
   },
   "lifetime": {
    "default": 4,
    "about": "seconds each lives",
    "constants": {
     "InitializeParticle.LifetimeMin": "{value*0.8}",
     "InitializeParticle.LifetimeMax": "{value*1.2}",
     "InitializeParticle.Lifetime": "{value}"
    }
   },
   "size": {
    "default": 10,
    "about": "sprite size in px (before Particle Scale)",
    "constants": {
     "InitializeParticle.UniformSpriteSizeMin": "{value*0.6}",
     "InitializeParticle.UniformSpriteSizeMax": "{value*1.4}",
     "InitializeParticle.UniformSpriteSize": "{value}"
    }
   },
   "color": {
    "default": "#FFFFFF",
    "about": "tint (alpha too) - on the Niagara widget's Color And Opacity",
    "widget": {
     "ColorAndOpacity": "{value}"
    }
   },
   "opacity": {
    "default": 0.3,
    "about": "0..1 - on the widget's Color And Opacity alpha",
    "widget": {
     "ColorAndOpacity": [
      1,
      1,
      1,
      "{value}"
     ]
    }
   },
   "scale": {
    "default": 1,
    "about": "everything bigger or smaller - the widget's Particle Scale",
    "widget": {
     "ParticleScale": "{value}"
    }
   },
   "rise_speed": {
    "default": 70,
    "about": "px per second upward",
    "constants": {
     "AddVelocityInCone.VelocityStrength": "{value}",
     "GravityForce.Gravity": [
      0,
      0,
      "{value*0.4}"
     ]
    }
   },
   "spread": {
    "default": 20,
    "about": "degrees of sideways drift",
    "constants": {
     "AddVelocityInCone.ConeAngle": "{value}"
    }
   }
  },
  "widget": {
   "Origin": [
    0.5,
    1.0
   ],
   "Visibility": "HitTestInvisible",
   "ColorAndOpacity": [
    1,
    1,
    1,
    0.25
   ]
  },
  "intended_stack": "Emitter Update: Spawn Rate (User.Rate). Particle Spawn: Initialize Particle (lifetime 3-5 s, sprite size 6-14, color white a=0.25), Shape Location (box along the bottom edge, 600 wide), Add Velocity (0, 0, User.RiseSpeed) + random X +-15. Particle Update: Curl Noise Force (strength 20, frequency 0.2) for drift, Scale Color by Normalized Age (alpha 0 -> 1 -> 0), Solve Forces and Velocity. Sprite renderer: M_UI_Bubble. CPU, local space."
 },
