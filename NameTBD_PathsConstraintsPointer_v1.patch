diff --git a/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetPathConnectTool.cpp b/Plugins/NameTBD/Source/NameTBDEditor/Private/WidgetPathConnectTool.cpp
new file mode 100644
index 0000000..d07077c
