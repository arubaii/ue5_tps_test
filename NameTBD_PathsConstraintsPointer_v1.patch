+
+	/** How much it acts: 0 not at all, 1 fully, between - partway from where the widget would be. Animatable (Constraint track). */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Constraint", meta = (ClampMin = "0", ClampMax = "1"))
