+bool UWidgetCopyPositionConstraint::GetChannel(EWidgetConstraintChannel Channel, float& OutValue) const
+{
+	switch (Channel)
+	{
+	case EWidgetConstraintChannel::OffsetX: OutValue = static_cast<float>(Offset.X); return true;
