+float UWidgetAnimationComponent::GetStateMachineNumber(FName Input, UWidgetAnimStateMachineAsset* StateMachine) const
+{
+	float Value = 0.f;
+	for (const FWidgetAnimMachineInstance& Instance : MachineInstances)
