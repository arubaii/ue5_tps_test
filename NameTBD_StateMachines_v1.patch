+FText UWidgetAnimMachineTransitionNode::GetTooltipText() const
+{
+	return FText::Format(LOCTEXT("TransitionTooltip", "{0}\n{1}"), GetNodeTitle(ENodeTitleType::FullTitle), DescribeRule());
+}
