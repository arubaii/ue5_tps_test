@@ -0,0 +1,431 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "K2Node_SetStateMachineInput.h"
+
+#include "BlueprintActionDatabaseRegistrar.h"
+#include "BlueprintNodeSpawner.h"
+#include "EdGraphSchema_K2.h"
