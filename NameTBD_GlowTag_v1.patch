+			const int32 NumTaps = FMath::Clamp(FMath::RoundToInt32(2.f * PI * RingRadius / Spacing), 6, 16);
+			const float Falloff = 1.f - static_cast<float>(Ring - 1) / NumRings;
+			const float RingStrength = Peak * Falloff * Falloff;
