+	auto DrawGlow = [&](const FShapedGlyphSequencePtr& Glyphs, int32 Run, const FVector2f& Origin, const FVector2f& Size, bool bPosed,
+		const FSlateRenderTransform& Composed, float Opacity, FLinearColor GlowColor, float Radius, float Strength, const FBox2f* Clip)
+	{
+		const float Peak = FMath::Clamp(Strength * GlowColor.A * Opacity, 0.f, 0.999f);
+		if (!Glyphs.IsValid() || Peak <= KINDA_SMALL_NUMBER || Radius <= 0.f)
+		{
+			return;
+		}
+		GlowColor.A = 1.f;
+
+		if (Clip)
+		{
+			OutDrawElements.PushClip(FSlateClippingZone(AllottedGeometry.MakeChild(Clip->GetSize(), FSlateLayoutTransform(Clip->Min))));
+		}
+
+		// A ring every couple of units out to Radius (three at most), with a copy every couple of units around each.
+		constexpr float Spacing = 2.f;
+		const int32 NumRings = FMath::Clamp(FMath::CeilToInt32(Radius / Spacing), 1, 3);
+		for (int32 Ring = 1; Ring <= NumRings; ++Ring)
