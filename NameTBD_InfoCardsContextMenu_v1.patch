@@ -0,0 +1,68 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Layout/Margin.h"
+#include "Widgets/SPanel.h"
+#include "Layout/Children.h"
+
+#include "InfoCardTypes.h"
+
+/** Where the designer shows a previewed card, read off the entry being previewed. */
+struct FInfoCardDesignerPlacement
+{
+	EInfoCardPosition PositionMode = EInfoCardPosition::ToIcon;
+	EDirection2D IconPosition = EDirection2D::Up;
+	EInfoCardCursorPosition CursorPosition = EInfoCardCursorPosition::UpRight;
+	FMargin FillIconPadding = FMargin(0.f);
+	FVector2D Offset = FVector2D::ZeroVector;
+	float IconAnchorPadding = 0.f;
+
+	static FInfoCardDesignerPlacement FromSpec(const FInfoCardSpec& Spec);
+};
+
+/**
+ * Design time only: what an Info Card Anchor hands the UMG designer instead of its bare border, so the card it is previewing
+ * can be drawn where the game would put it - beside, above or over the anchor - without taking part in layout.
+ *
+ * Two children. The first is the anchor's own SBorder, arranged over the whole allotted box, and the only one asked for a
+ * desired size, so wrapping a widget in an anchor never moves anything in the designer. The second, when there is one, is the
+ * previewed card at its desired size, arranged outside the box by FInfoCardDesignerPlacement (Slate draws children outside
+ * their parent's box unless something above clips).
+ *
+ * The designer has no cursor and no game viewport, so To Cursor treats the anchor's centre as the cursor, and To Viewport is
+ * shown to the anchor's right. Clamping, flipping and overlap avoidance are runtime-only.
+ */
+class NAMETBD_API SInfoCardDesignerPreview : public SPanel
+{
+public:
+
+	SLATE_BEGIN_ARGS(SInfoCardDesignerPreview) {}
+		SLATE_DEFAULT_SLOT(FArguments, Content)
+	SLATE_END_ARGS()
+
+	SInfoCardDesignerPreview();
+
+	void Construct(const FArguments& InArgs);
+
+	/** Shows Card (null: none) placed by Placement. */
+	void SetCard(const TSharedPtr<SWidget>& Card, const FInfoCardDesignerPlacement& Placement);
+
+	/** The card's top-left in the anchor's local space, for a card of CardSize beside an anchor of AnchorSize. */
+	static FVector2D ComputeCardPosition(const FInfoCardDesignerPlacement& Placement, const FVector2D& AnchorSize, const FVector2D& CardSize);
+
+	// SPanel
+	virtual void OnArrangeChildren(const FGeometry& AllottedGeometry, FArrangedChildren& ArrangedChildren) const override;
+	virtual FChildren* GetChildren() override { return &PanelChildren; }
+
+protected:
+
+	virtual FVector2D ComputeDesiredSize(float LayoutScaleMultiplier) const override;
+
+private:
+
+	TSlotlessChildren<SWidget> PanelChildren;
+	TSharedPtr<SWidget> CardWidget;
+	FInfoCardDesignerPlacement CardPlacement;
+};
diff --git a/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.cpp b/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.cpp
new file mode 100644
index 0000000..4ed8722
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.cpp
@@ -0,0 +1,267 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#include "TooltipCardAnchor.h"
+
+#include "Blueprint/UserWidget.h"
+#include "Components/PanelWidget.h"
+#include "GameFramework/PlayerController.h"
+
+#include "NameTBD/DeveloperSettings/InfoCardDeveloperSettings.h"
+
+const FName UTooltipCardAnchor::BuiltInTooltipCardId(TEXT("Tooltip"));
+
+namespace TooltipCardAnchorPrivate
+{
+	TSubclassOf<UInfoCardWidget> DefaultCardClass()
+	{
+		const UInfoCardDeveloperSettings* Settings = UInfoCardDeveloperSettings::Get();
+		if (Settings && !Settings->DefaultTooltipCardClass.IsNull())
+		{
+			if (UClass* Loaded = Settings->DefaultTooltipCardClass.LoadSynchronous())
+			{
+				return Loaded;
+			}
+		}
+		return UInfoCardTextWidget::StaticClass();
+	}
+
+	template <typename PayloadType>
+	PayloadType* FindOrAddPayload(FInfoCardSpec& Spec, UObject* Outer)
+	{
+		for (const TObjectPtr<UNameTBD_Payload>& Payload : Spec.Payloads)
+		{
+			if (PayloadType* Found = Cast<PayloadType>(Payload.Get()))
+			{
+				return Found;
+			}
+		}
+
+		PayloadType* Added = NewObject<PayloadType>(Outer);
+		Spec.Payloads.Add(Added);
+		return Added;
+	}
+}
+
+FInfoCardSpec UTooltipCardAnchor::MakeBuiltInTooltipSpec()
+{
+	FInfoCardSpec Spec;
+	Spec.CardId = BuiltInTooltipCardId;
+	Spec.CardClass = TooltipCardAnchorPrivate::DefaultCardClass();
+	Spec.CardType = ECardType::Hover;
+	Spec.PositionMode = EInfoCardPosition::ToIcon;
+	Spec.IconPosition = EDirection2D::Up;
+	Spec.IconAnchorPadding = 6.f;
+
+	// Any click puts a tooltip away (and it comes back once the cursor leaves and returns), as an OS tooltip does.
+	Spec.RemoveCardOnPressing = ECardRemoveOnPressZone::Anywhere;
+
+	// A short fade in, mirrored as the fade out.
+	FInfoCardAdditiveAnimSettings Fade;
+	Fade.AnimType = EInfoCardAdditiveAnimType::Fade;
+	Fade.Duration = 0.12f;
+	Fade.Easing = EWidgetAnimEasing::EaseOut;
+	Fade.StartOpacity = 0.f;
+	Fade.EndOpacity = 1.f;
+	Fade.bMirrorInOut = true;
+	Spec.AdditiveAnimations.bUseBasicAnimations = true;
+	Spec.AdditiveAnimations.PlayIn.Add(Fade);
+
+	return Spec;
+}
+
+const UInfoCardDataAsset* UTooltipCardAnchor::ResolveTemplate() const
+{
+	if (TooltipTemplate)
+	{
+		return TooltipTemplate;
+	}
+
+	const UInfoCardDeveloperSettings* Settings = UInfoCardDeveloperSettings::Get();
+	return (Settings && !Settings->DefaultTooltipTemplate.IsNull()) ? Settings->DefaultTooltipTemplate.LoadSynchronous() : nullptr;
+}
+
+TArray<FString> UTooltipCardAnchor::GetTemplateCardIdOptions() const
+{
+	TArray<FString> Options;
+	Options.Add(TEXT("None"));
+
+	if (const UInfoCardDataAsset* Template = ResolveTemplate())
+	{
+		for (const FInfoCardSpec& Spec : Template->InfoCards)
+		{
+			if (!Spec.CardId.IsNone())
+			{
+				Options.AddUnique(Spec.CardId.ToString());
+			}
+		}
+	}
+	return Options;
+}
+
+FName UTooltipCardAnchor::GetTooltipCardId() const
+{
+	return InfoCards.IsValidIndex(0) ? InfoCards[0].CardId : BuiltInTooltipCardId;
+}
+
+bool UTooltipCardAnchor::BuildGeneratedInfoCards(TArray<FInfoCardSpec>& OutSpecs)
+{
+	const UInfoCardDataAsset* Template = ResolveTemplate();
+
+	const FInfoCardSpec* TemplateSpec = nullptr;
+	if (Template && Template->InfoCards.Num() > 0)
+	{
+		TemplateSpec = TemplateCardId.IsNone()
+			? &Template->InfoCards[0]
+			: Template->InfoCards.FindByPredicate([this](const FInfoCardSpec& Candidate) { return Candidate.CardId == TemplateCardId; });
+
+		// A Template Card ID the template no longer has falls back to its first entry rather than to no tooltip.
+		if (!TemplateSpec)
+		{
+			TemplateSpec = &Template->InfoCards[0];
+		}
+	}
+
+	FInfoCardSpec Spec = TemplateSpec ? MakeSpecFromDataAsset(*Template, *TemplateSpec, this) : MakeBuiltInTooltipSpec();
+
+	if (!Spec.CardClass)
+	{
+		Spec.CardClass = TooltipCardAnchorPrivate::DefaultCardClass();
+	}
+	if (Spec.CardId.IsNone())
+	{
+		Spec.CardId = BuiltInTooltipCardId;
+	}
+
+	// The words: into the template's text payload when it has one (so its other fields stay), else a new one.
+	UInfoCardPayload_Text* TextPayload = TooltipCardAnchorPrivate::FindOrAddPayload<UInfoCardPayload_Text>(Spec, this);
+	TextPayload->Title = TooltipTitleText;
+	TextPayload->Body = TooltipBodyText;
+
+	if (bOverrideTooltipTextStyle)
+	{
+		TooltipCardAnchorPrivate::FindOrAddPayload<UInfoCardPayload_TextStyle>(Spec, this)->TextStyle = TooltipTextStyle;
+	}
+
+	if (bOverrideTooltipPosition)
+	{
+		Spec.PositionMode = EInfoCardPosition::ToIcon;
+		Spec.IconPosition = TooltipPosition;
+	}
+
+	if (bOverrideTooltipDelay)
+	{
+		Spec.HoverDelay.Source = EInfoCardValueSource::Custom;
+		Spec.HoverDelay.CustomValue = TooltipDelay;
+	}
+
+	// Nothing to say, nothing to show. Kept as an entry (switched off) so the Card ID still resolves for Blueprint.
+	if (TooltipBodyText.IsEmpty() && TooltipTitleText.IsEmpty())
+	{
+		Spec.bEnabled = false;
+	}
+
+	OutSpecs.Add(MoveTemp(Spec));
+	return true;
+}
+
+void UTooltipCardAnchor::SetTooltipCardText(FText NewText, FText NewTitle)
+{
+	TooltipBodyText = NewText;
+	TooltipTitleText = NewTitle;
+	RebuildGeneratedInfoCards();
+}
+
+// =================================================================================================
+// UInfoCardLibrary
+// =================================================================================================
+
+UInfoCardAnchor* UInfoCardLibrary::FindInfoCardAnchorAround(UWidget* Widget)
+{
+	UWidget* Current = Widget;
+	for (int32 Depth = 0; Current && Depth < 256; ++Depth)
+	{
+		if (UInfoCardAnchor* Anchor = Cast<UInfoCardAnchor>(Current))
+		{
+			return Anchor;
+		}
+
+		if (UPanelWidget* Parent = Current->GetParent())
+		{
+			Current = Parent;
+			continue;
+		}
+
+		// The root of a widget tree: carry on from the User Widget that tree belongs to, which sits in its own parent's tree.
+		UUserWidget* OwningUserWidget = Current->GetTypedOuter<UUserWidget>();
+		Current = (OwningUserWidget != Current) ? OwningUserWidget : nullptr;
+	}
+	return nullptr;
+}
+
+UTooltipCardAnchor* UInfoCardLibrary::FindTooltipAnchorAround(UWidget* Widget)
+{
+	UWidget* Current = Widget;
+	for (int32 Depth = 0; Current && Depth < 64; ++Depth)
+	{
+		UInfoCardAnchor* Anchor = FindInfoCardAnchorAround(Current);
+		if (!Anchor)
+		{
+			return nullptr;
+		}
+		if (UTooltipCardAnchor* Tooltip = Cast<UTooltipCardAnchor>(Anchor))
+		{
+			return Tooltip;
+		}
+
+		// Some other kind of anchor (a context menu around the same widget): keep looking above it.
+		Current = Anchor->GetParent() ? static_cast<UWidget*>(Anchor->GetParent()) : static_cast<UWidget*>(Anchor->GetTypedOuter<UUserWidget>());
+	}
+	return nullptr;
+}
+
+UTooltipCardAnchor* UInfoCardLibrary::SetWidgetTooltipCard(UWidget* Widget, FText Text, FText Title, TSubclassOf<UInfoCardWidget> CardClass)
+{
+	if (!Widget)
+	{
+		return nullptr;
+	}
+
+	if (UTooltipCardAnchor* Anchor = FindTooltipAnchorAround(Widget))
+	{
+		Anchor->SetTooltipCardText(Text, Title);
+		return Anchor;
+	}
+
+	if (Text.IsEmpty() && Title.IsEmpty())
+	{
+		Widget->SetToolTip(nullptr);
+		return nullptr;
+	}
+
+	const TSubclassOf<UInfoCardWidget> ClassToMake = CardClass ? CardClass : TooltipCardAnchorPrivate::DefaultCardClass();
+	UInfoCardWidget* Card = nullptr;
+	if (APlayerController* OwningPlayer = Widget->GetOwningPlayer())
+	{
+		Card = CreateWidget<UInfoCardWidget>(OwningPlayer, ClassToMake);
+	}
+	else if (UWorld* World = Widget->GetWorld())
+	{
+		Card = CreateWidget<UInfoCardWidget>(World, ClassToMake);
+	}
+
+	if (!Card)
+	{
+		return nullptr;
+	}
+
+	// Slate places an engine tooltip; the info card system must leave it alone (no viewport, no click-away, no keep-open).
+	Card->MarkAsEmbedded();
+
+	UInfoCardPayload_Text* TextPayload = NewObject<UInfoCardPayload_Text>(Card);
+	TextPayload->Title = Title;
+	TextPayload->Body = Text;
+	Card->SetPayloads({ TextPayload });
+
+	Widget->SetToolTip(Card);
+	return nullptr;
+}
diff --git a/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.h b/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.h
new file mode 100644
index 0000000..ddc27ae
--- /dev/null
+++ b/Plugins/NameTBD/Source/NameTBD/Cards/TooltipCardAnchor.h
@@ -0,0 +1,130 @@
+// Copyright AR GameSystems 2026. All rights reserved.
+
+#pragma once
+
+#include "CoreMinimal.h"
+#include "Kismet/BlueprintFunctionLibrary.h"
+
+#include "InfoCardAnchor.h"
+#include "InfoCardTextWidget.h"
+
+#include "TooltipCardAnchor.generated.h"
+
+/**
+ * An Info Card Anchor for the everyday case: wrap it around a widget, type the Tooltip Text, done.
+ *
+ * Everything else comes from a template - Project Settings > Info Card > Tooltips > Default Tooltip Template, or this
+ * anchor's own Tooltip Template - and without either from the built-in tooltip: a Text Info Card (no Widget Blueprint
+ * needed) above the widget after the project's Highlight Delay, with a short fade, hidden again by any click. Change the
+ * template once and every tooltip in the project follows.
+ *
+ * The usual anchor fields (Source, Info Cards, Payload Defaults, the overrides, Custom Info Cards) are hidden: the card is
+ * built from the fields below. The anchor's events, Blueprint functions, pinning and suppression all still apply, with the
+ * card's Card ID being the template entry's (Tooltip for the built-in one).
+ */
+UCLASS(meta = (DisplayName = "Tooltip Card Anchor"))
+class NAMETBD_API UTooltipCardAnchor : public UInfoCardAnchor
+{
+	GENERATED_BODY()
+
+public:
+
+	/** The tooltip's words. Empty Tooltip Text and Tooltip Title: no tooltip at all. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", meta = (DisplayName = "Tooltip Text", MultiLine = true))
+	FText TooltipBodyText;
+
+	/** An optional bold first line. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", meta = (DisplayName = "Tooltip Title"))
+	FText TooltipTitleText;
+
+	/**
+	 * Where every setting but the text comes from: an Info Card Data Asset whose entry (Template Card ID, else its first) is
+	 * this tooltip's card class, trigger, delay, placement, dismissal, sounds and animations. Empty: Project Settings > Info
+	 * Card > Tooltips > Default Tooltip Template, else the built-in tooltip.
+	 */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", meta = (DisplayName = "Tooltip Template"))
+	TObjectPtr<UInfoCardDataAsset> TooltipTemplate;
+
+	/** Which entry of the template. None: its first. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (DisplayName = "Template Card ID", GetOptions = "GetTemplateCardIdOptions"))
+	FName TemplateCardId = NAME_None;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (InlineEditConditionToggle))
+	bool bOverrideTooltipPosition = false;
+
+	/** Where this tooltip sits around the widget, instead of the template's. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (DisplayName = "Position", EditCondition = "bOverrideTooltipPosition"))
+	EDirection2D TooltipPosition = EDirection2D::Up;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (InlineEditConditionToggle))
+	bool bOverrideTooltipDelay = false;
+
+	/** Seconds the cursor (or focus) rests on the widget before this tooltip shows, instead of the template's Highlight Delay. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (DisplayName = "Delay", EditCondition = "bOverrideTooltipDelay", ClampMin = "0", UIMax = "3", Units = "s"))
+	float TooltipDelay = 0.35f;
+
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (InlineEditConditionToggle))
+	bool bOverrideTooltipTextStyle = false;
+
+	/** This tooltip's look, when its card is a Text Info Card (the built-in one is). Other card classes ignore it. */
+	UPROPERTY(EditAnywhere, BlueprintReadOnly, Category = "Tooltip", AdvancedDisplay, meta = (DisplayName = "Text Style", EditCondition = "bOverrideTooltipTextStyle"))
+	FInfoCardTextStyle TooltipTextStyle;
+
+	/** Changes the tooltip's text; a tooltip showing updates at once. Empty title and text: no tooltip. */
+	UFUNCTION(BlueprintCallable, Category = "Tooltip", meta = (DisplayName = "Set Tooltip Card Text"))
+	void SetTooltipCardText(FText NewText, FText NewTitle);
+
+	UFUNCTION(BlueprintPure, Category = "Tooltip", meta = (DisplayName = "Get Tooltip Card Text"))
+	FText GetTooltipCardText() const { return TooltipBodyText; }
+
+	UFUNCTION(BlueprintPure, Category = "Tooltip", meta = (DisplayName = "Get Tooltip Card Title"))
+	FText GetTooltipCardTitle() const { return TooltipTitleText; }
+
+	/** Backs the Template Card ID dropdown. Must stay a UFUNCTION for GetOptions. */
+	UFUNCTION()
+	TArray<FString> GetTemplateCardIdOptions() const;
+
+	/** The Card ID this tooltip's card has: the template entry's, or Tooltip. */
+	FName GetTooltipCardId() const;
+
+	/** The built-in tooltip's Card ID. */
+	static const FName BuiltInTooltipCardId;
+
+	/** The built-in tooltip entry, before text: what a Tooltip Card Anchor uses with no template anywhere. */
+	static FInfoCardSpec MakeBuiltInTooltipSpec();
+
+protected:
+
+	virtual bool UsesGeneratedInfoCards() const override { return true; }
+	virtual bool BuildGeneratedInfoCards(TArray<FInfoCardSpec>& OutSpecs) override;
+
+	/** The template in force: this anchor's, else the project's (loaded on first use). */
+	const UInfoCardDataAsset* ResolveTemplate() const;
+};
+
+/** Blueprint helpers for giving widgets info cards and tooltips without setting up an anchor by hand. */
+UCLASS()
+class NAMETBD_API UInfoCardLibrary : public UBlueprintFunctionLibrary
+{
+	GENERATED_BODY()
+
+public:
+
+	/**
+	 * Gives Widget a tooltip from code: if Widget sits inside a Tooltip Card Anchor (at any depth), that anchor's text is set;
+	 * otherwise the widget's own engine tooltip becomes a Text Info Card (or Card Class) showing the text - the engine then
+	 * shows it on hover after its usual delay, following the cursor. Empty title and text remove the tooltip.
+	 *
+	 * @return The anchor whose text was set, or null when the engine tooltip was used.
+	 */
+	UFUNCTION(BlueprintCallable, Category = "Info Card|Tooltip", meta = (DefaultToSelf = "Widget", Keywords = "Hint Help Description"))
+	static UTooltipCardAnchor* SetWidgetTooltipCard(UWidget* Widget, FText Text, FText Title, TSubclassOf<UInfoCardWidget> CardClass = nullptr);
+
+	/** The nearest Info Card Anchor around Widget (Widget itself counts), or null. Crosses into the User Widgets that hold it. */
+	UFUNCTION(BlueprintPure, Category = "Info Card", meta = (DefaultToSelf = "Widget"))
+	static UInfoCardAnchor* FindInfoCardAnchorAround(UWidget* Widget);
+
+	/** The nearest Tooltip Card Anchor around Widget, or null. */
+	UFUNCTION(BlueprintPure, Category = "Info Card|Tooltip", meta = (DefaultToSelf = "Widget"))
+	static UTooltipCardAnchor* FindTooltipAnchorAround(UWidget* Widget);
+};
