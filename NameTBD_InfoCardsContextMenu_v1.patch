diff --git a/Plugins/NameTBD/Source/NameTBDEditor/Private/InfoCardAnchorPreviewToolbar.cpp b/Plugins/NameTBD/Source/NameTBDEditor/Private/InfoCardAnchorPreviewToolbar.cpp
