+	UPROPERTY(EditAnywhere, BlueprintReadWrite, Category = "Action", meta = (EditCondition = "EntryType == EContextMenuEntryType::Submenu", EditConditionHides))
+	TObjectPtr<UContextMenuAsset> Submenu = nullptr;
